---
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props { currentPath: string }
const { currentPath } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const homeUrl = getRelativeLocaleUrl(locale, '/');

const labels = {
  en: { home: 'Home', tutorial: 'Tutorial', plugins: 'Plugins', directory: 'Directory', dashboard: 'Dashboard', install: 'Install', troubleshooting: 'Troubleshooting', blog: 'Blog' },
  zh: { home: '首页', tutorial: '教程', plugins: '插件', directory: '插件目录', dashboard: '仪表盘', install: '安装', troubleshooting: '排错', blog: '博客' },
}[locale];
const items = [
  { key: 'home', path: '/' },
  { key: 'tutorial', path: '/tutorial/' },
  { key: 'plugins', path: '/plugins/' },
  { key: 'directory', path: '/plugins/directory/' },
  { key: 'dashboard', path: '/dashboard/' },
  { key: 'install', path: '/install/' },
  { key: 'troubleshooting', path: '/troubleshooting/' },
  { key: 'blog', path: '/blog/' },
];
---

<header class="top">
  <div class="wrap top-in">
    <a class="brand" href={homeUrl}>
      <img class="brand-logo" src="/logo.svg" alt="dshbase logo" width="30" height="30">
      <span>dsh</span><strong>base</strong>
    </a>
    <nav class="nav" aria-label="Main">
      {items.map((it) => (
        <a href={getRelativeLocaleUrl(locale, it.path)} set:aria-current={currentPath === it.path ? 'page' : undefined}>{labels[it.key]}</a>
      ))}
    </nav>
  </div>
</header>
