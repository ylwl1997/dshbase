---
interface Props {}
const locale = Astro.currentLocale ?? 'en';
const t = {
  en: { label: 'Search', placeholder: 'Search articles, plugins, troubleshooting…' },
  zh: { label: '搜索', placeholder: '搜索文章、插件、排错…' },
}[locale];
---

<button class="search-trigger" id="search-trigger" type="button" aria-label={t.label}>
  <span class="search-ico">🔍</span>
  <span class="search-trigger-label">{t.label}</span>
  <kbd class="search-kbd">⌘K</kbd>
</button>

<div class="cmdk" id="site-search" hidden>
  <div class="cmdk-inner">
    <div class="cmdk-input-wrap">
      <span class="cmdk-icon">🔍</span>
      <input id="site-search-input" type="search" placeholder={t.placeholder} autocomplete="off" aria-label={t.label} />
      <kbd class="cmdk-esc">Esc</kbd>
    </div>
    <div class="cmdk-results" id="site-search-results"></div>
    <div class="cmdk-foot" id="site-search-foot">↑↓ {locale === 'en' ? 'navigate' : '选择'} · Enter {locale === 'en' ? 'open' : '打开'} · Esc {locale === 'en' ? 'close' : '关闭'}</div>
  </div>
</div>

<style>
  .search-trigger {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: inherit; font-size: 13.5px; font-weight: 500; color: var(--ink-2);
    background: var(--bg-card, #fff); border: 1px solid var(--border);
    border-radius: 999px; padding: 7px 12px 7px 14px; cursor: pointer;
    flex-shrink: 0; line-height: 1;
  }
  .search-trigger:hover { color: var(--ink); border-color: var(--border-strong); }
  .search-ico { font-size: 14px; }
  .search-kbd {
    font-family: var(--mono, monospace); font-size: 11px; color: var(--ink-3);
    background: #f1f5f9; border: 1px solid #cbd5e1; border-bottom-width: 2px;
    border-radius: 6px; padding: 2px 6px;
  }
  .cmdk { position: fixed; inset: 0; z-index: 300; display: flex; align-items: flex-start; justify-content: center; background: rgba(15, 23, 42, 0.5); padding: 12vh 20px 20px; }
  .cmdk[hidden] { display: none; }
  .cmdk-inner { background: #fff; border-radius: 14px; width: 100%; max-width: 660px; box-shadow: 0 24px 60px rgba(0,0,0,.28); overflow: hidden; }
  .cmdk-input-wrap { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--border); }
  .cmdk-icon { font-size: 16px; }
  .cmdk-input-wrap input { flex: 1; border: none; outline: none; font-size: 16px; color: var(--ink); font-family: inherit; background: none; }
  .cmdk-esc { font-family: var(--mono, monospace); font-size: 11px; color: var(--ink-3); background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 6px; padding: 2px 7px; }
  .cmdk-results { max-height: 52vh; overflow: auto; padding: 8px; }
  .cmdk-group { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-3); padding: 12px 12px 4px; }
  .cmdk-item { display: flex; align-items: center; gap: 12px; padding: 9px 12px; border-radius: 10px; text-decoration: none; color: inherit; }
  .cmdk-item:hover, .cmdk-item.is-sel { background: #f1f5f9; }
  .cmdk-item img { width: 26px; height: 26px; border-radius: 50%; background: #eef1f6; flex-shrink: 0; }
  .cmdk-item .ci-ico { width: 26px; height: 26px; border-radius: 7px; background: var(--primary-soft, #eef2ff); color: var(--primary); display: inline-flex; align-items: center; justify-content: center; font-size: 13px; flex-shrink: 0; }
  .cmdk-item .ci-main { flex: 1; min-width: 0; }
  .cmdk-item .ci-name { font-size: 14px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cmdk-item .ci-meta { font-size: 12px; color: var(--ink-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cmdk-item .ci-badge { font-size: 10px; font-weight: 700; color: var(--primary); background: var(--primary-soft, #eef2ff); border-radius: 5px; padding: 1px 6px; flex-shrink: 0; }
  .cmdk-item .ci-right { font-size: 12px; color: var(--ink-3); white-space: nowrap; flex-shrink: 0; }
  .cmdk-item .ci-cmd { font-family: var(--mono, monospace); font-size: 11px; color: var(--primary); }
  .cmdk-empty { text-align: center; padding: 28px 16px; color: var(--ink-3); font-size: 14px; }
  .cmdk-foot { padding: 8px 16px; border-top: 1px solid var(--border); font-size: 11px; color: var(--ink-3); }
  @media (max-width: 640px) {
    .cmdk { padding: 6vh 12px 12px; }
    .search-trigger-label { display: none; }
    .search-trigger { padding: 8px 11px; margin-left: auto; }
  }
</style>

<script>
  (() => {
    const lang = (document.documentElement.lang || '').startsWith('zh') ? 'zh' : 'en';
    const I18N = {
      en: { page: 'Page', post: 'Article', plugin: 'Plugin', empty: 'No results', noIndex: 'Search index unavailable' },
      zh: { page: '页面', post: '文章', plugin: '插件', empty: '没有找到相关结果', noIndex: '搜索索引不可用' },
    }[lang];

    const modal = document.getElementById('site-search');
    const input = document.getElementById('site-search-input');
    const resultsEl = document.getElementById('site-search-results');
    const trigger = document.getElementById('search-trigger');
    if (!modal || !input || !resultsEl || !trigger) return;

    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const localize = (p) => {
      if (lang !== 'zh') return p;
      if (p === '/') return '/zh/';
      return '/zh' + p;
    };

    let indexPromise = null;
    const loadIndex = () => {
      if (!indexPromise) indexPromise = fetch('/search-index.json').then((r) => r.json()).catch(() => null);
      return indexPromise;
    };

    let items = [];
    let selIdx = 0;

    function groupItem(anchor) { items.push(anchor); }

    function addGroup(title) {
      const g = document.createElement('div');
      g.className = 'cmdk-group';
      g.textContent = title;
      resultsEl.appendChild(g);
    }

    function addPage(p) {
      const a = document.createElement('a');
      a.className = 'cmdk-item'; a.href = localize(p.path);
      a.innerHTML = `<span class="ci-ico">📄</span><div class="ci-main"><div class="ci-name">${esc(lang === 'zh' ? p.title_zh : p.title)}</div><div class="ci-meta">${esc(lang === 'zh' ? (p.desc_zh || p.desc) : p.desc)}</div></div><span class="ci-badge">${I18N.page}</span>`;
      wire(a); resultsEl.appendChild(a); groupItem(a);
    }

    function addPost(p) {
      const hasZh = !!p.title_zh;
      const href = (lang === 'zh' && hasZh) ? localize(p.path) : p.path;
      const title = lang === 'zh' ? (p.title_zh || p.title) : p.title;
      const desc = lang === 'zh' ? (p.desc_zh || p.desc) : p.desc;
      const a = document.createElement('a');
      a.className = 'cmdk-item'; a.href = href;
      a.innerHTML = `<span class="ci-ico">📝</span><div class="ci-main"><div class="ci-name">${esc(title)}</div><div class="ci-meta">${esc(desc)}</div></div><span class="ci-badge">${I18N.post}</span>`;
      wire(a); resultsEl.appendChild(a); groupItem(a);
    }

    function addPlugin(p) {
      const title = lang === 'zh' ? (p.desc_zh || p.desc) : p.desc;
      const test = p.test === 'verified' ? (lang === 'zh' ? '已验证' : 'verified') : (lang === 'zh' ? '未验证' : 'unverified');
      const avatar = p.owner ? `<img src="https://github.com/${esc(p.owner)}.png" alt="" loading="lazy" onerror="this.remove()">` : `<span class="ci-ico">🧩</span>`;
      const a = document.createElement('a');
      a.className = 'cmdk-item'; a.href = localize(`/plugins/${p.slug}/`);
      a.innerHTML = `${avatar}<div class="ci-main"><div class="ci-name">${esc(p.name)}</div><div class="ci-meta">★ ${p.stars} · ${test}${p.cat ? ' · ' + esc(p.cat) : ''}</div></div><div class="ci-right"><span class="ci-cmd">${esc(p.cmd)}</span></div>`;
      wire(a); resultsEl.appendChild(a); groupItem(a);
    }

    function wire(a) {
      a.addEventListener('mouseenter', () => { selIdx = items.indexOf(a); updateSel(); });
    }

    function updateSel() {
      items.forEach((it, i) => it.classList.toggle('is-sel', i === selIdx));
      const sel = items[selIdx];
      if (sel) sel.scrollIntoView({ block: 'nearest' });
    }

    function render(q) {
      q = (q || '').trim().toLowerCase();
      resultsEl.innerHTML = '';
      items = [];
      selIdx = 0;
      loadIndex().then((data) => {
        if (!data) { resultsEl.innerHTML = `<div class="cmdk-empty">${I18N.noIndex}</div>`; return; }
        const pages = q ? data.pages.filter((p) => p.q.includes(q)) : data.pages.slice(0, 8);
        const posts = q ? data.posts.filter((p) => p.q.includes(q)) : data.posts.slice(0, 6);
        const pluginsAll = q ? data.plugins.filter((p) => p.q.includes(q)) : [...data.plugins].sort((a, b) => b.stars - a.stars).slice(0, 10);
        const plugins = pluginsAll.slice(0, 24);

        if (!pages.length && !posts.length && !plugins.length) {
          resultsEl.innerHTML = `<div class="cmdk-empty">${I18N.empty}${q ? ' “' + esc(q) + '”' : ''}</div>`;
          return;
        }
        if (pages.length) { addGroup(lang === 'zh' ? '页面' : 'Pages'); pages.forEach(addPage); }
        if (posts.length) { addGroup(lang === 'zh' ? '文章' : 'Articles'); posts.forEach(addPost); }
        if (plugins.length) { addGroup(lang === 'zh' ? '插件' : 'Plugins'); plugins.forEach(addPlugin); }
        updateSel();
      });
    }

    function open() {
      modal.hidden = false;
      input.value = '';
      render('');
      setTimeout(() => input.focus(), 10);
      document.body.style.overflow = 'hidden';
    }
    function close() {
      modal.hidden = true;
      document.body.style.overflow = '';
    }

    trigger.addEventListener('click', open);
    input.addEventListener('input', () => { selIdx = 0; render(input.value); });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); selIdx = Math.min(selIdx + 1, items.length - 1); updateSel(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); selIdx = Math.max(selIdx - 1, 0); updateSel(); }
      else if (e.key === 'Enter') { e.preventDefault(); const sel = items[selIdx]; if (sel && sel.href) window.location.href = sel.href; }
      else if (e.key === 'Escape') { e.preventDefault(); close(); }
    });
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (!modal.hidden) close(); else open();
      }
    });
  })();
</script>
