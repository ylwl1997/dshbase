---
import Base from '../../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
const locale = Astro.currentLocale ?? 'en';
const posts = [
  { path: '/blog/vs-claude-code/', cat: 'Comparison', en: 'DeepSeek Harness vs Claude Code', zh: 'DeepSeek Harness vs Claude Code', desc_en: 'Plugins vs MCP, open source vs closed, pricing, and which to choose.', desc_zh: '插件 vs MCP、开源 vs 闭源、价格与选择。' },
  { path: '/blog/why-deepseek-harness/', cat: 'Concept', en: "Why it's called a Harness", zh: '为什么叫 Harness', desc_en: 'Agent = Model + Harness, the Cordis kernel, and time/spatial composability.', desc_zh: 'Agent = Model + Harness、Cordis 内核与时间/空间可组合性。' },
  { path: '/blog/deepseek-harness-modes/', cat: 'Guide', en: 'The four modes', zh: '四种模式', desc_en: 'Standard, PTC, Minimal, and Create — a complete guide.', desc_zh: '标准 / PTC / 极简 / 创造——完整指南。' },
  { path: '/blog/deepseek-harness-session-log/', cat: 'Analysis', en: 'Append-only session logs', zh: '只追加会话日志', desc_en: 'Observable, auditable, reproducible agent debugging.', desc_zh: '可观测、可审计、可复现的 Agent 调试。' },
  { path: '/blog/deepseek-harness-cost/', cat: 'Analysis', en: 'Cost & caching', zh: '成本与缓存', desc_en: 'How harness choice moves the token bill by up to 7x.', desc_zh: 'Harness 的选择如何让 token 成本差到 7 倍。' },
  { path: '/blog/deepseek-harness-review/', cat: 'Review', en: 'First impressions & V4 Pro pricing', zh: '上手体验与 V4 Pro 定价', desc_en: '37k stars, cache pricing up 12x, the four modes, and the best community plugins.', desc_zh: '37k star、缓存价涨 12 倍、四模式与最佳社区插件。' },
  { path: '/blog/deepseek-harness-architecture/', cat: 'Architecture', en: 'The self-modifying agent', zh: '自进化 Agent', desc_en: 'Everything-is-a-plugin, Cordis, and the "make your own wrench" Create mode.', desc_zh: '一切皆插件、Cordis 与「现场造扳手」的创造模式。' },
  { path: '/blog/deepseek-harness-vs-codex/', cat: 'Comparison', en: 'vs Codex', zh: 'vs Codex', desc_en: 'Agent presets vs scenario modes, rebuildable sessions, and the plugin model.', desc_zh: 'Agent 预设 vs 场景模式、可重建会话与插件模型。' },
  { path: '/blog/pi-deepseek-cache/', cat: 'Analysis', en: 'Pi & the 99.93% cache hit rate', zh: 'Pi 与 99.93% 缓存命中率', desc_en: 'Minimal tools + append-only sessions = cheap DeepSeek.', desc_zh: '最小工具集 + 只追加会话 = 便宜的 DeepSeek。' },
  { path: '/blog/deepseek-harness-comparison/', cat: 'Comparison', en: 'vs 12 coding agents', zh: '横向对比 12 个编程工具', desc_en: 'Claude Code, Codex, Cline, Pi, Reasonix, CodeWhale and more.', desc_zh: 'Claude Code、Codex、Cline、Pi、Reasonix、CodeWhale 等。' },
  { path: '/blog/dsh-plugin-philosophy/', cat: 'Concept', en: 'Plugin philosophy: everything vs fatigue', zh: '插件哲学：一切皆插件 vs 疲劳', desc_en: 'How DSH differs from VS Code and Claude Code.', desc_zh: 'DSH 与 VS Code、Claude Code 有何不同。' },
  { path: '/blog/dsh-self-evolving-software/', cat: 'Concept', en: 'Self-evolving software: miracle or chaos', zh: '自进化软件：福音还是灾难', desc_en: 'The Create mode, Cordis, and OpenClaw\'s warning.', desc_zh: '创造模式、Cordis 与 OpenClaw 的警示。' },
  { path: '/blog/why-typescript-agent-harness/', cat: 'Analysis', en: 'Why TypeScript / Node.js', zh: '为什么是 TypeScript / Node.js', desc_en: 'npm is the plugin distribution layer.', desc_zh: 'npm 是插件分发层。' },
  { path: '/blog/dsh-trajectory-tracing/', cat: 'Tutorial', en: 'Trajectory tracing: the killer feature', zh: 'Trajectory 追踪：killer feature', desc_en: 'Debug agents and cut token waste from the trace.', desc_zh: '从轨迹调试 Agent、削减 token 浪费。' },
  { path: '/blog/dsh-plugin-ecosystem/', cat: 'Analysis', en: 'Plugin ecosystem: 209 plugins', zh: '插件生态：209 个插件', desc_en: 'Ten categories of community plugins from the Show and tell firehose.', desc_zh: '从 Show and tell 里归出十大类社区插件。' },
  { path: '/blog/dsh-feature-requests/', cat: 'Analysis', en: 'The 10 most-requested features', zh: '社区最想要的 10 个功能', desc_en: '297 Ideas ranked — desktop, CLI/TUI, memory, Docker, and more.', desc_zh: '297 条 Ideas 排行——桌面端、CLI/TUI、记忆、Docker 等。' },
  { path: '/blog/dsh-plugin-pollution/', cat: 'Analysis', en: 'The dsh-plugin topic is polluted', zh: 'dsh-plugin topic 被蹭标签污染', desc_en: 'How we vet real DSH plugins from tag-squatters.', desc_zh: '我们如何鉴别真 DSH 插件与蹭标签仓库。' },
  { path: '/blog/deepseek-harness-faq/', cat: 'FAQ', en: 'FAQ: the community\'s most-asked questions', zh: 'FAQ：社区高频问题', desc_en: 'Permissions, image input, token cost, install crashes, Docker, memory.', desc_zh: '权限、图片输入、token 成本、安装崩溃、Docker、记忆。' },
  { path: '/blog/dsh-bug-report/', cat: 'Analysis', en: 'Community bug report: 321 discussions', zh: '社区 Bug 报告全景：321 个讨论', desc_en: 'Eight categories of real-world issues.', desc_zh: '归成 8 大类真实问题。' },
  { path: '/blog/dsh-mcp/', cat: 'Guide', en: 'MCP: connecting servers to DSH', zh: 'MCP：接入 MCP Server', desc_en: 'dsh-workspace-mcp and friends.', desc_zh: 'dsh-workspace-mcp 等。' },
  { path: '/blog/dsh-memory-guide/', cat: 'Guide', en: 'Memory plugins: dsh-memory, dsh-mnemon', zh: '记忆插件：dsh-memory / dsh-mnemon', desc_en: 'A complete guide to DSH memory plugins.', desc_zh: 'DSH 记忆插件全景。' },
  { path: '/blog/dsh-model-setup/', cat: 'Guide', en: 'Model setup: official API, OpenCode Go', zh: '模型接入：官方 API、OpenCode Go', desc_en: 'Three ways to power DeepSeek Harness.', desc_zh: '三种给 DSH 接模型的方式。' },
  { path: '/blog/dsh-sandbox/', cat: 'Guide', en: 'Sandbox: permissions & security', zh: 'Sandbox：权限与安全', desc_en: 'Permissions, security & tool approval.', desc_zh: '权限预设、工具审批。' },
  { path: '/blog/dsh-subagent/', cat: 'Guide', en: 'Subagent: multi-agent, fork & more', zh: 'Subagent：多 Agent、fork 子代理', desc_en: 'Run multiple agents and subagents.', desc_zh: '跑多 Agent / 子代理。' },
  { path: '/blog/dsh-vision/', cat: 'Guide', en: 'Vision: image input & plugins', zh: 'Vision：图片输入与视觉插件', desc_en: 'modlens, dsh-vision-toolkit, upload fixes.', desc_zh: 'modlens、dsh-vision-toolkit、上传修复。' },
  { path: '/blog/vs-cowork/', cat: 'Comparison', en: 'vs Claude Cowork', zh: 'vs Claude Cowork', desc_en: 'Open-source harness vs closed agent.', desc_zh: '开源框架 vs 闭源 Agent。' },
  { path: '/blog/vs-cursor/', cat: 'Comparison', en: 'vs Cursor', zh: 'vs Cursor', desc_en: 'Agent harness vs AI IDE.', desc_zh: 'Agent 框架 vs AI 编辑器。' },
];
const cats = [...new Set(posts.map((p) => p.cat))];
const title = locale === 'en' ? 'Blog — DeepSeek Harness Guides & Analysis | dshbase' : '博客 — DeepSeek Harness 指南与分析 | dshbase 中文';
const desc = locale === 'en' ? 'DeepSeek Harness articles: comparisons, deep dives, and analysis.' : 'DeepSeek Harness 文章：对比、深度解析与分析。';
const heading = locale === 'en' ? 'DeepSeek Harness articles' : 'DeepSeek Harness 文章';
const sub = locale === 'en' ? 'Comparisons, deep dives, and analysis.' : '对比、深度解析与分析。';
const allLabel = locale === 'en' ? 'All' : '全部';
---
<Base title={title} description={desc} currentPath="/blog/">
  <section class="hero wrap">
    <p class="eyebrow">Blog</p>
    <h1>{heading}</h1>
    <p class="lede">{sub}</p>
  </section>
  <section class="info wrap">
    <div class="cat-filter" role="tablist" aria-label="Filter by category">
      <button class="fchip is-active" data-filter="all">{allLabel} <b>{posts.length}</b></button>
      {cats.map((c) => (
        <button class="fchip" data-filter={c}>{c} <b>{posts.filter((p) => p.cat === c).length}</b></button>
      ))}
    </div>
    <div class="grid3" id="post-grid">
      {posts.map((p) => (
        <a class="card card-link post-card" data-cat={p.cat} href={getRelativeLocaleUrl(locale, p.path)}>
          <span class="cat">{p.cat}</span>
          <h3>{locale === 'en' ? p.en : p.zh}</h3>
          <p>{locale === 'en' ? p.desc_en : p.desc_zh} <span class="arr">&rarr;</span></p>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .cat-filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 20px; }
  .fchip { font-size: 12.5px; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-card); color: var(--ink-2); cursor: pointer; font-family: inherit; }
  .fchip b { font-weight: 700; opacity: .6; }
  .fchip:hover { color: var(--primary); border-color: var(--primary); }
  .fchip.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .fchip.is-active b { opacity: .9; }
  .post-card[hidden] { display: none; }
</style>

<script>
  const chips = document.querySelectorAll('.fchip');
  const cards = document.querySelectorAll('.post-card');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      const f = chip.dataset.filter;
      cards.forEach((card) => { card.hidden = f !== 'all' && card.dataset.cat !== f; });
    });
  });
</script>
