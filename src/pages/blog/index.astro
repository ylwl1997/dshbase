---
import Base from '../../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
const locale = Astro.currentLocale ?? 'en';
const posts = [
  { path: '/blog/wx-plugin-tree-ecosystem/', cat: 'Guide', en: "How to pick DSH plugins: read the plugin tree first, then choose by task", zh: "DSH 插件怎么挑：先看懂插件树，再按任务选", desc_en: "Every DSH capability is a plugin. Read the six plugin families — model, tool, memory, sandbox, orchestration, UI — then pick by task, not by stars.", desc_zh: "DSH 的每个能力都是插件。看懂模型、工具、会话、沙箱、编排、UI 六大类，再按任务挑插件，别被热度带偏。" },
  { path: '/blog/wx-dsh-patch-stack-field-notes/', cat: 'Guide', en: "The five layers under your dsh config: field notes on the patch stack, PTC savings and the skills wart", zh: "你的 dsh 配置叠了五层纸:补丁栈、PTC 省钱位和那个技能软链坑", desc_en: "How dsh layers five config files, why apiKeyEnv beats apiKey, what PTC mode really changes, and the skills-path wart nobody warns you about.", desc_zh: "五层配置怎么叠、apiKeyEnv 别写错、PTC 到底改了什么、技能必须软链到固定目录的设计坑" },
  { path: '/blog/wx-dsh-store-admission-funnel-253-of-1411/', cat: 'Analysis', en: "A plugin store that said no to 1,225 entries: reading the DSH-Store admission numbers with you", zh: "一个对 1225 条记录说不的插件商城:DSH-Store 准入漏斗拆解", desc_en: "DSH-Store admits 253 of 1,411 catalog records through a three-layer gate. We check the funnel math, the risk tiers, and where it grades its own homework.", desc_zh: "1411 条目录记录只放进 253 个:三层准入闸、R0 到 R3 风险分级怎么运作,哪些环节还得靠作者自报" },
  { path: '/blog/wx-agent-architecture-control-three-schools/', cat: 'Analysis', en: "Claude Code, Codex, and DeepSeek Harness: three answers to one question — who holds control", zh: "Claude Code、Codex 与 DSH 的架构分野：同一项任务，控制权交给谁", desc_en: "Comparing the three agent runtimes on where engineering complexity is spent: workflow conventions, OS-level sandboxing, or a fully replaceable plugin kernel.", desc_zh: "三家 Agent 运行时把工程复杂度花在哪：工作流约定、操作系统级沙箱，还是连内核循环都可替换。" },
  { path: '/blog/wx-dsh-web-ui-plugin-skin-suite-review/', cat: 'Review', en: "dsh-web-ui reviewed: one command turns the bare DSH console into a full workbench", zh: "dsh-web-ui 全家桶实测评测：一条命令把 DSH 毛坯界面装成工作台", desc_en: "90+ contributors, 19 skins, task board, Git graph, SSH panel. What the dsh-web-ui bundle installs, what it costs, and what to audit first.", desc_zh: "90 位贡献者、19 款皮肤、任务看板、Git 图谱、SSH 终端——dsh-web-ui 全家桶装了什么、付出什么、先审计哪一处。" },
  { path: '/blog/wx-deepseek-harness-plugin-development-tutorial/', cat: 'Tutorial', en: "Write Your First DeepSeek Harness Plugin: Tool, Bundle, Publish", zh: "手把手写第一个 DeepSeek Harness 插件：注册、打包、发布", desc_en: "A rewritten step-by-step guide to DSH plugin development: defineTool, cordis.yml overlays, bundling, and the dsh-tools version trap.", desc_zh: "改写整理版 DSH 插件开发全流程：defineTool、热加载、打包发布与版本坑。" },
  { path: '/blog/wx-deepseek-harness-100k-stars-plugin-ecosystem/', cat: 'Analysis', en: "DeepSeek Harness Hit 100K Stars in 45 Hours: What the Plugin Boom Means for You", zh: "DeepSeek Harness 开源45小时破10万星：插件狂潮下该做什么", desc_en: "Harness v0.1 went MIT-open and crossed 100k stars in 45 hours. A rewritten analysis of the plugin ecosystem, PTC mode, and security trade-offs.", desc_zh: "Harness v0.1 开源45小时破10万星。改写解读插件生态、PTC 模式与安全权衡。" },
  { path: '/blog/wx-dsh-100k-stars-45h/', cat: 'Pulse', en: "DeepSeek Harness Hit 100K GitHub Stars in 45 Hours — What the Plugin Rush Means for You", zh: "DeepSeek Harness 45 小时破 10 万星：这波插件潮对使用者意味着什么", desc_en: "DeepSeek Harness crossed 100k stars in 45 hours. We break down what the plugin ecosystem boom changes for installers, and where the hype oversells.", desc_zh: "DSH 开源 45 小时破 10 万星。本文拆解插件生态爆发对安装者的实际影响，以及哪些说法言过其实。" },
  { path: '/blog/wx-dsh-plugin-picks/', cat: 'Review', en: 'Ten DeepSeek Harness plugins actually worth installing', zh: '十个真正值得装的 DeepSeek Harness 插件', desc_en: 'A field-tested shortlist of ten DSH plugins — desktop shell, TUI, market, sidebar, @-file, context meter, vision, browser, teams, skins — with the caveats for each.', desc_zh: '实测筛过的 DSH 插件清单：桌面壳、TUI、市场、侧栏、@文件、上下文仪表、识图、浏览器、多代理、皮肤，每个都附注意事项。' },
  { path: '/blog/wx-dsh-workbench-take/', cat: 'Analysis', en: 'DeepSeek Harness is a workbench, not a model', zh: 'DeepSeek Harness 不是新模型，而是可回放的工作台', desc_en: 'What DSH actually is: a pluggable agent runtime where the scarce feature is a replayable trajectory — who should install it now and who should wait.', desc_zh: 'DSH 的正确定位：可插拔的 Agent 运行时，最稀缺的能力是可重放的轨迹——现在该装的是谁，该等的又是谁。' },
  { path: '/blog/wx-dsh-vs-frameworks/', cat: 'Analysis', en: 'DSH vs LangChain vs AutoGPT: runtime, not framework', zh: 'DSH、LangChain、AutoGPT：运行时而非框架', desc_en: 'Where the agent loop, memory, tools and sandbox live in each system, and why plugin composition changes the extension story.', desc_zh: '三者中 Agent 循环、记忆、工具与沙箱各在哪一层，以及插件组合如何改变扩展方式。' },
  { path: '/blog/wx-dsh-agent-team/', cat: 'Analysis', en: 'The Agent Team tab is a glass room, not a black box', zh: 'Agent Team 页签：一间玻璃房，而不是黑盒', desc_en: 'DSH ships a Team view that looks like Tencent Marvis at a glance but inverts the philosophy: transparent and auditable multi-agent collaboration where every member, tool and message is visible.', desc_zh: 'DSH 的 Agent Team 乍看像腾讯马维斯，骨子里却相反：透明、可审计的多智能体协作，每一步都看得见。' },
  { path: '/blog/wx-dsh-raid-test/', cat: 'Review', en: '66 minutes and a few yuan: a real RAID reassembly', zh: '66 分钟、几块钱，跑完一场 RAID 重组', desc_en: 'Install, the four modes, then a real forensic RAID-reassembly workload: 66 minutes, 2 to 4 million tokens, about 3 to 6 yuan, plus the trajectory-to-skill loop.', desc_zh: '安装、四种模式，再跑一次真实取证 RAID 重组：66 分钟 / 200-400 万 token / 3-6 元，还附带「轨迹 → Skill」闭环。' },
  { path: '/blog/wx-dsh-polarized-reviews/', cat: 'Analysis', en: 'Why DeepSeek Harness gets such polarized reviews', zh: '为什么 DeepSeek Harness 的评价两极分化', desc_en: 'The split is not China versus abroad: ordinary users want a finished product, developers want to own the harness. Same engine, different cars.', desc_zh: '分歧不在国内外，而在「想要成品」和「想拥有 Harness」之间——同一台发动机，装进不同的车。' },
  { path: '/blog/wx-dsh-build-plugin/', cat: 'Guide', en: 'Build a DeepSeek Harness tool plugin from scratch', zh: '从零构建一个 DeepSeek Harness 工具插件', desc_en: 'A practical walkthrough of packaging a complete dsh plugin: the package skeleton, a defineTool, the capability seam for calling the LLM, registration, and a behavioural test.', desc_zh: '手把手打包一个完整 dsh 插件：包骨架、defineTool、通过能力接缝调用 LLM、注册与生命周期、行为测试。' },
  { path: '/blog/wx-dsh-dsh2shell-rce/', cat: 'Analysis', en: 'dsh2shell: the unauthenticated RCE in web-exposed DeepSeek Harness', zh: 'dsh2shell：Web 暴露的 DSH 未授权 RCE 分析', desc_en: 'A spoofed Host header unlocks DSH privileged RPC from the internet: register a fake provider, switch the session, drive the bash tool. CVSS 9.8, and how to fix it.', desc_zh: '伪造一个 Host: localhost 头就能从公网解锁 DSH 的特权 RPC：注册恶意提供端、切换模型、驱动 bash 工具。CVSS 9.8，以及上线前要修什么。' },
  { path: '/blog/wx-dsh-60task-bench/', cat: 'Analysis', en: 'DeepSeek Harness benchmarked: 60 real tasks, three axes', zh: 'DeepSeek Harness 60 项任务评测：能力、成本、耗时三维拆解', desc_en: 'Shanghai AI Lab scores V4 Pro + Harness on 60 real agent tasks: mid-tier ability, half the cost of OpenClaw, slower execution — and which models the harness actually amplifies.', desc_zh: '司南评测体系用 60 项真实任务测了 V4 Pro + Harness：能力中上、成本砍半、耗时偏长，以及哪些模型组合才能真正被 Harness 放大。' },
  { path: '/blog/wx-dsh-vision-excel-flop/', cat: 'Review', en: 'Three releases in three days — and the vision model flubs a 4-column Excel sum', zh: '三天三版：视觉模型刚上车，Excel 四列全算错', desc_en: 'rc.8 → rc.1 → rc.2 in 72 hours: first-party vision arrives, and a real test where the new vision model read an Excel screenshot and got every total wrong.', desc_zh: 'rc.8 → rc.1 → rc.2 三天连发三版；用 Vision-Exp 实测服务器资源表截图，21 行读成 18 行，四项汇总全错，确认三遍还是错。' },
  { path: '/blog/wx-dsh-six-dim-review/', cat: 'Review', en: '121,767 stars, six axes: an honest health check', zh: '12 万星与六维体检：DeepSeek Harness 深度实测', desc_en: '36 official packages, reversible plugin side effects, 7,000-event session logs, plugin security with no guardrails — overall 6.5/10 on a real-machine review.', desc_zh: '36 个官方包的真实模块化、可逆副作用、单会话 7000 条事件日志、毫无护栏的插件安全模型，综合 6.5/10。' },
  { path: '/blog/wx-dsh-windows-setup/', cat: 'Guide', en: 'Installing DeepSeek Harness on Windows, and reproducing the V4 Pro benchmark setup', zh: 'Windows 上装 DeepSeek Harness，并复现 V4 Pro 的跑分配置', desc_en: 'Node requirements, the npm install that actually works, first workspace, the four presets — then a Minimal-mode control experiment that verifies (or debunks) the V4 Pro benchmark talk.', desc_zh: 'Node 版本要求、真正能装上的 npm 方式、首个工作区、四种预设，再加一组极简模式对照实验来复现或证伪 V4 Pro 跑分争议。' },
  { path: '/blog/wx-dsh-glm53-test/', cat: 'Review', en: 'GLM-5.3 on DeepSeek Harness vs GPT-5.6-Sol: same PRD, two agents', zh: 'GLM-5.3 接入 DeepSeek Harness 实测：同一份 PRD，两个 Agent', desc_en: 'Datawhale runs a production image-matting web app through both models in DSH: core features tied, engineering details diverged — rate limiting and security headers by default.', desc_zh: 'Datawhale 用 DSH 跑生产级抠图应用：GLM-5.3 与 GPT-5.6-Sol 核心功能打平，工程细节分高下——限流、安全头默认自带，还主动补了两个功能。' },
  { path: '/blog/wx-dsh-codex-vs-flash-pro/', cat: 'Analysis', en: 'DeepSeek Harness from the inside: plugins, Cordis and a three-model fix test', zh: 'DeepSeek Harness 从里到外：插件、Cordis 与三模型实测', desc_en: 'A deep-dive into everything-is-a-plugin (Cordis, Capability Seam, five event modes, the session log), then one real bug fixed three ways: Codex 9 min, V4 Flash, V4 Pro stalled.', desc_zh: '拆解万物皆插件（Cordis、Capability Seam、五种事件模式、会话日志），再用同一 bug 实测三种组合：Codex 9 分钟、V4 Flash 20 分钟、V4 Pro 翻车。' },
  { path: '/blog/wx-dsh-first-impression/', cat: 'Review', en: 'Week one with DeepSeek Harness: patching MCP without a restart', zh: 'DeepSeek Harness 第一周：不重启改 MCP 并用它拆 APK', desc_en: 'A week-one field note turned into installer tips: one-command startup, skills hot-reload, the no-restart MCP patch, and a jadx reverse-engineering ask.', desc_zh: '把安全研究员的一周手记改写成安装者笔记：一条命令起手、skills 热刷新、免重启的 MCP 配置，以及一个 jadx 逆向用例。' },
  { path: '/blog/wx-dsh-command-map/', cat: 'Guide', en: "dsh Command Map: A Practical Installer Cheat Sheet", zh: "dsh 命令地图：安装者速查", desc_en: "A practical map of dsh CLI commands: web UI, profiles, modes, plugins, permissions, and subagents. Verify with current docs as rc.x may change.", desc_zh: "dsh 命令实用地图：Web UI、配置导出、模式、插件、权限与 rc.8 子代理。rc.x 会变，以最新文档为准。" },
  { path: '/blog/wx-orange-book-notes/', cat: 'Analysis', en: "Installer Field Notes: An Orange-Book Style Teardown of DeepSeek Harness", zh: "安装者手记：DeepSeek Harness 橙皮书式拆解", desc_en: "Field notes for installers: dump-config, append-only logs, Create-mode risk, PTC cost myths, and why verified installs beat star counts.", desc_zh: "安装者视角：dump-config、只追加日志、创造模式风险、PTC 并不自动更省，以及已验证安装为何胜过 star 数。" },
  { path: '/blog/wx-rc8-multimodal/', cat: 'Guide', en: "DeepSeek Harness rc.8: Multimodal Inputs & Subagent Bundles", zh: "DeepSeek Harness rc.8：多模态输入与子代理捆绑", desc_en: "What rc.8 changes for installers: image-capable adapters, Claude Code/Codex bundles, Windows PTY, and why verified packs still matter.", desc_zh: "rc.8 对安装者意味着什么：可配图像适配器、Claude Code/Codex 捆绑、Windows PTY，以及为什么已验证包仍然重要。" },
  { path: '/blog/dsh-rc8/', cat: 'Guide', en: 'DeepSeek Harness 0.1.0-rc.8: vision, subagents & verified packs', zh: 'DeepSeek Harness 0.1.0-rc.8：Vision、Subagent 与已验证包', desc_en: 'Hub: multimodal narrative vs vision API not ready vs packs; Claude Code/Codex subagents.', desc_zh: '枢纽：多模态叙事 vs 视觉 API 未就绪 vs packs；Claude Code/Codex 子代理。' },
  { path: '/blog/plugin-redefined/', cat: 'Concept', en: 'What “everything is a plugin” actually means', zh: '「一切皆插件」到底是什么意思', desc_en: 'Sessions, sandboxes, and filesystems as swappable modules — and why verified installs matter.', desc_zh: '会话、沙箱、文件系统也是可替换模块——以及为什么已验证安装很重要。' },
  { path: '/blog/harness-vs-benchmark/', cat: 'Analysis', en: 'From 30.2% to 96.2%: harness beats the scorecard', zh: '从 30.2% 到 96.2%：差距在 Harness', desc_en: 'Same weights, different runtime. Why V4 Pro pricing noise is not the whole story.', desc_zh: '同一权重、不同运行时。为什么只盯 V4 Pro 价格不够。' },
  { path: '/blog/first-day-with-dsh/', cat: 'Guide', en: 'A realistic first day with DeepSeek Harness', zh: 'DeepSeek Harness 真实的第一天', desc_en: 'dsh web, permissions, modes, cache — and the zombie Deep-diving trap.', desc_zh: 'dsh web、权限、模式、缓存——以及僵尸 Deep diving 陷阱。' },
  { path: '/blog/vs-cursor/', cat: 'Comparison', en: 'DeepSeek Harness vs Cursor (2026)', zh: 'DeepSeek Harness vs Cursor（2026）', desc_en: 'Updated: both have agents now. Harness + CI vs AI IDE — when to use both.', desc_zh: '更新：两边都有 Agent。开源 harness + CI vs AI IDE，以及怎么一起用。' },
  { path: '/blog/vs-claude-code/', cat: 'Comparison', en: 'DeepSeek Harness vs Claude Code', zh: 'DeepSeek Harness vs Claude Code', desc_en: 'Plugins vs MCP, open source vs closed, pricing, and which to choose.', desc_zh: '插件 vs MCP、开源 vs 闭源、价格与选择。' },
  { path: '/blog/why-deepseek-harness/', cat: 'Concept', en: "Why it's called a Harness", zh: '为什么叫 Harness', desc_en: 'Agent = Model + Harness, the Cordis kernel, and time/spatial composability.', desc_zh: 'Agent = Model + Harness、Cordis 内核与时间/空间可组合性。' },
  { path: '/blog/deepseek-harness-modes/', cat: 'Guide', en: 'The four modes', zh: '四种模式', desc_en: 'Standard, PTC, Minimal, and Create — a complete guide.', desc_zh: '标准 / PTC / 极简 / 创造——完整指南。' },
  { path: '/blog/deepseek-harness-session-log/', cat: 'Analysis', en: 'Append-only session logs', zh: '只追加会话日志', desc_en: 'Observable, auditable, reproducible agent debugging.', desc_zh: '可观测、可审计、可复现的 Agent 调试。' },
  { path: '/blog/deepseek-harness-cost/', cat: 'Analysis', en: 'Cost & caching', zh: '成本与缓存', desc_en: 'How harness choice moves the token bill by up to 7x.', desc_zh: 'Harness 的选择如何让 token 成本差到 7 倍。' },
  { path: '/blog/deepseek-harness-review/', cat: 'Review', en: 'First impressions & V4 Pro pricing', zh: '上手体验与 V4 Pro 定价', desc_en: '37k stars, cache pricing up 12x, the four modes, and the best community plugins.', desc_zh: '37k star、缓存价涨 12 倍、四模式与最佳社区插件。' },
  { path: '/blog/deepseek-harness-architecture/', cat: 'Architecture', en: 'The self-modifying agent', zh: '自进化 Agent', desc_en: 'Everything-is-a-plugin, Cordis, and the "make your own wrench" Create mode.', desc_zh: '一切皆插件、Cordis 与「现场造扳手」的创造模式。' },
  { path: '/blog/deepseek-harness-vs-codex/', cat: 'Comparison', en: 'vs Codex', zh: 'vs Codex', desc_en: 'Agent presets vs scenario modes, rebuildable sessions, and the plugin model.', desc_zh: 'Agent 预设 vs 场景模式、可重建会话与插件模型。' },
  { path: '/blog/pi-deepseek-cache/', cat: 'Analysis', en: 'Pi & the 99.93% cache hit rate', zh: 'Pi 与 99.93% 缓存命中率', desc_en: 'Minimal tools + append-only sessions = cheap DeepSeek.', desc_zh: '最小工具集 + 只追加会话 = 便宜的 DeepSeek。' },
  { path: '/blog/dsh-vs-american-tools/', cat: 'Analysis', en: 'DeepSeek Harness vs America’s agent tools', zh: '冲击美国 Agent 工具', desc_en: '158k stars in 5 days — what it does to Claude Code, Codex, Cursor and Copilot.', desc_zh: '5 天 15.8 万星——对 Claude Code、Codex、Cursor、Copilot 的冲击。' },
  { path: '/blog/deepseek-harness-comparison/', cat: 'Comparison', en: 'vs 12 coding agents', zh: '横向对比 12 个编程工具', desc_en: 'Claude Code, Codex, Cline, Pi, Reasonix, CodeWhale and more.', desc_zh: 'Claude Code、Codex、Cline、Pi、Reasonix、CodeWhale 等。' },
  { path: '/blog/dsh-plugin-philosophy/', cat: 'Concept', en: 'Plugin philosophy: everything vs fatigue', zh: '插件哲学：一切皆插件 vs 疲劳', desc_en: 'How DSH differs from VS Code and Claude Code.', desc_zh: 'DSH 与 VS Code、Claude Code 有何不同。' },
  { path: '/blog/dsh-self-evolving-software/', cat: 'Concept', en: 'Self-evolving software: miracle or chaos', zh: '自进化软件：福音还是灾难', desc_en: 'The Create mode, Cordis, and OpenClaw\'s warning.', desc_zh: '创造模式、Cordis 与 OpenClaw 的警示。' },
  { path: '/blog/why-typescript-agent-harness/', cat: 'Analysis', en: 'Why TypeScript / Node.js', zh: '为什么是 TypeScript / Node.js', desc_en: 'npm is the plugin distribution layer.', desc_zh: 'npm 是插件分发层。' },
  { path: '/blog/dsh-trajectory-tracing/', cat: 'Tutorial', en: 'Trajectory tracing: the killer feature', zh: 'Trajectory 追踪：killer feature', desc_en: 'Debug agents and cut token waste from the trace.', desc_zh: '从轨迹调试 Agent、削减 token 浪费。' },
  { path: '/blog/dsh-plugin-ecosystem/', cat: 'Analysis', en: 'Plugin ecosystem: 209 plugins', zh: '插件生态：209 个插件', desc_en: 'Ten categories of community plugins from the Show and tell firehose.', desc_zh: '从 Show and tell 里归出十大类社区插件。' },
  { path: '/blog/dsh-feature-requests/', cat: 'Analysis', en: 'The 10 most-requested features', zh: '社区最想要的 10 个功能', desc_en: '297 Ideas ranked — desktop, CLI/TUI, memory, Docker, and more.', desc_zh: '297 条 Ideas 排行——桌面端、CLI/TUI、记忆、Docker 等。' },
  { path: '/blog/dsh-plugin-pollution/', cat: 'Analysis', en: 'The dsh-plugin topic is polluted', zh: 'dsh-plugin topic 被蹭标签污染', desc_en: 'How we vet real DSH plugins from tag-squatters.', desc_zh: '我们如何鉴别真 DSH 插件与蹭标签仓库。' },
  { path: '/blog/deepseek-harness-faq/', cat: 'FAQ', en: 'FAQ: the community\'s most-asked questions', zh: 'FAQ：社区高频问题', desc_en: 'Permissions, image input, token cost, install crashes, Docker, memory.', desc_zh: '权限、图片输入、token 成本、安装崩溃、Docker、记忆。' },
  { path: '/blog/dsh-bug-report/', cat: 'Analysis', en: 'Community bug report: 321 discussions', zh: '社区 Bug 报告全景：321 个讨论', desc_en: 'Eight categories of real-world issues.', desc_zh: '归成 8 大类真实问题。' },
  { path: '/blog/dsh-mcp/', cat: 'Guide', en: 'MCP: connecting servers to DSH', zh: 'MCP：接入 MCP Server', desc_en: 'dsh-workspace-mcp and friends.', desc_zh: 'dsh-workspace-mcp 等。' },
  { path: '/blog/dsh-memory-guide/', cat: 'Guide', en: 'Memory plugins: dsh-memory, dsh-mnemon', zh: '记忆插件：dsh-memory / dsh-mnemon', desc_en: 'A complete guide to DSH memory plugins.', desc_zh: 'DSH 记忆插件全景。' },
  { path: '/blog/dsh-model-setup/', cat: 'Guide', en: 'Model setup tutorial: official API, OpenCode Go', zh: '模型接入教程：官方 API、OpenCode Go', desc_en: 'Three setups + rc.8 vision API status (use packs meanwhile).', desc_zh: '三种接入 + rc.8 视觉 API 现状（过渡期用 packs）。' },
  { path: '/blog/dsh-sandbox/', cat: 'Guide', en: 'Sandbox: permissions & security', zh: 'Sandbox：权限与安全', desc_en: 'Permissions, security & tool approval.', desc_zh: '权限预设、工具审批。' },
  { path: '/blog/dsh-subagent/', cat: 'Guide', en: 'Subagent tutorial: Claude Code, Codex & forks', zh: 'Subagent 教程：Claude Code / Codex / fork', desc_en: 'rc.8 subagents: Claude Code/Codex bridges + verified plugins.', desc_zh: 'rc.8 子代理：Claude Code/Codex 桥与已验证插件。' },
  { path: '/blog/dsh-vision/', cat: 'Guide', en: 'Vision tutorial: rc.8 narrative vs verified packs', zh: 'Vision 教程：rc.8 叙事 vs 已验证 packs', desc_en: 'Catalog gap vs modlens / vision toolkit packs.', desc_zh: 'catalog 缺口 vs modlens / vision toolkit 场景包。' },
  { path: '/blog/vs-cowork/', cat: 'Comparison', en: 'vs Claude Cowork', zh: 'vs Claude Cowork', desc_en: 'Open-source harness vs closed agent.', desc_zh: '开源框架 vs 闭源 Agent。' },
  { path: '/blog/dsh-desktop-alternatives/', cat: 'Guide', en: 'Is DeepSeek Harness a desktop app? CLI, VSCode, TUI & Electron shells', zh: 'DeepSeek Harness 有桌面端吗？CLI、VSCode、TUI、Electron 替代方案', desc_en: 'DSH has no official desktop client — here are the real alternatives.', desc_zh: 'DSH 没有官方桌面客户端——这里是真正的替代方案。' },
  { path: '/blog/dsh-im-integration/', cat: 'Guide', en: 'IM integrations: WeChat, QQ, Feishu, DingTalk & Telegram', zh: 'IM 接入：微信、QQ、飞书、钉钉、Telegram', desc_en: 'Put DeepSeek Harness inside your chat apps — the full plugin lineup.', desc_zh: '把 DeepSeek Harness 塞进你的聊天软件——社区插件完整阵容。' },
  { path: '/blog/community-pulse-1/', cat: 'Pulse', en: 'Community Pulse #1 — what users want right now', zh: '社区脉搏 · 第 1 期：用户现在最想要什么', desc_en: '2,638 discussions distilled: the loudest asks, this month\'s session-corruption bugs, and the crowded plugin-discovery race.', desc_zh: '扫完 2638 个讨论：最响亮的诉求、本月的会话损坏 bug，以及拥挤的插件发现赛道。' },
    { path: '/blog/community-pulse-2/', cat: 'Pulse', en: 'Community Pulse #2 — install hangs, subagent defaults & the 7,000-plugin count war', zh: '社区脉搏 · 第 2 期：安装卡死、子代理默认模型与 7000 插件军备竞赛', desc_en: '4,404 discussions distilled: the npm-install hang cluster, subagent model-inheritance bugs, and the accelerating plugin-count race.', desc_zh: '扫完 4404 个讨论：npm 安装卡死群集、子代理模型继承 bug，以及越打越热的插件数军备竞赛。' },
  { path: '/blog/what-makes-a-good-dsh-plugin/', cat: 'Guide', en: 'What makes a good DeepSeek Harness plugin', zh: '什么才是 DeepSeek Harness 好的插件', desc_en: 'The author checklist: bundle manifest, ESM, version pins, inject — and how to earn Verified.', desc_zh: '作者自查清单：bundle 清单、ESM、版本 pin、inject，以及如何拿到已验证。' },
];
const cats = [...new Set(posts.map((p) => p.cat))];
const title = locale === 'en' ? 'Blog — DeepSeek Harness Tutorial, Vision, Subagent & vs Claude Code | dshbase' : '博客 — DeepSeek Harness 教程、Vision、Subagent 与对比 | dshbase 中文';
const desc = locale === 'en' ? 'DeepSeek Harness (DSH) guides: install & tutorial, rc.8 vision, subagent, vs Claude Code, and verified plugin analysis.' : 'DeepSeek Harness 文章：安装与教程、rc.8 vision、subagent、vs Claude Code 与已验证插件分析。';
const heading = locale === 'en' ? 'DeepSeek Harness articles' : 'DeepSeek Harness 文章';
const sub = locale === 'en' ? 'Tutorials, rc.8 hub, comparisons, and analysis.' : '教程、rc.8 枢纽、对比与分析。';
const allLabel = locale === 'en' ? 'All' : '全部';
---
<Base title={title} description={desc} currentPath="/blog/">
  <section class="hero wrap">
    <p class="eyebrow">Blog</p>
    <h1>{heading}</h1>
    <p class="lede">{sub}</p>
  </section>
  <section class="info wrap">
    <div class="cat-filter" role="tablist" aria-label="Filter by category">
      <button class="fchip is-active" data-filter="all">{allLabel} <b>{posts.length}</b></button>
      {cats.map((c) => (
        <button class="fchip" data-filter={c}>{c} <b>{posts.filter((p) => p.cat === c).length}</b></button>
      ))}
    </div>
    <div class="grid3" id="post-grid">
      {posts.map((p) => (
        <a class="card card-link post-card" data-cat={p.cat} href={getRelativeLocaleUrl(locale, p.path)}>
          <span class="cat">{p.cat}</span>
          <h3>{locale === 'en' ? p.en : p.zh}</h3>
          <p>{locale === 'en' ? p.desc_en : p.desc_zh} <span class="arr">&rarr;</span></p>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .cat-filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 20px; }
  .fchip { font-size: 12.5px; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-card); color: var(--ink-2); cursor: pointer; font-family: inherit; }
  .fchip b { font-weight: 700; opacity: .6; }
  .fchip:hover { color: var(--primary); border-color: var(--primary); }
  .fchip.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .fchip.is-active b { opacity: .9; }
  .post-card[hidden] { display: none; }
</style>

<script>
  const chips = document.querySelectorAll('.fchip');
  const cards = document.querySelectorAll('.post-card');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      const f = chip.dataset.filter;
      cards.forEach((card) => { card.hidden = f !== 'all' && card.dataset.cat !== f; });
    });
  });
</script>
