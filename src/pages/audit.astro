---
import Base from '../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import plugins from '../data/plugins.json';
import syncDate from '../data/sync-date.json';
import { pendingFailRows, FAIL_LABELS_EN } from '../lib/audit-fail.js';

const catOrder = Object.keys(plugins);
const all = catOrder.flatMap((k) => plugins[k]);
const total = all.length;
const nCats = catOrder.length;

const repoOf = (u) => (u || '').match(/github\.com\/([^/]+\/[^/]+?)(?:\/|$)/i)?.[1]?.toLowerCase() || '';
const uniqueRepos = new Set(all.map((p) => repoOf(p.url)).filter(Boolean)).size;

const nVerified = all.filter((p) => p.test === 'verified').length;
const nPending = all.filter((p) => p.test === 'pending').length;
const nMit = all.filter((p) => (p.license || '') === 'MIT').length;

const fmt = (n) => n.toLocaleString('en-US');
const directoryUrl = getRelativeLocaleUrl('en', '/plugins/directory/');
const pluginsUrl = getRelativeLocaleUrl('en', '/plugins/');

const failRows = pendingFailRows(plugins);
const failCounts = {};
failRows.forEach((r) => { failCounts[r.failClass] = (failCounts[r.failClass] || 0) + 1; });
const failOrder = ['install-fail', 'load-fail', 'runtime-fail', 'webonly', 'external-deps', 'other', 'untested'];

const stats = [
  { n: fmt(total), label: 'plugins' },
  { n: fmt(nCats), label: 'categories' },
  { n: fmt(uniqueRepos), label: 'repositories' },
  { n: fmt(nVerified), label: 'verified' },
  { n: fmt(nPending), label: 'pending' },
  { n: fmt(nMit), label: 'MIT-licensed' },
];

const report = {
  method: [
    { k: 'L1 · Install', v: 'the plugin is installed into a clean profile alongside a pinned DSH runtime.' },
    { k: 'L2 · Load', v: 'the profile boots and dumps its configuration successfully.' },
    { k: 'L3 · Runtime', v: 'a headless question is answered with the plugin loaded; the run must exit cleanly and return the expected answer. GUI-only plugins use webonly CDP.' },
  ],
  results: [
    { n: '551', label: 'passed', ok: true },
    { n: '198', label: 'runtime fail' },
    { n: '164', label: 'install fail' },
    { n: '10', label: 'load fail' },
  ],
  causes: [
    { title: 'Install failures', total: '159', items: [
      ['68', 'declared dependency version does not exist on the registry'],
      ['63', 'build / prepare script failed (often a dependency on an unpublished @deepseek-ai/* package)'],
      ['15', 'dependency package or repository returns 404'],
      ['13', 'unsupported dependency structure (workspace / linked / exotic)'],
    ] },
    { title: 'Runtime failures', total: '182', items: [
      ['107', 'plugin entry failed to activate at boot'],
      ['70', 'loader entry failed to apply (unsupported schema DSL, missing config, version mismatch)'],
      ['5', 'other'],
    ] },
    { title: 'Load failures', total: '10', items: [
      ['10', 'overlay file missing (ENOENT)'],
    ] },
  ],
};
---

<Base
  title="How We Audit Plugins — dshbase Verification Methodology | dshbase"
  description="Verified on dshbase means L1 install + L2 load + L3 runtime — not a topic count. Browse pending failures by class, and read how we audit every DeepSeek Harness plugin."
  currentPath="/audit/"
>
  <section class="hero wrap">
    <p class="eyebrow">Plugin audit</p>
    <h1>How we audit <span class="accent">every plugin</span></h1>
    <p class="lede"><strong>Verified</strong> means we ran L1 install + L2 load + L3 runtime Q&amp;A on dsh 0.1.0-rc.6 — not a topic count or a parseable-manifest badge. Pending entries stay visible with the failure note when we have one.</p>
  </section>

  <section class="wrap audit-stats">
    {stats.map((s) => (
      <div class="astat">
        <b>{s.n}</b>
        <span>{s.label}</span>
      </div>
    ))}
  </section>

  <section class="info wrap">
    <p class="as-of">Data current as of {syncDate.updated} · recalculated on every build from the live <a href="https://github.com/ylwl1997/dshbase" rel="noopener">plugin dataset</a>.</p>

    <h2>What Verified means</h2>
    <p>Listing answers “does this belong here?” Verification answers “does it actually work?” Other catalogs sometimes label “verified” when a plugin is merely installable from a manifest. Here:</p>
    <ul>
      {report.method.map((m) => (
        <li><strong>{m.k}</strong> — {m.v}</li>
      ))}
    </ul>
    <ul>
      <li><strong><code>verified</code></strong> — all three stages passed (or webonly CDP L3 for GUI plugins).</li>
      <li><strong><code>pending</code></strong> — listed, but not yet L3-passed (or a prior run failed — see the note).</li>
      <li><strong>Trust tier</strong> is supplementary; stars are popularity only.</li>
    </ul>

    <h2>Three audits before listing</h2>
    <p>Each entry is checked before it appears in the <a href={directoryUrl}>directory</a>.</p>
    <div class="grid3">
      <div class="card">
        <h3>1 · Source audit</h3>
        <p>Every entry must map to a real, reachable GitHub repository. Renamed, deleted, or unreachable repositories are removed.</p>
      </div>
      <div class="card">
        <h3>2 · Ecosystem audit</h3>
        <p>DSH-specific manifests (<code>cordis.patch.yml</code>, <code>dsh.bundle</code>, …) and DSH dependencies — not just a repo name or topic tag.</p>
      </div>
      <div class="card">
        <h3>3 · Metadata audit</h3>
        <p>License, stars, forks, issues, last-updated date, language, and archived status on every card.</p>
      </div>
    </div>

    <h2 id="pending">Pending &amp; failure browser</h2>
    <p>{fmt(nPending)} plugins are currently <code>pending</code>. Filter by failure class parsed from the catalog note (live data — not the August batch snapshot below).</p>
    <div class="fail-filters" id="fail-filters" role="tablist" aria-label="Filter pending by failure class">
      <button type="button" class="fchip is-active" data-fail="all">All <b>{failRows.length}</b></button>
      {failOrder.filter((k) => failCounts[k]).map((k) => (
        <button type="button" class="fchip" data-fail={k}>{FAIL_LABELS_EN[k]} <b>{failCounts[k]}</b></button>
      ))}
    </div>
    <div class="fail-table-wrap">
      <table class="fail-table" id="fail-table">
        <thead>
          <tr>
            <th>Plugin</th>
            <th>Class</th>
            <th>Last test</th>
            <th>Note</th>
          </tr>
        </thead>
        <tbody>
          {failRows.map((r) => (
            <tr data-fail={r.failClass}>
              <td><a href={`/plugins/${r.slug}/`}>{r.name}</a> <span class="muted small">{r.cat}</span></td>
              <td><span class="fail-pill">{FAIL_LABELS_EN[r.failClass] || r.failClass}</span></td>
              <td>{r.testDate || '—'}</td>
              <td class="fail-note">{r.note || 'No failure note yet — queued or not yet run.'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Full verification run — August 2026</h2>
    <p>Batch snapshot from the first full three-stage pass over then-pending entries.</p>
    <h3>Results</h3>
    <div class="report-results">
      {report.results.map((r) => (
        <div class={`rstat${r.ok ? ' ok' : ''}`}>
          <b>{r.n}</b>
          <span>{r.label}</span>
        </div>
      ))}
    </div>
    <h3>Why the rest did not pass (batch)</h3>
    {report.causes.map((g) => (
      <div class="cause-group">
        <h4>{g.title} ({g.total})</h4>
        <ul>
          {g.items.map(([n, d]) => (
            <li><strong>{n}</strong> — {d}</li>
          ))}
        </ul>
      </div>
    ))}

    <h2>Our stance on reliability</h2>
    <ul>
      <li><strong>Listing is not endorsement.</strong></li>
      <li><strong>We audit continuously</strong> — intake verify plus regular re-checks.</li>
      <li><strong>Honest and reproducible</strong> — manifests, repository state, and actual test results.</li>
    </ul>

    <p>Found a wrong entry? <a href="mailto:hello@dshbase.com">Tell us</a>, or <a href="https://github.com/ylwl1997/dshbase/issues/new?template=plugin-submission.yml" rel="noopener">open an issue</a>. Browse the <a href={pluginsUrl}>plugin guide</a>.</p>
  </section>
</Base>

<style>
  .audit-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; padding-bottom: 8px; }
  .astat { background: var(--card-bg, #fff); border: 1px solid var(--border, #e5e9f0); border-radius: 14px; padding: 18px 16px; text-align: center; }
  .astat b { display: block; font-size: 30px; font-weight: 800; color: var(--primary, #4D6BFE); letter-spacing: -0.02em; }
  .astat span { font-size: 12.5px; color: var(--ink-2, #5b6472); text-transform: uppercase; letter-spacing: .05em; }
  .as-of { font-size: 13px; color: var(--ink-3, #8a93a3); }
  .info ul { margin: 0 0 8px; padding-left: 0; list-style: none; }
  .info ul li { margin: 10px 0; color: var(--ink-2, #475569); line-height: 1.7; padding-left: 20px; position: relative; }
  .info ul li::before { content: "›"; position: absolute; left: 2px; color: var(--primary, #4D6BFE); font-weight: 700; }
  .info h2 { margin-top: 30px; }
  .report-results { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; margin: 14px 0 6px; }
  .rstat { background: var(--card-bg, #fff); border: 1px solid var(--border, #e5e9f0); border-radius: 14px; padding: 16px 14px; text-align: center; }
  .rstat.ok { border-color: #b6e3c8; background: #f2fbf5; }
  .rstat b { display: block; font-size: 26px; font-weight: 800; color: var(--ink, #1f2733); }
  .rstat.ok b { color: #1a7f4b; }
  .rstat span { font-size: 12px; color: var(--ink-2, #5b6472); text-transform: uppercase; letter-spacing: .04em; }
  .cause-group { margin: 18px 0; }
  .cause-group h4 { margin: 0 0 8px; font-size: 15px; color: var(--ink, #1f2733); }
  .fail-filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 14px; }
  .fchip { font-size: 12.5px; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-card, #fff); color: var(--ink-2); cursor: pointer; font-family: inherit; }
  .fchip b { font-weight: 700; opacity: .6; }
  .fchip:hover { color: var(--primary); border-color: var(--primary); }
  .fchip.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .fchip.is-active b { opacity: .9; }
  .fail-table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 12px; }
  .fail-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .fail-table th, .fail-table td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--border); vertical-align: top; }
  .fail-table th { background: #f8fafc; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--ink-3); }
  .fail-table tr[hidden] { display: none; }
  .fail-note { color: var(--ink-2); max-width: 420px; line-height: 1.45; }
  .fail-pill { display: inline-block; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: #fff7ed; color: #9a3412; border: 1px solid #fed7aa; }
  .muted { color: var(--ink-3); }
  .small { font-size: 12px; }
</style>

<script>
  const chips = document.querySelectorAll('#fail-filters .fchip');
  const rows = document.querySelectorAll('#fail-table tbody tr');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      const f = chip.dataset.fail;
      rows.forEach((row) => { row.hidden = f !== 'all' && row.dataset.fail !== f; });
    });
  });
</script>
