---
import Base from '../../layouts/Base.astro';
import plugins from '../../data/plugins.json';
import syncDate from '../../data/sync-date.json';
const sortByStars = (a, b) => (b.stars ?? 0) - (a.stars ?? 0);
const catOrder = Object.keys(plugins);
// sort each category by stars desc
catOrder.forEach((k) => plugins[k].sort(sortByStars));
const total = catOrder.reduce((s, k) => s + plugins[k].length, 0);
const all = catOrder.flatMap((k) => plugins[k]);
const nVerified = all.filter((p) => p.test === 'verified').length;
const nPending = all.filter((p) => p.test === 'pending').length;
const nNpm = all.filter((p) => p.npm).length;

// category distribution (stacked bar)
const catDist = catOrder.map((cat) => [cat, plugins[cat].length]);

// growth curve: cumulative plugin count by added date
const byDay = {};
all.forEach((p) => { const d = (p.added || '').slice(0, 10); if (d) byDay[d] = (byDay[d] || 0) + 1; });
let _cum = 0;
const growth = Object.keys(byDay).sort().map((d) => { _cum += byDay[d]; return [d.slice(5, 10), _cum]; });
const maxG = growth.length ? growth[growth.length - 1][1] : 1;
const GW = 800, GH = 170;
const gPadL = 24, gPadR = 24, gPadT = 22, gPadB = 32;
const gPlotW = GW - gPadL - gPadR;
const gPlotH = GH - gPadT - gPadB;
const gX = (i) => gPadL + (i / Math.max(growth.length - 1, 1)) * gPlotW;
const gY = (v) => gPadT + (1 - v / maxG) * gPlotH;
const gPts = growth.map(([, v], i) => [gX(i), gY(v)]);
const gLine = gPts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const gArea = `${gPadL},${GH - gPadB} ${gLine} ${GW - gPadR},${GH - gPadB}`;

// big tabs: hot (top stars) + new (recently added)
const hotPlugins = [...all].sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0)).slice(0, 60);
const newPlugins = [...all].sort((a, b) => (b.added || '').localeCompare(a.added || '')).slice(0, 60);

// carousel: our own plugins + top 5 by stars
const ourPlugins = all.filter((p) => (p.url || '').includes('ylwl1997'));
const top5 = [...all].sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0)).slice(0, 5);
const carousel = [...ourPlugins, ...top5].filter((p, i, arr) => arr.findIndex((x) => x.name === p.name) === i);
const installCmd = (p) => p.npm && p.pkg ? `dsh plugin add ${p.pkg}` : `dsh plugin add github:${repo(p.url)}`;

const repo = (u) => u.replace('https://github.com/', '');
const owner = (u) => (u.replace('https://github.com/', '').split('/')[0] || '');
const npmHome = (p) => p.pkg ? `https://www.npmjs.com/package/${p.pkg}` : '';
const isFeatured = (p) => (p.stars ?? 0) >= 100;
const searchMap = {};
catOrder.forEach((k) => plugins[k].forEach((p) => { searchMap[p.name] = `${p.name} ${owner(p.url)} ${p.pkg || ''} ${p.desc_en || p.desc || ''} ${k}`.toLowerCase(); }));
const statusLabel = {
  verified: 'Verified',
  pending: 'Untested',
};
const statusClass = {
  verified: 'st-ok',
  pending: 'st-warn',
};
---
<Base title={`DeepSeek Harness Plugin Directory — ${total} Plugins, Verified Test Results & Install Commands | dshbase`} description={`Browse the DeepSeek Harness (dsh) plugin ecosystem: ${catOrder.length} categories, ${total} plugins, each with npm install status, verified test results, and the exact install command.`} currentPath="/plugins/directory/">
  <section class="hero wrap">
    <p class="eyebrow">Plugin directory</p>
    <h1>DeepSeek Harness <span class="accent">plugin ecosystem</span></h1>
    <p class="lede">Curated from the <a href="https://github.com/awesome-dsh-plugin/awesome-dsh-plugin" target="_blank" rel="noopener">awesome-dsh-plugin</a> list — {catOrder.length} categories, {total} plugins. Every card shows whether the plugin ships on <strong>npm</strong>, its <strong>verified test status</strong>, and the exact install command — no clicking through to check.</p>
    <p style="margin-top:14px"><a class="btn btn-primary" href="https://github.com/ylwl1997/dshbase/issues/new?template=plugin-submission.yml" target="_blank" rel="noopener">Submit your plugin &rarr;</a> <a class="btn btn-ghost" href="https://github.com/deepseek-ai/deepseek-harness/discussions" target="_blank" rel="noopener">Official community &rarr;</a></p>
    <div class="agent-box">
      <div class="agent-slides">
        {carousel.map((p) => (
          <a class="agent-slide" href={`/plugins/${p.name}/`}>
            <strong>⭐ {p.name}</strong> — <code>{installCmd(p)}</code>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="info wrap">
    <p class="stats-line">Tested on dsh 0.1.0-rc.6 — every card shows the verified status and exact install command. GitHub-source plugins install with <code>dsh plugin add github:owner/repo</code>.</p>
    <div class="eco">
      <div class="statline">
        <div class="stat"><b>{total.toLocaleString('en-US')}</b><span>plugins</span></div>
        <div class="stat"><b>{nVerified}</b><span>verified</span></div>
        <div class="stat"><b>{nPending}</b><span>untested</span></div>
        <div class="stat"><b>{nNpm}</b><span>on npm</span></div>
      </div>
      <div class="eco-cards">
        <div class="eco-card">
          <h3 class="eco-title">Growth</h3>
          <svg class="growth-svg" viewBox={`0 0 ${GW} ${GH}`} role="img" aria-label="Plugin catalog growth curve">
            <defs>
              <linearGradient id="gfill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#4D6BFE" stop-opacity="0.16" />
                <stop offset="100%" stop-color="#4D6BFE" stop-opacity="0" />
              </linearGradient>
            </defs>
            <polygon points={gArea} fill="url(#gfill)" />
            <polyline points={gLine} fill="none" stroke="#4D6BFE" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            {gPts.map(([x, y], i) => (
              <g>
                <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="4.5" fill="#fff" stroke="#4D6BFE" stroke-width="2.5">
                  <title>{growth[i][0]} — {growth[i][1]} plugins</title>
                </circle>
                <text class="g-val" x={x.toFixed(1)} y={(y - 11).toFixed(1)} text-anchor="middle">{growth[i][1]}</text>
              </g>
            ))}
            {growth.map(([d], i) => (
              <text class="g-tick" x={gX(i).toFixed(1)} y={GH - gPadB + 18} text-anchor="middle">{d}</text>
            ))}
          </svg>
        </div>
        <div class="eco-card">
          <h3 class="eco-title">Category distribution</h3>
          <div class="cat-bar">
            {catDist.map(([cat, n], i) => {
              const colors = ['#4D6BFE', '#7c8cf8', '#8b5cf6', '#a78bfa', '#6366f1', '#93c5fd', '#c4b5fd'];
              return <div class="cat-seg" style={`width:${(n / total) * 100}%;background:${colors[i % colors.length]}`} title={`${cat}: ${n}`}></div>;
            })}
          </div>
          <div class="cat-legend">
            {catDist.map(([cat, n], i) => {
              const colors = ['#4D6BFE', '#7c8cf8', '#8b5cf6', '#a78bfa', '#6366f1', '#93c5fd', '#c4b5fd'];
              return <span class="cat-item"><span class="cat-dot" style={`background:${colors[i % colors.length]}`}></span>{cat} <b>{n}</b></span>;
            })}
          </div>
        </div>
      </div>
      <p class="eco-note">Data source: GitHub dsh-plugin topic · Updated {syncDate.updated}</p>
    </div>
    <div class="top-plugins">
      <div class="tp-head">🔥 Top plugins by stars</div>
      <div class="tp-grid">
        {[...all].sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0)).slice(0, 10).map((t, i) => (
          <a class="tp-item" href={`/plugins/${t.name}/`}>
            <span class="tp-rank">{i + 1}</span>
            <span class="tp-name">{t.name}</span>
            <span class="tp-stars" data-stars-name={t.name}>★{t.stars ?? 0}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="nav-toolbar">
      <div class="big-tabs" role="tablist" aria-label="Collections">
        <button class="btab is-active" data-tab="all">All</button>
        <button class="btab" data-tab="hot">🔥 Hot</button>
        <button class="btab" data-tab="new">🆕 New</button>
      </div>
      <div class="search-bar">
        <input type="search" id="plugin-search" placeholder="Search plugins by name, package, or description…" autocomplete="off" aria-label="Search plugins" />
        <span class="search-count" id="search-count" hidden></span>
      </div>
      <div class="cat-nav">
        {catOrder.map((cat) => (
          <button class="chip" data-cat={cat.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{cat}</button>
        ))}
      </div>
    </div>
    <div id="cat-sections">
    {catOrder.map((cat) => {
      const catId = cat.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      return (
      <Fragment>
        <h3 id={catId} class="cat-head" style="margin-top:26px">{cat} <span class="muted" style="font-size:13px;font-weight:400">({plugins[cat].length})</span></h3>
        <div class="grid3">
          {plugins[cat].map((p) => {
            const r = repo(p.url);
            return (
              <a class="card pcard" href={`/plugins/${p.name}/`} data-test={p.test} data-npm={p.npm ? '1' : '0'} data-search={searchMap[p.name]}>
                <div class="pcard-head">
                  <span class="pcard-owner">@{owner(p.url)}</span>
                  <span class="pcard-right"><span class="pcard-help" role="button" data-help="install" title="How to install">?</span><span class={`badge ${statusClass[p.test]}`}>{statusLabel[p.test]}</span></span>
                </div>
                <span class="pcard-name">{p.name}{isFeatured(p) ? ' ⭐' : ''}</span>
                {(p.desc_en || p.desc) && <p class="pcard-desc">{p.desc_en || p.desc}</p>}
                <div class="pcard-foot">
                  <span class="pcard-stars">★ {p.stars ?? 0}</span>
                  <span class="pcard-src">{p.npm ? 'npm' : 'GitHub'}</span>
                  <span class="pcard-copy" role="button" data-cmd={installCmd(p)}>📋 安装</span>
                </div>
              </a>
            );
          })}
        </div>
      </Fragment>
      );
    })}
    </div>
    <div id="hot-panel" hidden>
      <h3 class="cat-head" style="margin-top:26px">🔥 Hot plugins <span class="muted" style="font-size:13px;font-weight:400">(top {hotPlugins.length} by stars)</span></h3>
      <div class="grid3">
        {hotPlugins.map((p) => {
          const r = repo(p.url);
          return (
            <a class="card pcard" href={`/plugins/${p.name}/`} data-test={p.test} data-npm={p.npm ? '1' : '0'} data-search={searchMap[p.name]}>
              <div class="pcard-head">
                <span class="pcard-owner">@{owner(p.url)}</span>
                <span class="pcard-right"><span class="pcard-help" role="button" data-help="install" title="How to install">?</span><span class={`badge ${statusClass[p.test]}`}>{statusLabel[p.test]}</span></span>
              </div>
              <span class="pcard-name">{p.name}{isFeatured(p) ? ' ⭐' : ''}</span>
              {(p.desc_en || p.desc) && <p class="pcard-desc">{p.desc_en || p.desc}</p>}
              <div class="pcard-foot">
                <span class="pcard-stars">★ {p.stars ?? 0}</span>
                <span class="pcard-src">{p.npm ? 'npm' : 'GitHub'}</span>
                <span class="pcard-copy" role="button" data-cmd={installCmd(p)}>📋 安装</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
    <div id="new-panel" hidden>
      <h3 class="cat-head" style="margin-top:26px">🆕 Newly added <span class="muted" style="font-size:13px;font-weight:400">(recent {newPlugins.length})</span></h3>
      <div class="grid3">
        {newPlugins.map((p) => {
          const r = repo(p.url);
          return (
            <a class="card pcard" href={`/plugins/${p.name}/`} data-test={p.test} data-npm={p.npm ? '1' : '0'} data-search={searchMap[p.name]}>
              <div class="pcard-head">
                <span class="pcard-owner">@{owner(p.url)}</span>
                <span class="pcard-right"><span class="pcard-help" role="button" data-help="install" title="How to install">?</span><span class={`badge ${statusClass[p.test]}`}>{statusLabel[p.test]}</span></span>
              </div>
              <span class="pcard-name">{p.name}{isFeatured(p) ? ' ⭐' : ''}</span>
              {(p.desc_en || p.desc) && <p class="pcard-desc">{p.desc_en || p.desc}</p>}
              <div class="pcard-foot">
                <span class="pcard-stars">★ {p.stars ?? 0}</span>
                <span class="pcard-src">{p.npm ? 'npm' : 'GitHub'}</span>
                <span class="pcard-copy" role="button" data-cmd={installCmd(p)}>📋 安装</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <div class="help-modal" id="help-modal" hidden>
    <div class="help-modal-inner">
      <button class="help-close" type="button" aria-label="Close">&times;</button>
      <b>如何安装这个插件？</b>
      <p>两种方式：</p>
      <ol>
        <li><strong>让 Agent 自动装（推荐）</strong>：先 <code>dsh plugin add dshbase-catalog</code>，然后对 agent 说需求，它会自动安装。</li>
        <li><strong>手动</strong>：点卡片上的「📋 安装」复制命令，粘贴到终端。</li>
      </ol>
      <p><a href="/plugins/" class="btn btn-ghost btn-sm">查看完整教程 &rarr;</a></p>
    </div>
  </div>
</Base>

<style>
  .hero { padding-bottom: 16px; }
  .info { padding-top: 16px; }
  .pcard { display: flex; flex-direction: column; gap: 8px; text-decoration: none; color: inherit; }
  .pcard:hover { border-color: var(--primary); transform: translateY(-2px); box-shadow: var(--shadow-md, 0 8px 24px rgba(0,0,0,.08)); }
  .pcard-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .pcard-right { display: flex; align-items: center; gap: 6px; }
  .pcard-help { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border-radius: 50%; border: 1px solid var(--border-strong); color: var(--ink-3); font-size: 11px; font-weight: 700; cursor: pointer; line-height: 1; }
  .pcard-help:hover { color: var(--primary); border-color: var(--primary); }
  .pcard-owner { font-size: 11.5px; color: var(--ink-3); font-family: var(--mono, monospace); }
  .pcard-name { font-weight: 700; font-size: 15px; color: var(--ink); }
  .pcard-desc { font-size: 13px; color: var(--ink-2); margin: 0; line-height: 1.55; flex: 1; }
  .pcard-foot { display: flex; align-items: center; gap: 10px; margin-top: auto; }
  .pcard-stars { font-size: 12px; color: #b45309; font-weight: 600; }
  .pcard-src { font-size: 11.5px; color: var(--ink-3); }
  .pcard-copy { margin-left: auto; font-size: 12px; color: var(--primary); cursor: pointer; white-space: nowrap; }
  .pcard-copy:hover { text-decoration: underline; }
  .nav-toolbar { position: sticky; top: 0; z-index: 30; background: var(--bg); padding: 12px 0 8px; margin: 18px 0 0; border-bottom: 1px solid var(--border); }
  .big-tabs { display: flex; gap: 10px; justify-content: center; margin-bottom: 12px; }
  .btab { font-size: 14px; font-weight: 600; padding: 8px 22px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-card); color: var(--ink-2); cursor: pointer; }
  .btab.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .cat-nav { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 0 0 8px; }
  .search-bar { display: flex; align-items: center; gap: 10px; max-width: 460px; margin: 0 auto 12px; }
  #plugin-search { flex: 1; font-size: 14px; padding: 9px 14px; border: 1px solid var(--border-strong); border-radius: 999px; background: var(--bg-card); color: var(--ink); font-family: inherit; outline: none; }
  #plugin-search:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(77,107,254,.12); }
  .search-count { font-size: 12px; color: var(--ink-3); white-space: nowrap; }
  .chip { font-size: 11.5px; color: var(--ink-2); border: 1px solid var(--border); border-radius: 999px; padding: 4px 10px; background: var(--bg-card); cursor: pointer; font-family: inherit; }
  .chip:hover { color: var(--primary); border-color: var(--primary); }
  .chip.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .filter-bar { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 0; }
  .fbtn { font-size: 12px; padding: 5px 12px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-card); color: var(--ink-2); cursor: pointer; }
  .fbtn.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .fcount { opacity: .7; font-size: 12px; }
  .pcard[hidden] { display: none; }
  .cat-head[hidden] { display: none; }
  .grid3[hidden] { display: none; }
  .help-modal { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: rgba(15, 23, 42, 0.4); padding: 20px; }
  .help-modal[hidden] { display: none; }
  .help-modal-inner { position: relative; background: #fff; border-radius: 14px; padding: 24px; max-width: 420px; width: 100%; box-shadow: 0 20px 50px rgba(0,0,0,.2); }
  .help-modal-inner b { font-size: 15px; color: var(--ink); }
  .help-modal-inner p, .help-modal-inner li { font-size: 13.5px; color: var(--ink-2); line-height: 1.6; }
  .help-modal-inner ol { margin: 8px 0 12px; padding-left: 20px; }
  .help-close { position: absolute; top: 12px; right: 14px; border: none; background: none; font-size: 22px; color: var(--ink-3); cursor: pointer; line-height: 1; }
  .top-plugins { margin: 22px 0 6px; }
  .tp-head { font-size: 14px; font-weight: 700; color: var(--ink); margin-bottom: 10px; }
  .tp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; }
  .tp-item { display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; text-decoration: none; color: inherit; font-size: 13px; }
  .tp-item:hover { border-color: var(--primary); }
  .tp-rank { font-weight: 800; color: var(--primary); font-size: 12px; min-width: 14px; }
  .tp-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tp-stars { color: #b45309; font-weight: 600; }
  .install-chip { margin: 0; font-size: 12px; padding: 6px 10px; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 6px; color: #334155; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .badge { font-size: 11px; padding: 3px 9px; white-space: nowrap; }
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; }
  .st-ok { color: #1a7f37; border-color: #b7e0c0; background: #f0fff4; }
  .st-ok .dot { background: #1a7f37; }
  .st-src { color: var(--ink-2); background: #f7f8fa; }
  .st-src .dot { background: #9aa1ad; }
  .st-warn { color: #9a6700; border-color: #e5c27a; background: #fff8e6; }
  .st-warn .dot { background: #d4a72c; }
  .legend .badge { color: var(--ink-2); }
  .stats-line { font-size: 13px; color: var(--ink-2); margin: 10px 0 0; text-align: center; }
  .agent-box { font-size: 13.5px; color: var(--ink-2); background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 8px 14px; margin: 10px 0 0; overflow: hidden; }
  .agent-slides { position: relative; }
  .agent-slide { display: none; text-decoration: none; color: inherit; cursor: pointer; }
  .agent-slide.is-active { display: block; animation: fadeIn .4s; }
  .agent-slide:hover strong { text-decoration: underline; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .c-ok { color: #1a7f37; }
  .c-warn { color: #9a6700; }
  .eco { margin: 20px 0 8px; }
  .statline { display: flex; flex-wrap: wrap; gap: 8px 36px; justify-content: center; padding: 16px 0; border-bottom: 1px solid var(--border); }
  .stat { display: flex; flex-direction: column; align-items: center; line-height: 1.25; }
  .stat b { font-size: 20px; font-weight: 800; color: var(--primary); }
  .stat span { font-size: 12px; color: var(--ink-3); }
  .eco-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
  .eco-card { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; }
  .eco-title { font-size: 13px; font-weight: 700; color: var(--ink-2); margin: 0 0 14px; }
  .growth-svg { width: 100%; display: block; }
  .g-val { font-size: 11px; font-weight: 700; fill: var(--ink); }
  .g-tick { font-size: 11px; fill: var(--ink-3); }
  .cat-bar { display: flex; height: 22px; border-radius: 6px; overflow: hidden; gap: 2px; background: #eef1f6; }
  .cat-seg { height: 100%; min-width: 3px; }
  .cat-legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 14px; }
  .cat-item { font-size: 12px; color: var(--ink-2); display: inline-flex; align-items: center; gap: 5px; }
  .cat-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .cat-item b { color: var(--ink); font-weight: 700; }
  .eco-note { text-align: center; font-size: 12px; color: var(--ink-3); margin: 14px 0 0; }
  @media (max-width: 640px) { .eco-cards { grid-template-columns: 1fr; } }
</style>

<script>
  // Carousel for the agent-box recommendations
  (() => {
    const slides = document.querySelectorAll('.agent-slide');
    if (slides.length < 2) return;
    let i = 0;
    slides[0].classList.add('is-active');
    setInterval(() => {
      slides[i].classList.remove('is-active');
      i = (i + 1) % slides.length;
      slides[i].classList.add('is-active');
    }, 3500);
  })();

  // 一键复制安装命令
  document.querySelectorAll('.pcard-copy').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      navigator.clipboard.writeText(btn.dataset.cmd).then(() => {
        const orig = btn.textContent;
        btn.textContent = '✅ 已复制';
        setTimeout(() => { btn.textContent = orig; }, 1500);
      });
    });
  });

  // 卡片「?」帮助弹窗
  const modal = document.getElementById('help-modal');
  if (modal) {
    document.querySelectorAll('.pcard-help').forEach((help) => {
      help.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        modal.hidden = false;
      });
    });
    modal.querySelector('.help-close').addEventListener('click', () => { modal.hidden = true; });
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.hidden = true; });
  }

  const tabs = document.querySelectorAll('.btab');
  const chips = document.querySelectorAll('.chip');
  const catHeads = document.querySelectorAll('#cat-sections .cat-head');
  const catSections = document.getElementById('cat-sections');
  const hotPanel = document.getElementById('hot-panel');
  const newPanel = document.getElementById('new-panel');
  const searchInput = document.getElementById('plugin-search');
  const searchCount = document.getElementById('search-count');
  const allCards = [...document.querySelectorAll('.pcard')];

  let activeTab = 'all';
  let activeCat = null;

  function applyFilters() {
    catSections.hidden = activeTab !== 'all';
    hotPanel.hidden = activeTab !== 'hot';
    newPanel.hidden = activeTab !== 'new';

    const q = (searchInput?.value || '').trim().toLowerCase();
    let visibleCount = 0;
    allCards.forEach((card) => {
      const match = !q || (card.dataset.search || '').includes(q);
      card.hidden = !match;
      if (match) visibleCount++;
    });

    catHeads.forEach((h) => {
      const grid = h.nextElementSibling;
      const show = !activeCat || h.id === activeCat;
      const hasVisible = grid ? [...grid.querySelectorAll('.pcard')].some((c) => !c.hidden) : false;
      h.hidden = !(show && hasVisible);
      if (grid) grid.hidden = h.hidden;
    });

    [hotPanel, newPanel].forEach((panel) => {
      if (!panel || panel.hidden) return;
      const grid = panel.querySelector('.grid3');
      const head = panel.querySelector('.cat-head');
      const hasVisible = grid ? [...grid.querySelectorAll('.pcard')].some((c) => !c.hidden) : false;
      if (head) head.hidden = !hasVisible;
      if (grid) grid.hidden = !hasVisible;
    });

    if (searchCount) {
      searchCount.hidden = !q;
      searchCount.textContent = `${visibleCount} result${visibleCount === 1 ? '' : 's'}`;
    }
  }

  searchInput?.addEventListener('input', applyFilters);

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('is-active'));
      tab.classList.add('is-active');
      activeTab = tab.dataset.tab;
      applyFilters();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      // 点分类 chip 时自动切回「全部」tab，否则在热门/新收录下分类筛选无意义
      if (activeTab !== 'all') {
        activeTab = 'all';
        tabs.forEach((t) => t.classList.toggle('is-active', t.dataset.tab === 'all'));
      }
      const catId = chip.dataset.cat;
      if (activeCat === catId) {
        activeCat = null;
        chips.forEach((c) => c.classList.remove('is-active'));
      } else {
        activeCat = catId;
        chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      }
      applyFilters();
    });
  });

  // 实时按星数重排「热门 Top 10」：等 /api/stats 星数更新后，按实时 stars 重新排序
  setTimeout(() => {
    const grid = document.querySelector('.tp-grid');
    const stats = window.__dshStats;
    if (!grid || !stats) return;
    const items = [...grid.querySelectorAll('.tp-item')];
    items.sort((a, b) => {
      const na = a.querySelector('.tp-stars')?.getAttribute('data-stars-name');
      const nb = b.querySelector('.tp-stars')?.getAttribute('data-stars-name');
      return (stats[nb]?.stars ?? 0) - (stats[na]?.stars ?? 0);
    });
    items.forEach((it, i) => {
      const rank = it.querySelector('.tp-rank');
      if (rank) rank.textContent = i + 1;
      grid.appendChild(it);
    });
  }, 1600);
</script>
