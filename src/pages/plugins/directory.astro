---
import Base from '../../layouts/Base.astro';
import plugins from '../../data/plugins.json';
const sortByStars = (a, b) => (b.stars ?? 0) - (a.stars ?? 0);
const catOrder = Object.keys(plugins);
// sort each category by stars desc
catOrder.forEach((k) => plugins[k].sort(sortByStars));
const total = catOrder.reduce((s, k) => s + plugins[k].length, 0);
const all = catOrder.flatMap((k) => plugins[k]);
const nOk = all.filter((p) => p.test === 'ok' || p.test === 'git-ok').length;
const nUi = all.filter((p) => p.test === 'ui' || p.test === 'git-ui').length;
const nBuild = all.filter((p) => p.test === 'git-build').length;
const nFail = all.filter((p) => p.test === 'install-fail' || p.test === 'load-fail' || p.test === 'git-fail').length;
const nSource = all.filter((p) => p.test === 'not-on-npm').length;
const nNpm = all.filter((p) => p.npm).length;
const repo = (u) => u.replace('https://github.com/', '');
const npmHome = (p) => p.pkg ? `https://www.npmjs.com/package/${p.pkg}` : '';
const featured = new Set(['huiliyi37/dsh-tianshu-tui', 'omdsh-dev/dsh-at-file', 'omdsh-dev/dsh-genui', 'titanwings/dsh-automation', 'omdsh-dev/DSH-better-sidebar', 'liustack/modlens', 'zhu1090093659/dsh-web-ui', 'Anionex/dsh-computer-use', 'omdsh-dev/dsh-tool-csv', 'ccch1mneyyy/dsh-cc-tui']);
const statusLabel = {
  ok: 'Verified · npm',
  'git-ok': 'GitHub · verified',
  'git-build': 'GitHub · needs build',
  'git-ui': 'GitHub · UI',
  'git-fail': 'Install failed',
  ui: 'npm · needs UI',
  'load-fail': 'Load issue',
  'install-fail': 'Install failed',
  'not-on-npm': 'GitHub source',
};
const statusClass = {
  ok: 'st-ok',
  'git-ok': 'st-ok',
  'git-build': 'st-warn',
  'git-ui': 'st-warn',
  'git-fail': 'st-warn',
  ui: 'st-warn',
  'load-fail': 'st-warn',
  'install-fail': 'st-warn',
  'not-on-npm': 'st-src',
};
---
<Base title={`DeepSeek Harness Plugin Directory — ${total} Plugins, Verified Test Results & Install Commands | dshbase`} description={`Browse the DeepSeek Harness (dsh) plugin ecosystem: ${catOrder.length} categories, ${total} plugins, each with npm install status, verified test results, and the exact install command.`} currentPath="/plugins/directory/">
  <section class="hero wrap">
    <p class="eyebrow">Plugin directory</p>
    <h1>DeepSeek Harness <span class="accent">plugin ecosystem</span></h1>
    <p class="lede">Curated from the <a href="https://github.com/awesome-dsh-plugin/awesome-dsh-plugin" target="_blank" rel="noopener">awesome-dsh-plugin</a> list — {catOrder.length} categories, {total} plugins. Every card shows whether the plugin ships on <strong>npm</strong>, its <strong>verified test status</strong>, and the exact install command — no clicking through to check.</p>
    <p style="margin-top:14px"><a class="btn btn-primary" href="https://github.com/ylwl1997/dshbase/issues/new?template=plugin-submission.yml" target="_blank" rel="noopener">Submit your plugin &rarr;</a> <a class="btn btn-ghost" href="https://github.com/deepseek-ai/deepseek-harness/discussions" target="_blank" rel="noopener">Official community &rarr;</a> <a class="btn btn-ghost" href="https://github.com/whyihaveyou/dsh-suite" target="_blank" rel="noopener">dsh-suite (785+ plugins) &rarr;</a></p>
    <div class="agent-box">
      <div class="agent-slides">
        <a class="agent-slide" href="/plugins/dshbase-catalog/"><strong>🤖 dshbase-catalog</strong> — let your agent search this directory itself: <code>dsh plugin add dshbase-catalog</code></a>
        <a class="agent-slide" href="/plugins/dsh-browser-bsk/"><strong>🌐 dsh-browser-bsk</strong> — browser automation for your agent: <code>dsh plugin add dsh-browser-bsk</code></a>
        <a class="agent-slide" href="/plugins/noatmark-dsh-plugin/"><strong>🧹 noatmark-dsh-plugin</strong> — text hygiene tools: <code>dsh plugin add noatmark-dsh-plugin</code></a>
        <a class="agent-slide" href="/plugins/modlens/"><strong>⭐ modlens</strong> — the most-starred vision plugin: <code>dsh plugin add modlens</code></a>
        <a class="agent-slide" href="/plugins/dsh-cc-tui/"><strong>⭐ dsh-cc-tui</strong> — terminal UI: <code>dsh plugin add github:ccch1mneyyy/dsh-cc-tui</code></a>
      </div>
    </div>
  </section>
  <section class="info wrap">
    <p class="stats-line">Tested on dsh 0.1.0-rc.6 — every card shows the verified status and exact install command. GitHub-source plugins install with <code>dsh plugin add github:owner/repo</code>.</p>
    <div class="top-plugins">
      <div class="tp-head">🔥 Top plugins by stars</div>
      <div class="tp-grid">
        {[...all].sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0)).slice(0, 10).map((t, i) => (
          <a class="tp-item" href={`/plugins/${t.name}/`}>
            <span class="tp-rank">{i + 1}</span>
            <span class="tp-name">{t.name}</span>
            <span class="tp-stars" data-stars-name={t.name}>★0</span>
          </a>
        ))}
      </div>
    </div>
    <div class="cat-nav">
      {catOrder.map((cat) => (
        <a class="chip" href={`#${cat.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{cat}</a>
      ))}
    </div>
    <div class="filter-bar" role="group" aria-label="Filter plugins">
      <button class="fbtn is-active" data-filter="all">All <span class="fcount">{total}</span></button>
      <button class="fbtn" data-filter="verified">Verified <span class="fcount">{catOrder.reduce((s,k)=>s+plugins[k].filter(p=>p.test==='ok'||p.test==='git-ok').length,0)}</span></button>
      <button class="fbtn" data-filter="npm">npm <span class="fcount">{catOrder.reduce((s,k)=>s+plugins[k].filter(p=>p.npm).length,0)}</span></button>
      <button class="fbtn" data-filter="source">Source <span class="fcount">{catOrder.reduce((s,k)=>s+plugins[k].filter(p=>!p.npm).length,0)}</span></button>
      <button class="fbtn" data-filter="issue">Issue <span class="fcount">{catOrder.reduce((s,k)=>s+plugins[k].filter(p=>['ui','load-fail','install-fail','git-fail','git-build'].includes(p.test)).length,0)}</span></button>
    </div>
    {catOrder.map((cat) => {
      const catId = cat.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      return (
      <Fragment>
        <h3 id={catId} class="cat-head" style="margin-top:26px">{cat} <span class="muted" style="font-size:13px;font-weight:400">({plugins[cat].length})</span></h3>
        <div class="grid3">
          {plugins[cat].map((p) => {
            const r = repo(p.url);
            return (
              <a class="card pcard" href={`/plugins/${p.name}/`} data-test={p.test} data-npm={p.npm ? '1' : '0'}>
                <div class="pcard-head">
                  <span class="pcard-name">{p.name}{featured.has(r) ? ' ⭐' : ''}</span>
                  <span class={`badge ${statusClass[p.test]}`}>{statusLabel[p.test]}</span>
                </div>
                <p class="pcard-repo">{r}</p>
                {(p.desc_en || p.desc) && <p class="pcard-desc">{p.desc_en || p.desc}</p>}
                <div class="pcard-install">
                  {p.npm && p.pkg ? (
                    <pre class="code-block install-chip"><code>dsh plugin add {p.pkg}</code></pre>
                  ) : (
                    <span class="muted small">GitHub source</span>
                  )}
                  <span class="view-link">View details &rarr;</span>
                </div>
              </a>
            );
          })}
        </div>
      </Fragment>
      );
    })}
  </section>
</Base>

<style>
  .pcard { display: flex; flex-direction: column; gap: 8px; text-decoration: none; color: inherit; }
  .pcard:hover { border-color: var(--primary); transform: translateY(-2px); box-shadow: var(--shadow-md, 0 8px 24px rgba(0,0,0,.08)); }
  .pcard-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
  .pcard-name { font-weight: 700; font-size: 15px; color: var(--ink); }
  .pcard-repo { font-size: 12px; color: var(--ink-3); font-family: var(--mono, monospace); }
  .pcard-desc { font-size: 13px; color: var(--ink-2); margin: 0; line-height: 1.55; }
  .pcard-install { margin-top: auto; display: flex; flex-direction: column; gap: 6px; }
  .view-link { font-size: 13px; font-weight: 600; color: var(--primary); }
  .pcard:hover .view-link { text-decoration: underline; }
  .cat-nav { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 18px 0 4px; }
  .chip { font-size: 12.5px; color: var(--ink-2); border: 1px solid var(--border); border-radius: 999px; padding: 5px 13px; text-decoration: none; background: #fff; }
  .chip:hover { color: var(--primary); border-color: var(--primary); }
  .filter-bar { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 4px 0 20px; }
  .fbtn { font-size: 13px; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: #fff; color: var(--ink-2); cursor: pointer; }
  .fbtn.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .fcount { opacity: .7; font-size: 12px; }
  .pcard[hidden] { display: none; }
  .cat-head[hidden] { display: none; }
  .top-plugins { margin: 22px 0 6px; }
  .tp-head { font-size: 14px; font-weight: 700; color: var(--ink); margin-bottom: 10px; }
  .tp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; }
  .tp-item { display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; text-decoration: none; color: inherit; font-size: 13px; }
  .tp-item:hover { border-color: var(--primary); }
  .tp-rank { font-weight: 800; color: var(--primary); font-size: 12px; min-width: 14px; }
  .tp-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tp-stars { color: #b45309; font-weight: 600; }
  .install-chip { margin: 0; font-size: 12px; padding: 6px 10px; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 6px; color: #334155; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .badge { font-size: 11px; padding: 3px 9px; white-space: nowrap; }
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; }
  .st-ok { color: #1a7f37; border-color: #b7e0c0; background: #f0fff4; }
  .st-ok .dot { background: #1a7f37; }
  .st-src { color: var(--ink-2); background: #f7f8fa; }
  .st-src .dot { background: #9aa1ad; }
  .st-warn { color: #9a6700; border-color: #e5c27a; background: #fff8e6; }
  .st-warn .dot { background: #d4a72c; }
  .legend .badge { color: var(--ink-2); }
  .stats-line { font-size: 14px; color: var(--ink-2); margin: 18px 0 0; text-align: center; }
  .agent-box { font-size: 13.5px; color: var(--ink-2); background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 12px 16px; margin: 14px 0 0; overflow: hidden; }
  .agent-slides { position: relative; }
  .agent-slide { display: none; text-decoration: none; color: inherit; cursor: pointer; }
  .agent-slide.is-active { display: block; animation: fadeIn .4s; }
  .agent-slide:hover strong { text-decoration: underline; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .c-ok { color: #1a7f37; }
  .c-warn { color: #9a6700; }
</style>

<script>
  // Carousel for the agent-box recommendations
  (() => {
    const slides = document.querySelectorAll('.agent-slide');
    if (slides.length < 2) return;
    let i = 0;
    slides[0].classList.add('is-active');
    setInterval(() => {
      slides[i].classList.remove('is-active');
      i = (i + 1) % slides.length;
      slides[i].classList.add('is-active');
    }, 3500);
  })();

  const buttons = document.querySelectorAll('.fbtn');
  const cards = document.querySelectorAll('.pcard');
  const heads = document.querySelectorAll('.cat-head');
  const match = (card, f) => {
    const t = card.dataset.test;
    const isNpm = card.dataset.npm === '1';
    if (f === 'all') return true;
    if (f === 'verified') return t === 'ok' || t === 'git-ok';
    if (f === 'npm') return isNpm;
    if (f === 'source') return !isNpm;
    if (f === 'issue') return ['ui', 'load-fail', 'install-fail', 'git-fail', 'git-build'].includes(t);
    return true;
  };
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const f = btn.dataset.filter;
      cards.forEach((c) => { c.hidden = !match(c, f); });
      heads.forEach((h) => {
        let sib = h.nextElementSibling;
        while (sib && !sib.classList.contains('cat-head')) {
          if (sib.classList.contains('pcard') && !sib.hidden) { h.hidden = false; return; }
          sib = sib.nextElementSibling;
        }
        h.hidden = true;
      });
    });
  });
</script>
