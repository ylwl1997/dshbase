---
import Base from '../../layouts/Base.astro';
import plugins from '../../data/plugins.json';
const catOrder = Object.keys(plugins);
const total = catOrder.reduce((s, k) => s + plugins[k].length, 0);
const repo = (u) => u.replace('https://github.com/', '');
const featured = new Set(['huiliyi37/dsh-tianshu-tui', 'omdsh-dev/dsh-at-file', 'omdsh-dev/dsh-genui', 'titanwings/dsh-automation', 'omdsh-dev/DSH-better-sidebar', 'liustack/modlens', 'zhu1090093659/dsh-web-ui', 'Anionex/dsh-computer-use', 'omdsh-dev/dsh-tool-csv', 'ccch1mneyyy/dsh-cc-tui']);
---
<Base title={`DeepSeek Harness Plugin Directory — ${total} Plugins in ${catOrder.length} Categories | dshbase`} description={`Browse the DeepSeek Harness (dsh) plugin ecosystem: ${catOrder.length} categories, ${total} plugins, curated from the awesome-dsh-plugin list.`} currentPath="/plugins/directory/">
  <section class="hero wrap">
    <p class="eyebrow">Plugin directory</p>
    <h1>DeepSeek Harness <span class="accent">plugin ecosystem</span></h1>
    <p class="lede">Curated from the <a href="https://github.com/awesome-dsh-plugin/awesome-dsh-plugin" target="_blank" rel="noopener">awesome-dsh-plugin</a> list — {catOrder.length} categories, {total} plugins. Tag your repo with <a href="https://github.com/topics/dsh-plugin" target="_blank" rel="noopener">dsh-plugin</a> to be listed. ⭐ = featured.</p>
  </section>
  <section class="info wrap">
    {catOrder.map((cat) => (
      <Fragment>
        <h3 style="margin-top:26px">{cat} <span class="muted" style="font-size:13px;font-weight:400">({plugins[cat].length})</span></h3>
        <div class="grid3">
          {plugins[cat].map(([name, url]) => (
            <a class="card card-link" href={url} target="_blank" rel="noopener">
              <h3>{name}{featured.has(repo(url)) ? ' ⭐' : ''}</h3>
              <p>{repo(url)}</p>
            </a>
          ))}
        </div>
      </Fragment>
    ))}
  </section>
</Base>
