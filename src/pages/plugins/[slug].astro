---
import Base from '../../layouts/Base.astro';
import plugins from '../../data/plugins.json';
import notes from '../../data/plugin-notes.json';
import security from '../../data/security.json';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { readFileSync, existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

// read build manifest (name -> built tgz file)
let buildsMap: Record<string, string> = {};
try {
  if (existsSync('public/builds/manifest.json')) {
    const manifest = JSON.parse(readFileSync('public/builds/manifest.json', 'utf-8'));
    for (const b of manifest) {
      if (b.status === 'OK') buildsMap[b.name] = b.file;
    }
  }
} catch {}

export function getStaticPaths() {
  return Object.entries(plugins).flatMap(([cat, items]) =>
    items.map((p) => ({ params: { slug: p.slug ?? p.name }, props: { cat, p } }))
  );
}

const { cat, p } = Astro.props;
const note = notes[p.name];
const catId = cat.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const dirUrl = getRelativeLocaleUrl('en', '/plugins/directory/');
const catUrl = `${dirUrl}#${catId}`;
const repo = p.url.replace('https://github.com/', '');
const npmHome = p.pkg ? `https://www.npmjs.com/package/${p.pkg}` : '';
const statusLabel = {
  verified: 'Verified · install-tested on dsh',
  pending: 'Unverified',
};
const statusClass = {
  verified: 'st-ok',
  pending: 'st-warn',
};
const platform = p.platform || 'any';
const platformLabel = { win32: 'Windows', macos: 'macOS', linux: 'Linux', any: 'Cross-platform' }[platform] || platform;
const sec = security[p.name];
const riskLabel = { low: 'Low', medium: 'Medium', high: 'High', critical: 'Critical' };
const riskClass = { low: 'sec-low', medium: 'sec-med', high: 'sec-high', critical: 'sec-crit' };
const catLabel = { secrets: 'Hardcoded secret', 'dangerous-cmd': 'Dangerous command', exfil: 'Exfiltration endpoint', permissions: 'Suspicious permission' };
const badgeAlt = p.test === 'verified' ? 'dshbase install-tested' : 'dshbase listed';
const badgeMd = `[![${badgeAlt}](https://dshbase.com/badges/${p.slug}.svg)](https://dshbase.com/plugins/${p.slug}/)`;
const verifyUrl = `https://github.com/ylwl1997/dshbase/issues/new?template=verification-evidence.yml&name=${encodeURIComponent(p.name)}&repo=${encodeURIComponent(p.url)}`;
const desc = p.desc_en || p.desc || `A plugin in the ${cat} category for DeepSeek Harness.`;
// 短功能卖点：取 desc_en 前 ~48 字符（用于 title，避免被 Google 截断且更有吸引力）
const shortSell = (p.desc_en || desc).split(/[.，。!?；]/)[0].trim().slice(0, 48);
const fmt = (n) => (n >= 1000 ? (n / 1000).toFixed(1) + 'k' : String(n ?? 0));
const stars = p.stars ?? 0;
const verdict = p.archived
  ? { label: 'Archived — no longer maintained, use with caution', cls: 'v-warn', icon: '⚠️' }
  : p.test === 'verified'
    ? stars >= 100
      ? { label: 'Recommended — verified working and popular', cls: 'v-ok', icon: '✅' }
      : stars >= 20
        ? { label: 'Works — verified, growing community', cls: 'v-ok', icon: '✅' }
        : { label: 'Works — verified, early-stage project', cls: 'v-ok', icon: '✅' }
    : { label: 'Unverified — not yet verified', cls: 'v-warn', icon: '⏳' };
const review = p.archived
  ? `This plugin has been archived and is no longer maintained — use it only if you're willing to maintain it yourself.`
  : p.test === 'verified'
    ? `${desc} It installs cleanly and boots without issues in our testing. ${stars >= 100 ? `With ${stars}+ stars it's a community-endorsed, low-risk pick.` : stars >= 20 ? `It has a growing community — a solid choice.` : `It's early-stage but functional.`}`
    : p.needs
      ? `${desc} Not yet verified — it needs an external account or service our sandbox can't provide, so we couldn't run a full install test. It may work fine in your own environment.`
      : `${desc} Not yet verified — install and test it yourself.`;
const related = (plugins[cat] || []).filter((x) => x.slug !== p.slug).slice(0, 6);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.name,
  description: desc,
  url: `https://dshbase.com/plugins/${p.slug}/`,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  ...(p.ver ? { softwareVersion: p.ver } : {}),
};
---
<Base title={`${p.name}: ${shortSell} | dshbase`} description={`${desc} — how to install ${p.name} (${p.npm ? `dsh plugin add ${p.pkg}` : 'npm source'}) and compatibility with dsh 0.1.0-rc.6.`} currentPath={`/plugins/${p.slug}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="hero wrap">
    <p class="eyebrow"><a href={dirUrl}>Plugin directory</a> / <a href={catUrl}>{cat}</a> / {p.name}</p>
    <h1>{p.name}</h1>
    <p class="lede">
      <span class={`badge ${statusClass[p.test]}`}>{statusLabel[p.test]}</span>{' '}
      <a href={p.url} target="_blank" rel="noopener">{repo} ↗</a>
    </p>
    <p style="margin-top:14px"><a class="btn btn-ghost btn-sm" href={dirUrl}>&larr; Back to plugin directory</a></p>
  </section>

  <section class="wrap">
    <div class="metrics">
      <div class="metric"><span class="m-val" data-stars-slug={p.slug} data-stats-kind="stars">{p.stars ?? 0}</span><span class="m-lab">Stars</span></div>
      <div class="metric"><span class="m-val" data-stars-slug={p.slug} data-stats-kind="forks">{p.forks ?? 0}</span><span class="m-lab">Forks</span></div>
      <div class="metric"><span class="m-val" data-stars-slug={p.slug} data-stats-kind="issues">{p.issues ?? 0}</span><span class="m-lab">Open issues</span></div>
      <div class="metric"><span class="m-val">{p.language || '—'}</span><span class="m-lab">Language</span></div>
      <div class="metric"><span class="m-val">{p.updated || '—'}</span><span class="m-lab">Last push</span></div>
      <div class="metric"><span class="m-val">{platformLabel}</span><span class="m-lab">Platform</span></div>
    </div>
  </section>

  <section class="info wrap">
    <h2>What it does</h2>
    <p class="what-it-does">{desc}</p>

    <div class={`verdict ${verdict.cls}`}>
      <span class="v-icon">{verdict.icon}</span>
      <div><strong>Our take</strong><br/>{verdict.label}</div>
    </div>
    <p class="review-text">{review}</p>

    <p class="honest-note">“{p.test === 'verified' ? 'Verified' : 'Unverified'}” means our automated CI{' '}
      {p.test === 'verified' ? (
        <Fragment>actually ran <code>dsh plugin add</code> in a clean profile and it booted — nothing more</Fragment>
      ) : (
        'has not yet installed this plugin'
      )}. {platform !== 'any' && p.test === 'verified' ? `Our CI runs on Linux, so it confirms install + boot but not this plugin's ${platformLabel}-specific behavior. ` : ''}Feature descriptions and version compatibility are the author’s claims. This is not a security audit and not an endorsement of third-party code.</p>

    <div class="sec-box">
      {sec ? (
        <Fragment>
          <span class={`sec-badge ${riskClass[sec.risk]}`}>{sec.risk === 'low' ? '✓ ' : '⚠ '}{riskLabel[sec.risk]} risk</span>{' '}
          <span class="sec-meta">static scan · {sec.files} files · {sec.scannedAt?.slice(0, 10)}</span>
          {sec.findings && sec.findings.length > 0 && (
            <ul class="sec-findings">
              {sec.findings.slice(0, 3).map((f) => (
                <li>{catLabel[f.cat] || f.cat} <span class="muted">({f.sev})</span></li>
              ))}
            </ul>
          )}
        </Fragment>
      ) : (
        <span class="sec-meta">Security: not yet scanned — our daily static scan will cover it shortly.</span>
      )}
    </div>

    {note && (
      <Fragment>
        <h2 style="margin-top:24px">When to use it</h2>
        <p>{note.use}</p>
        <h2>Who it's for</h2>
        <p>{note.aud}</p>
        <h2>For developers — extending it</h2>
        <p>{note.dev}</p>
      </Fragment>
    )}

    {p.npm && p.pkg ? (
      <Fragment>
        <h2>Install</h2>
        <pre class="code-block"><code>dsh plugin --profile web add {p.pkg}</code></pre>
        <ol class="steps">
          <li>Install pnpm once: <code>npm install -g pnpm</code> (the plugin manager forwards to it).</li>
          <li>Add the plugin to your web profile: <code>dsh plugin --profile web add {p.pkg}</code>.</li>
          <li>Restart <code>dsh web</code> — the plugin loads on the next launch.</li>
          <li>Verify: <code>dsh plugin --profile web list</code>.</li>
        </ol>
        <h2 style="margin-top:24px">Package</h2>
        <p>npm: <a href={npmHome} target="_blank" rel="noopener">{p.pkg}</a> · version <strong>{p.ver || '—'}</strong> · tested on dsh <strong>0.1.0-rc.6</strong></p>
        <h2 style="margin-top:24px">Test report</h2>
        <p>{p.test === 'verified' && 'Verified end-to-end: installed via `dsh plugin add`, activated in the profile, and booted a task successfully.'}
           {p.test === 'pending' && 'Not yet verified — install and test it yourself, or check back later.'}
</p>
        {p.bareNpm === 'missing-dep' && (
          <p class="honest-note">⚠ A bare <code>npm install {p.pkg}</code> fails to import this package — a dependency is likely declared under <code>devDependencies</code> instead of <code>dependencies</code>, so it only installs cleanly via <code>dsh plugin add</code>.</p>
        )}
      </Fragment>
    ) : (
      <Fragment>
        <h2>Install</h2>
        <p>This plugin is <strong>GitHub source</strong> (not published to npm) — install it straight from the repo:</p>
        <pre class="code-block"><code>dsh plugin --profile web add github:{repo}</code></pre>
        <ol class="steps">
          <li>Install pnpm once: <code>npm install -g pnpm</code>.</li>
          <li>Add it from GitHub: <code>dsh plugin --profile web add github:{repo}</code>.</li>
          <li>Restart <code>dsh web</code>.</li>
        </ol>
        <p class="muted small">Note: plugins that ship a <code>prepare</code> build script may prompt pnpm to allow the build — add the key it prints under <code>allowBuilds</code> in <code>pnpm-workspace.yaml</code>, then re-run.</p>
        {buildsMap[p.name] && (
          <div class="build-box">
            <strong>⚡ Prebuilt copy available</strong> — skip the build step, install the compiled version directly:
            <pre class="code-block"><code>dsh plugin --profile web add https://dshbase.com/builds/{buildsMap[p.name]}</code></pre>
          </div>
        )}
        {p.test !== 'not-on-npm' && (
          <Fragment>
            <h2 style="margin-top:24px">Test report</h2>
            <p>{p.test === 'verified' && 'Verified: installed from GitHub, activated in the profile, and booted a task successfully.'}
               {p.test === 'pending' && 'Not yet verified — install and test it yourself.'}
</p>
          </Fragment>
        )}
      </Fragment>
    )}

    {p.needs && (
      <div class="needs-cta">
        <strong>⚠ External account / service required</strong> — this plugin was not fully verified because it needs
        something our sandbox can't provide: <em>{p.needs}</em>. It may work fine in your own environment.
        <p style="margin-top:10px">Author? Either provide the required account/service, <strong>or submit a self-test
          report</strong> (environment + install + run evidence) — we'll review and flip the badge.
          <a class="btn btn-ghost btn-sm" href={verifyUrl} target="_blank" rel="noopener">Submit evidence or self-test report ↗</a></p>
      </div>
    )}

    {p.test === 'pending' && !p.archived && !p.needs && (
      <div class="verify-cta">
        <strong>Plugin author?</strong> Get the “Verified” label — submit your own evidence (screenshots, logs, or a short demo) and we'll review and flip the badge.
        <p style="margin-top:10px"><a class="btn btn-ghost btn-sm" href={verifyUrl} target="_blank" rel="noopener">Submit verification evidence ↗</a></p>
      </div>
    )}

    <h2 style="margin-top:28px">Repository</h2>
    <p><a href={p.url} target="_blank" rel="noopener">github.com/{repo} ↗</a>{p.archived ? ' · <span class="muted">archived</span>' : ''}</p>

    <h2 style="margin-top:28px">Share this badge</h2>
    <p>Paste this into your README — it links back to this page and updates automatically when our test status changes:</p>
    <pre class="code-block"><code>{badgeMd}</code></pre>
    <p><button type="button" class="btn btn-ghost btn-sm badge-copy" data-cmd={badgeMd}>Copy badge markdown</button></p>
    <p><img src={`/badges/${p.slug}.svg`} alt={badgeAlt} width="210" height="20" style="height:20px" /></p>

    {related.length > 0 && (
      <Fragment>
        <h2 style="margin-top:28px">More in {cat}</h2>
        <div class="grid3">
          {related.map((r) => (
            <a class="card card-link" href={`/plugins/${r.slug}/`}>
              <h3>{r.name}</h3>
              <p>{r.test === 'verified' ? '✅ verified' : r.test === 'pending' ? '⏳ unverified' : r.npm ? 'on npm' : 'GitHub source'} · ★{r.stars ?? 0}</p>
            </a>
          ))}
        </div>
        <p style="margin-top:16px"><a class="btn btn-ghost" href={dirUrl}>Browse all {Object.values(plugins).reduce((s, a) => s + a.length, 0)} plugins &rarr;</a></p>
      </Fragment>
    )}
  </section>
</Base>

<style>
  .badge { font-size: 13px; padding: 4px 12px; white-space: nowrap; }
  .st-ok { color: #1a7f37; border-color: #b7e0c0; background: #f0fff4; }
  .st-src { color: var(--ink-2); background: #f7f8fa; }
  .st-warn { color: #9a6700; border-color: #e5c27a; background: #fff8e6; }
  .what-it-does { font-size: 15px; line-height: 1.7; color: var(--ink); background: #f7f8fc; border-left: 3px solid var(--primary); padding: 14px 16px; border-radius: 8px; }
  .review-text { font-size: 14px; line-height: 1.7; color: var(--ink-2); margin: 10px 0 4px; }
  .honest-note { font-size: 12.5px; line-height: 1.6; color: var(--ink-3); background: #f8fafc; border: 1px dashed var(--border); border-radius: 8px; padding: 10px 12px; margin: 12px 0; }
  .sec-box { font-size: 13px; line-height: 1.6; color: var(--ink-2); background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; margin: 12px 0; }
  .sec-badge { font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 6px; white-space: nowrap; }
  .sec-low { color: #1a7f37; background: #f0fff4; border: 1px solid #b7e0c0; }
  .sec-med { color: #9a6700; background: #fff8e6; border: 1px solid #e5c27a; }
  .sec-high { color: #b45309; background: #fff1e6; border: 1px solid #f5c6a0; }
  .sec-crit { color: #b91c1c; background: #fef2f2; border: 1px solid #fca5a5; }
  .sec-meta { font-size: 12px; color: var(--ink-3); }
  .sec-findings { margin: 8px 0 0; padding-left: 18px; font-size: 12.5px; color: var(--ink-2); }
  .build-box { font-size: 13.5px; color: var(--ink-2); background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 12px 16px; margin: 14px 0; }
  .build-box .code-block { margin: 8px 0 0; }
  .verify-cta { font-size: 13.5px; line-height: 1.6; color: var(--ink-2); background: #f6f3ff; border: 1px solid #d6ccf5; border-radius: 10px; padding: 12px 16px; margin: 18px 0 0; }
  .needs-cta { font-size: 13.5px; line-height: 1.6; color: var(--ink-2); background: #fff8e6; border: 1px solid #f2d894; border-radius: 10px; padding: 12px 16px; margin: 18px 0 0; }
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin: 4px 0; }
  .metric { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 12px; text-align: center; }
  .m-val { display: block; font-size: 20px; font-weight: 800; color: var(--ink); }
  .m-lab { font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .03em; }
  .verdict { display: flex; align-items: center; gap: 12px; margin: 18px 0 6px; padding: 14px 16px; border-radius: 10px; font-size: 14px; line-height: 1.5; }
  .v-icon { font-size: 22px; }
  .v-ok { background: #f0fff4; border: 1px solid #b7e0c0; color: #1a4d2e; }
  .v-warn { background: #fff8e6; border: 1px solid #e5c27a; color: #6b4d00; }
  .v-src { background: #f1f5f9; border: 1px solid #e2e8f0; color: #334155; }
</style>

<script>
  document.querySelectorAll('.badge-copy').forEach((btn) => {
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(btn.dataset.cmd).then(() => {
        const orig = btn.textContent;
        btn.textContent = '✅ Copied!';
        setTimeout(() => { btn.textContent = orig; }, 1500);
      });
    });
  });
</script>
