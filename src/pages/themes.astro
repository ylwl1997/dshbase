---
import Base from '../layouts/Base.astro';
import skinsData from '../data/skins.json';
import { getRelativeLocaleUrl } from 'astro:i18n';
const directoryUrl = getRelativeLocaleUrl('en', '/plugins/directory/');
const advancedUrl = getRelativeLocaleUrl('en', '/advanced-skins/');
const skins = skinsData.skins;
const groups = skinsData.groups;
const featuredIds = skinsData.featured || [];
const featured = featuredIds.map((id) => skins.find((s) => s.id === id)).filter(Boolean);
const grouped = groups.map((g) => ({ name: g.name, count: g.count, skins: skins.filter((s) => s.group === g.name) })).filter((g) => g.skins.length > 0);
const thumb = (s, kind) => `/skins/${kind === 'light' ? s.thumb.light : s.thumb.dark}`;
const advancedFeatured = [
  { img: '/skins/heige/qq2008.webp', name: 'QQ 2008 Pink', ip: 'QQ' },
  { img: '/skins/heige/qq2007.webp', name: 'QQ 2007', ip: 'QQ' },
  { img: '/skins/heige/genshin-dark.webp', name: 'Genshin Liyue Night', ip: 'Genshin' },
  { img: '/skins/heige/waves-1.webp', name: 'Wuthering Waves Dark Cyan', ip: 'Wuthering Waves' },
  { img: '/skins/heige/miku.webp', name: 'Hatsune Miku', ip: 'Hatsune Miku' },
  { img: '/skins/heige/deepseek-nv-q.webp', name: 'DeepSeek Girl Chibi', ip: 'DeepSeek-tan' },
  { img: '/skins/heige/neice-dalao.webp', name: 'Beta Tester', ip: 'Original' },
  { img: '/skins/heige/fengge.webp', name: 'Fengge Riding Whale', ip: 'Original' },
];
---
<Base title="DeepSeek Harness Themes — 151 Day/Night Skins &amp; Theme Center | dshbase" description="DeepSeek Harness theme center: 151 day/night skins with real previews across 14 style groups. Click any skin to toggle day/night. Install with dsh plugin add dsh-themes." currentPath="/themes/">
  <section class="hero wrap">
    <p class="eyebrow">Theme center</p>
    <h1>DeepSeek Harness <span class="accent">themes</span></h1>
    <p class="lede">Give your DSH Web UI a new look — <strong>{skins.length} day/night skins</strong> across {groups.length} style groups. Click any preview to toggle <strong>day ⇄ night</strong>.</p>
  </section>

  <section class="info wrap">
    <h2>Install</h2>
    <pre class="code-block"><code>dsh plugin add dsh-themes</code></pre>
    <p>Restart <code>dsh web</code>, then find the theme center in Settings → Plugins. For a single skin, clone the repo once then add it by local path — the exact <code>&lt;id&gt;</code> is shown under each card below:</p>
    <pre class="code-block"><code>git clone https://github.com/whyihaveyou/dsh-themes.git
dsh plugin add ./dsh-themes/skins/&lt;id&gt;</code></pre>

    <p class="callout">Want <strong>higher-fidelity skins with background images</strong>? We also cover a source-patch engine with 21 skins + one-image custom themes — see the <a href={advancedUrl}>advanced skins page →</a></p>

    <h2 style="margin-top:32px">Featured skins</h2>
    <div class="skin-grid featured">
      {featured.map((s) => (
        <div class="skin-card" style={`--accent:${s.accent}`}>
          <button class="skin-shot" type="button" aria-label={`${s.name} — click to toggle day/night`}>
            <img src={thumb(s, 'light')} alt={`${s.name} day preview`} loading="lazy" width="320" height="200">
            <img src={thumb(s, 'dark')} alt={`${s.name} night preview`} loading="lazy" width="320" height="200" class="shot-night">
            <span class="shot-tag" data-day="Day" data-night="Night">Day</span>
          </button>
          <div class="skin-meta">
            <span class="skin-name">{s.name}</span>
            <span class="skin-tag">{s.tagline || s.group}</span>
            <div class="skin-cmd">
              <code>dsh plugin add ./dsh-themes/skins/{s.id}</code>
              <button type="button" class="cmd-copy" data-cmd={`dsh plugin add ./dsh-themes/skins/${s.id}`}>Copy</button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="skin-group">
      <h2 style="margin-top:36px">Featured advanced skins <span class="muted small">(source-patch · with background images)</span></h2>
      <p class="muted small" style="margin-top:-4px">Higher-fidelity source-patch skins with full background images. Click an image to enlarge — see all 21 on the <a href={advancedUrl}>advanced skins page →</a></p>
      <div class="skin-grid featured">
        {advancedFeatured.map((s) => (
          <div class="skin-card">
            <button class="shot-frame" type="button" data-lightbox={s.img} aria-label={`${s.name} — click to enlarge`}>
              <img src={s.img} alt={`${s.name} real screenshot`} loading="lazy" width="320" height="200">
              <span class="shot-tag">{s.ip}</span>
            </button>
            <div class="skin-meta">
              <span class="skin-name">{s.name}</span>
              <span class="skin-tag">{s.ip} · source-patch</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    {grouped.map((g) => (
      <div class="skin-group">
        <h2 style="margin-top:36px" id={`group-${g.name}`}>{g.name} <span class="muted small">({g.count})</span></h2>
        <div class="skin-grid">
          {g.skins.map((s) => (
            <div class="skin-card" style={`--accent:${s.accent}`}>
              <button class="skin-shot" type="button" aria-label={`${s.name} — click to toggle day/night`}>
                <img src={thumb(s, 'light')} alt={`${s.name} day preview`} loading="lazy" width="320" height="200">
                <img src={thumb(s, 'dark')} alt={`${s.name} night preview`} loading="lazy" width="320" height="200" class="shot-night">
                <span class="shot-tag" data-day="Day" data-night="Night">Day</span>
              </button>
              <div class="skin-meta">
                <span class="skin-name">{s.name}</span>
                <span class="skin-tag">{s.tagline || s.group}</span>
                <div class="skin-cmd">
                  <code>dsh plugin add ./dsh-themes/skins/{s.id}</code>
                  <button type="button" class="cmd-copy" data-cmd={`dsh plugin add ./dsh-themes/skins/${s.id}`}>Copy</button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

    <h2 style="margin-top:32px">About the theme system</h2>
    <p>DSH's appearance is plugin-driven — themes are just another plugin. <code>dsh-themes</code> bundles {skins.length} skin pairs (a day and a night variant each), and every preview above is a real screenshot of the skin applied to the Web UI. It's part of the dsh-suite ecosystem and is MIT-licensed.</p>
    <p>See the full plugin entry for version, install status, and test result in the <a href="/plugins/dsh-themes/">plugin directory</a>.</p>

    <p style="margin-top:24px"><a class="btn btn-ghost" href={directoryUrl}>Browse all plugins &rarr;</a></p>
  </section>
</Base>

<style>
  .skin-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; margin-top: 16px; }
  .skin-grid.featured { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .skin-card { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: #fff; }
  .skin-shot { position: relative; display: block; width: 100%; padding: 0; margin: 0; border: none; cursor: pointer; background: #0b0d14; line-height: 0; }
  .skin-shot img { display: block; width: 100%; height: auto; aspect-ratio: 16/10; object-fit: cover; background: linear-gradient(160deg, var(--accent) 0%, #ffffff 100%); }
  .skin-shot img.shot-night { display: none; background: linear-gradient(160deg, var(--accent) 0%, #0b0d14 100%); }
  .skin-shot.is-night img { display: none; }
  .skin-shot.is-night img.shot-night { display: block; }
  .shot-tag {
    position: absolute; right: 6px; bottom: 6px;
    font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    color: #fff; background: rgba(15, 23, 42, .62); border: 1px solid rgba(255,255,255,.22);
    border-radius: 999px; padding: 2px 8px; pointer-events: none;
  }
  .skin-meta { padding: 12px 14px 14px; }
  .skin-name { display: block; font-size: 14px; font-weight: 700; color: var(--ink); }
  .skin-tag { display: block; font-size: 12px; color: var(--ink-2); margin-top: 3px; line-height: 1.4; }
  .skin-group h2 { font-size: 20px; }
  .callout { border: 1px solid var(--border); border-left: 3px solid var(--primary); background: var(--primary-soft); border-radius: 10px; padding: 12px 16px; margin: 18px 0 0; }
  .skin-cmd { display: flex; align-items: center; gap: 6px; margin-top: 10px; }
  .skin-cmd code { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; background: var(--bg-soft); border: 1px solid var(--border); border-radius: 7px; padding: 4px 8px; color: var(--ink-2); }
  .skin-cmd button { flex: none; font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 7px; background: #fff; border: 1px solid var(--border-strong); color: var(--ink-2); cursor: pointer; }
  .skin-cmd button:hover { border-color: var(--primary); color: var(--primary-600); }
  .shot-frame { position: relative; display: block; width: 100%; padding: 0; margin: 0; border: none; cursor: zoom-in; background: #0b0d14; line-height: 0; }
  .shot-frame img { display: block; width: 100%; height: auto; aspect-ratio: 16/10; object-fit: cover; }
  .shot-frame:hover img { filter: brightness(1.05); }
</style>

<script>
  document.querySelectorAll('.skin-shot').forEach((btn) => {
    btn.addEventListener('click', () => {
      btn.classList.toggle('is-night');
      const tag = btn.querySelector('.shot-tag');
      if (tag) tag.textContent = btn.classList.contains('is-night') ? tag.dataset.night : tag.dataset.day;
    });
  });

  document.querySelectorAll('.cmd-copy').forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(btn.getAttribute('data-cmd')); btn.textContent = 'Copied!'; }
      catch (e) { btn.textContent = 'Failed'; }
      setTimeout(() => { btn.textContent = label; }, 1500);
    });
  });
</script>
