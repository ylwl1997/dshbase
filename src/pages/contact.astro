---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact dshbase | dshbase"
  description="Contact the operator of dshbase — corrections, questions, and plugin submissions."
  currentPath="/contact/"
>
  <section class="info wrap">
    <h1>Contact <span class="accent">dshbase</span></h1>
    <p>For corrections, questions, or to submit a plugin for the directory, email <a href="mailto:hello@dshbase.com">hello@dshbase.com</a>.</p>
    <p>Please include the plugin repository URL when submitting a plugin. We respond to factual corrections and plugin submissions.</p>
  </section>
</Base>
