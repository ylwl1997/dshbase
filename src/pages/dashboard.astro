---
import Base from '../layouts/Base.astro';
import plugins from '../data/plugins.json';
import { getRelativeLocaleUrl } from 'astro:i18n';
const directoryUrl = getRelativeLocaleUrl('en', '/plugins/directory/');

const all = Object.entries(plugins).flatMap(([cat, items]) => items.map((p) => ({ ...p, cat })));
const total = all.length;
const nOk = all.filter((p) => p.test === 'ok').length;
const nNpm = all.filter((p) => p.npm).length;
const nSource = all.filter((p) => !p.npm).length;
const nGitOk = all.filter((p) => p.test === 'git-ok').length;
const nBuild = all.filter((p) => p.test === 'git-build').length;
const nIssue = all.filter((p) => ['load-fail','install-fail','git-fail'].includes(p.test)).length;

// star distribution
const starBuckets = [['0–10', 0], ['10–50', 0], ['50–100', 0], ['100–500', 0], ['500+', 0]];
const bucketIdx = (s) => s >= 500 ? 4 : s >= 100 ? 3 : s >= 50 ? 2 : s >= 10 ? 1 : 0;
all.forEach((p) => { starBuckets[bucketIdx(p.stars ?? 0)][1]++; });
const maxStars = Math.max(...starBuckets.map(([, n]) => n), 1);

// category distribution
const catDist = Object.entries(plugins).map(([cat, items]) => [cat, items.length]);
const maxCat = Math.max(...catDist.map(([, n]) => n), 1);

// growth curve: cumulative plugin count by added date
const byDay = {};
all.forEach((p) => { const d = p.added; if (d) byDay[d] = (byDay[d] || 0) + 1; });
let _cum = 0;
const growth = Object.keys(byDay).sort().map((d) => { _cum += byDay[d]; return [d.slice(5), _cum]; });
const maxG = growth.length ? growth[growth.length - 1][1] : 1;
const GW = 640, GH = 200, GP = 34;
const gX = (i) => GP + (i / Math.max(growth.length - 1, 1)) * (GW - 2 * GP);
const gY = (v) => GH - GP - (v / maxG) * (GH - 2 * GP);
const gPts = growth.map(([, v], i) => [gX(i), gY(v)]);
const gLine = gPts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const gArea = `${GP},${GH - GP} ${gLine} ${GW - GP},${GH - GP}`;

// official repo discussion stats (from our scan of 1401 discussions)
const ghStats = [
  ['Bug reports', 321, '#fca5a5'],
  ['Feature ideas', 297, '#93c5fd'],
  ['Plugin shares', 209, '#86efac'],
  ['Q&A', 174, '#fcd34d'],
];
const maxGh = 321;

// top plugins by stars (for featured)
const topPlugins = [...all].sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0)).slice(0, 8);
---
<Base title="DeepSeek Harness Ecosystem Dashboard — 133 Plugins, Stars &amp; Growth | dshbase" description="Live DeepSeek Harness ecosystem dashboard: 133 plugins, star distribution, category breakdown, official-discussion activity, and top plugins." currentPath="/dashboard/">
  <section class="hero wrap">
    <p class="eyebrow">Ecosystem dashboard</p>
    <h1>DeepSeek Harness <span class="accent">ecosystem</span> at a glance</h1>
    <p class="lede">Live stats of the dsh plugin ecosystem — {total} plugins cataloged, tested, and tracked. Built from our <a href={directoryUrl}>plugin directory</a> and the official GitHub discussions.</p>
  </section>

  <section class="info wrap">
    <div class="stats-grid">
      <div class="stat-card"><span class="s-val">{total}</span><span class="s-lab">Plugins</span></div>
      <div class="stat-card"><span class="s-val">{nOk + nGitOk}</span><span class="s-lab">Verified</span></div>
      <div class="stat-card"><span class="s-val">{nNpm}</span><span class="s-lab">On npm</span></div>
      <div class="stat-card"><span class="s-val">{nBuild}</span><span class="s-lab">Need build</span></div>
      <div class="stat-card"><span class="s-val">{nIssue}</span><span class="s-lab">Issues</span></div>
      <div class="stat-card"><span class="s-val">{nSource}</span><span class="s-lab">GitHub source</span></div>
    </div>

    <h2 style="margin-top:32px">Growth</h2>
    <p class="muted small">Cumulative cataloged plugins by first-seen date.</p>
    <svg class="growth-svg" viewBox={`0 0 ${GW} ${GH}`} role="img" aria-label="Plugin catalog growth curve">
      <defs>
        <linearGradient id="gfill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#4D6BFE" stop-opacity="0.22" />
          <stop offset="100%" stop-color="#4D6BFE" stop-opacity="0" />
        </linearGradient>
      </defs>
      <polygon points={gArea} fill="url(#gfill)" />
      <polyline points={gLine} fill="none" stroke="#4D6BFE" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      {gPts.map(([x, y]) => <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="4" fill="#4D6BFE" />)}
    </svg>
    <div class="growth-axis">
      {growth.map(([d, v]) => <span>{d}</span>)}
    </div>

    <h2 style="margin-top:32px">Star distribution</h2>
    <div class="bar-chart">
      {starBuckets.map(([label, n]) => (
        <div class="bar-row">
          <span class="bar-label">{label}</span>
          <div class="bar-track"><div class="bar-fill" style={`width:${(n / maxStars) * 100}%`}></div></div>
          <span class="bar-num">{n}</span>
        </div>
      ))}
    </div>

    <h2 style="margin-top:32px">Category distribution</h2>
    <div class="bar-chart">
      {catDist.map(([cat, n]) => (
        <div class="bar-row">
          <span class="bar-label">{cat}</span>
          <div class="bar-track"><div class="bar-fill bar-cat" style={`width:${(n / maxCat) * 100}%`}></div></div>
          <span class="bar-num">{n}</span>
        </div>
      ))}
    </div>

    <h2 style="margin-top:32px" id="community-h">Official repo activity (1,401 discussions)</h2>
    <div class="bar-chart" id="community-bars">
      {ghStats.map(([label, n, color]) => (
        <div class="bar-row">
          <span class="bar-label">{label}</span>
          <div class="bar-track"><div class="bar-fill" style={`width:${(n / maxGh) * 100}%;background:${color}`}></div></div>
          <span class="bar-num">{n}</span>
        </div>
      ))}
    </div>

    <h2 style="margin-top:32px">Top plugins by stars</h2>
    <div class="grid3">
      {topPlugins.map((p) => (
        <a class="card card-link" href={`/plugins/${p.name}/`}>
          <h3>{p.name} <span class="muted small">★{p.stars ?? 0}</span></h3>
          <p>{p.test === 'ok' ? '✅ verified' : p.npm ? 'on npm' : 'GitHub source'}</p>
        </a>
      ))}
    </div>

    <p style="margin-top:24px"><a class="btn btn-ghost" href={directoryUrl}>Browse all {total} plugins &rarr;</a></p>
  </section>
</Base>

<style>
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 14px; }
  .stat-card { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 18px; text-align: center; }
  .s-val { display: block; font-size: 28px; font-weight: 800; color: var(--primary); }
  .s-lab { font-size: 12px; color: var(--ink-3); }
  .bar-chart { margin-top: 14px; }
  .bar-row { display: flex; align-items: center; gap: 12px; margin: 8px 0; }
  .bar-label { width: 130px; font-size: 13px; color: var(--ink-2); text-align: right; flex-shrink: 0; }
  .bar-track { flex: 1; height: 18px; background: #eef1f6; border-radius: 9px; overflow: hidden; }
  .bar-fill { height: 100%; background: linear-gradient(90deg, #4D6BFE, #7c8cf8); border-radius: 9px; }
  .bar-cat { background: linear-gradient(90deg, #8b5cf6, #a78bfa); }
  .bar-num { width: 36px; font-size: 13px; font-weight: 700; color: var(--ink); }
  .growth-svg { width: 100%; max-width: 640px; display: block; margin-top: 14px; }
  .growth-axis { width: 100%; max-width: 640px; display: flex; justify-content: space-between; font-size: 12px; color: var(--ink-3); padding: 0 22px; }
</style>

<script>
  // Live official-repo discussion counts; fall back to the server snapshot above.
  (async () => {
    try {
      const res = await fetch('/api/community');
      if (!res.ok) return;
      const d = await res.json();
      const cats = d && d.categories ? Object.entries(d.categories) : [];
      if (!cats.length) return;
      cats.sort((a, b) => b[1] - a[1]);
      const max = Math.max(...cats.map(([, n]) => n), 1);
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      const palette = ['#fca5a5', '#93c5fd', '#86efac', '#fcd34d', '#c4b5fd', '#f9a8d4', '#67e8f9', '#fdba74'];
      const bars = document.getElementById('community-bars');
      bars.innerHTML = cats.map(([label, n], i) => `
        <div class="bar-row">
          <span class="bar-label">${esc(label)}</span>
          <div class="bar-track"><div class="bar-fill" style="width:${(n / max) * 100}%;background:${palette[i % palette.length]}"></div></div>
          <span class="bar-num">${n}</span>
        </div>`).join('');
      const h = document.getElementById('community-h');
      if (d.total) h.textContent = `Official repo activity (${d.total.toLocaleString('en-US')} discussions)`;
    } catch (e) {}
  })();
</script>
