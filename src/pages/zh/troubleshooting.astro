---
import Base from '../../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
const installUrl = getRelativeLocaleUrl('zh', '/install/');
const pluginsUrl = getRelativeLocaleUrl('zh', '/plugins/');
const tutorialUrl = getRelativeLocaleUrl('zh', '/tutorial/');

const sections = [
  {
    id: 'install',
    title: '安装与环境',
    items: [
      {
        id: 'pnpm-fetch-404',
        code: 'ERR_PNPM_FETCH_404',
        title: '包找不到',
        desc: '你的 npm 镜像落后于官方，刚发布的包返回 404。',
        cmd: 'dsh plugin add <包名> --registry=https://registry.npmjs.org',
      },
      {
        id: 'pnpm-not-recognized',
        code: "'pnpm' 不是内部或外部命令",
        title: 'pnpm 缺失',
        desc: '<code>dsh plugin</code> 会调用 pnpm，但本机没装。',
        cmd: 'npm install -g pnpm',
      },
      {
        id: 'node-not-found',
        code: 'node: command not found',
        title: 'Node.js 不在 PATH 里',
        desc: '<code>dsh</code> 启动器需要 Node.js 在 PATH 里。把 Node 目录（和 npm 全局 bin）加进 PATH，用 <code>npm prefix -g</code> 查路径。',
      },
      {
        id: 'npx-install-fails',
        code: 'npx @deepseek-ai/dsh',
        title: '安装失败',
        desc: '通常是镜像滞后，或某个原生依赖没有预编译二进制。在 Linux 上 <code>node-pty</code> 不提供预编译，需要编译器工具链从源码构建。',
        cmd: 'npx @deepseek-ai/dsh --registry=https://registry.npmjs.org',
        fix: '先装构建工具（Debian/Ubuntu 用 <code>build-essential python3</code>），并改用 Node LTS，再重试。',
      },
      {
        id: 'port-3080',
        code: '3080 端口被占用',
        title: '旧进程占着端口',
        desc: '旧 dsh 进程占着端口——页面甚至能正常加载，但连的是旧实例，配置改动永远不生效。',
        cmd: 'dsh web --port 8080',
        fix: '先杀掉旧进程，或用新端口。',
      },
    ],
  },
  {
    id: 'credentials',
    title: '凭证与模型',
    items: [
      {
        id: 'missing-credential',
        code: 'MISSING_CREDENTIAL',
        title: '没存 API key',
        desc: '没存 API key。在 <strong>设置 → 模型</strong> 填，或写进 <code>~/.dsh/.credentials.yaml</code>：',
        cmd: 'DEEPSEEK_API_KEY: sk-你的key',
      },
      {
        id: 'unknown-model',
        code: 'UNKNOWN_MODEL',
        title: '模型未配置',
        desc: '选了个没配置的模型。给提供方添加该模型，或选已配置的模型。',
      },
      {
        id: 'models-401',
        code: '「获取可用模型」返回 401',
        title: 'key 或 base URL 不对',
        desc: 'key 不对——模型发现会调用 OpenAI 兼容的 <code>GET /models</code> 端点。基础 URL、key、模型名三者必须匹配。',
      },
      {
        id: 'context-length-exceeded',
        code: 'maximum context length is 1048576 tokens',
        title: '超出上下文窗口',
        desc: '对话加上你请求的补全超出了模型的上下文窗口。',
        fix: '开新会话、缩短系统提示词，或调低 <code>max_tokens</code>。长会话建议先总结再新开，别硬顶窗口。',
      },
    ],
  },
  {
    id: 'plugins',
    title: '插件',
    items: [
      {
        id: 'plugin-not-activating',
        code: '插件装了但不激活',
        title: '缺少 dsh.bundle 清单',
        desc: '包没有 <code>dsh.bundle</code> 清单，<code>dsh plugin add</code> 只当普通依赖装——永远不加载。插件必须带 <code>cordis.patch.yml</code> 并在 <code>package.json</code> 声明 <code>dsh.bundle.patch</code>。',
      },
      {
        id: 'require-esm',
        code: 'ERR_REQUIRE_ESM',
        title: '插件被编译成 CommonJS',
        desc: '插件被编译成 CommonJS，但依赖了 ESM-only 的包（如 <code>@deepseek-ai/dsh-tools</code>）。插件必须构建成 ESM（<code>"type": "module"</code>）。',
      },
      {
        id: 'systemprompt-no-inject',
        code: 'cannot get property "systemPrompt" without inject',
        title: '缺少 inject 声明',
        desc: '插件代码调了 <code>ctx.systemPrompt</code> 却没声明 <code>inject: ["systemPrompt"]</code>。这是插件 bug——把这条报错原样发给作者。',
      },
      {
        id: 'allowbuilds',
        code: 'allowBuilds 提示',
        title: 'git 插件构建脚本被阻止',
        desc: '从 GitHub 装的插件带 <code>prepare</code> 构建脚本，pnpm 默认阻止。把 pnpm 提示的 key 加进 <code>pnpm-workspace.yaml</code> 的 <code>allowBuilds</code>，再重跑。',
      },
      {
        id: 'dsh-type-meta-missing',
        code: '「@deepseek-ai/dsh-type-meta」找不到',
        title: '依赖还没发布',
        desc: '插件依赖了还没发到 npm 的包。客户端无解——作者得先发布。',
      },
      {
        id: 'duplicate-dsh-tools',
        code: "reading 'prepare' of undefined",
        title: 'dsh-tools 重复实例',
        desc: '插件的 peer 依赖拉进了第二份 <code>@deepseek-ai/dsh-tools</code>，内部 symbol-key 查找冲突，工具调度崩溃。',
        fix: '让 <code>@deepseek-ai/dsh-tools</code> 只作为单一共享依赖（peer 或只 bundled 一次），或请作者修 peer 版本范围。',
      },
      {
        id: 'duplicate-loader-entry',
        code: 'duplicate loader entry id',
        title: 'bundle 依赖被重复提升',
        desc: '<code>dsh plugin add</code> 把一个已声明 bundle 的依赖又提升进 bundle 栈，产生重复 entry id。',
        fix: '从 profile 的 bundle 配置里删掉重复项，再重新添加插件。',
      },
      {
        id: 'failed-to-load-plugins',
        code: 'Failed to load plugins',
        title: '插件挂载致命屏',
        desc: '某个插件在启动时挂载失败，UI 不提供任何恢复操作。',
        fix: '把问题插件移出 profile（或重置 profile）再重启，然后逐个加回插件定位元凶。',
      },
    ],
  },
  {
    id: 'revert',
    title: '如何恢复 / 回滚 DeepSeek Harness 的更改',
    items: [
      {
        id: 'revert-uninstall-plugin',
        code: 'dsh plugin remove',
        title: '撤销一次插件安装',
        desc: 'DSH 的 profile 是 <code>~/.dsh/profiles/&lt;名称&gt;/</code> 下的自包含目录，装插件只影响该目录。撤销单个插件安装：',
        cmd: 'dsh plugin --profile web remove <包名>',
        fix: '<code>remove</code> 会转发给 profile 目录里的 pnpm 执行（0.1.1-rc.2 实测），同时重写 <code>pnpm-lock.yaml</code> 并清理 <code>node_modules</code>。重启 <code>dsh web</code> 生效。',
      },
      {
        id: 'revert-config',
        code: 'profile 配置回滚',
        title: '撤销配置改动',
        desc: 'DSH 不为 profile 配置保留内建版本历史——bundle 层在 profile 目录的 <code>cordis.yml</code> / <code>cordis.patch.yml</code>，用户设置在全局 <code>~/.dsh/settings.yaml</code>。把整个 profile 目录当作回滚单元：',
        cmd: 'cp -r ~/.dsh/profiles/web ~/.dsh/profiles/web.bak-2026-08   # 危险改动前先备份',
        fix: '恢复时先停 dsh，删除损坏的 profile 目录再把备份拷回。回滚前可运行 <code>dsh --profile web --dump-config &gt; before.txt</code> 快照实际装配的层树，改动后 diff 对照——dump 才是"当前到底加载了什么"的唯一事实来源。',
      },
      {
        id: 'revert-broken-profile',
        code: 'profile does not exist',
        title: 'profile 彻底损坏后的恢复',
        desc: '手改 <code>cordis.yml</code> 改坏、<code>node_modules</code> 损坏等情况下，启动直接抛栈或报 <code>profile "&lt;名称&gt;" does not exist</code>。',
        cmd: "rm -rf ~/.dsh/profiles/web && dsh plugin --profile web add @deepseek-ai/dsh-base @deepseek-ai/dsh-web-app",
        fix: '重建 profile 往往比调试改坏的 bundle 文件更快——会话数据存在 <code>~/.dsh/sessions</code>，与 profile 分离，重建不会丢历史对话。实测：dsh 对缺失 profile 拒绝启动并打印的正是这条重建命令。',
      },
      {
        id: 'revert-credentials',
        code: '.credentials.yaml',
        title: '撤销 API key / 凭据改动',
        desc: '凭据是 <code>~/.dsh/.credentials.yaml</code> 里的纯文本（或用 <code>DEEPSEEK_API_KEY</code> 环境变量，优先级更高），系统不保留历史。',
        fix: '改动前自行留一份备份（macOS/Linux 上该文件必须保持 <code>chmod 600</code>，否则 DSH 拒绝读取）。误轮换 key 后拷回备份即可恢复本地配置——但旧 key 若已在服务端吊销，本地回滚救不回来。',
      },
    ],
  },
  {
    id: 'runtime',
    title: '运行时与 Web UI',
    items: [
      {
        id: 'send-disabled',
        code: 'Web UI 发送按钮一直灰',
        title: '没选工作区',
        desc: 'web profile 要先选工作区才能发送。点<strong>选择工作区</strong>并选中目录。',
      },
      {
        id: 'skills-cli-vs-web',
        code: '技能在 CLI 能用、Web UI 不能用',
        title: 'profile 能力不一致',
        desc: 'web profile 默认<strong>禁用</strong>了 <code>tool-skill</code> 和 <code>skill-filesystem</code>；headless/CLI profile 是开的。',
      },
      {
        id: 'randomuuid-insecure',
        code: 'crypto.randomUUID is not a function',
        title: '明文 HTTP 破坏 Web Crypto',
        desc: 'Web Crypto API 只在安全上下文可用。用明文 <code>http://</code>（局域网 IP 或手机）访问 web UI 会触发此错。',
        fix: '改用 <code>https://</code> 或 <code>localhost</code>，或在 web UI 前挂一个带 TLS 的反向代理。',
      },
      {
        id: 'composer-input-vanishes',
        code: 'Composer 输入框消失',
        title: 'markdown 图片引用损坏',
        desc: '删除草稿里的 markdown 图片引用可能导致输入框变空。',
        fix: '刷新页面。若反复出现，请带上复现步骤反馈。',
      },
      {
        id: 'commands-list-404',
        code: '/api/commands/list 返回 404',
        title: '命令菜单为空',
        desc: '插件清单自动发现机制坏了，命令没注册上。',
        fix: '重装插件并重启 web UI；若仍存在请反馈。',
      },
      {
        id: 'skill-prefix-match',
        code: '技能菜单只按前缀匹配',
        title: '中间词搜不到',
        desc: '技能搜索按名称前缀匹配，中间词搜不到。',
        fix: '从头开始输入技能名，或浏览完整技能列表。',
      },
      {
        id: 'remote-settings-blank',
        code: '远程访问时 设置 → 插件 一片空白',
        title: '插件管理仅限本机',
        desc: '从另一台机器（局域网 IP 或隧道）打开 web UI 时，设置 → 插件面板静默空白——插件管理仅限本机，但没有任何提示告诉你这一点。',
        fix: '在 dsh 运行的那台机器上、通过 <code>http://127.0.0.1:3080</code> 管理插件。远程浏览器可以聊天，但插件的增删必须本机操作。',
      },
    ],
  },
  {
    id: 'sessions',
    title: '会话与缓存',
    items: [
      {
        id: 'session-seq-gap',
        code: '恢复时会话日志损坏',
        title: '追加日志出现序号断层',
        desc: '恢复时最后已提交的事件带新时间戳重新追加，在只追加日志里造成序号断层。',
        fix: '先导出数据，再开新会话，别继续恢复损坏的会话。',
      },
      {
        id: 'kv-cache-collapse',
        code: '恢复后 KV 缓存命中率骤降',
        title: '系统提示词顺序漂移',
        desc: '恢复时系统提示词各段顺序漂移，缓存命中率掉到接近零。',
        fix: '干净地新开会话而非恢复，并保持预设顺序稳定。',
      },
      {
        id: 'history-internal-fetch',
        code: 'History "Failed to fetch (internal)"',
        title: '会话增量损坏',
        desc: '带有畸形流式工具调用增量的会话无法加载。',
        fix: '刷新；若持续出现，说明会话文件已损坏——重新开。',
      },
    ],
  },
  {
    id: 'platform',
    title: '平台相关',
    items: [
      {
        id: 'windows-sandbox-https',
        code: 'SEC_E_NO_CREDENTIALS',
        title: 'Windows 沙箱破坏 HTTPS',
        desc: '受限令牌沙箱破坏了 Schannel HTTPS（curl、PowerShell）。OpenSSL 客户端（node、python）不受影响。',
        fix: '网络任务用完整访问预设，或改走 node/python 工具。',
      },
      {
        id: 'sharp-dlopen',
        code: 'ERR_DLOPEN_FAILED',
        title: 'Windows 上 sharp 加载失败',
        desc: '原生图像依赖在 dev/desktop 构建里加载失败。',
        fix: '采用相关讨论里的 workaround，或改用纯 JS 回退方案。',
      },
      {
        id: 'macos-launchd-path',
        code: 'macOS launchd env: node',
        title: 'PATH 缺失导致崩溃循环',
        desc: 'LaunchAgent 启动时没有 PATH，找不到 <code>node</code>，dsh 陷入崩溃循环。',
        fix: '给 LaunchAgent 的 plist 加上 PATH 和 <code>ThrottleInterval</code>。',
      },
      {
        id: 'windows-utf16-nul',
        code: 'Windows 中文路径被截断',
        title: 'UTF-16 低字节被当成 NUL',
        desc: 'UTF-16 低字节为 <code>0x00</code> 的字符（如「言」）被误判成 NUL 终止符，dsh 会把工作目录在该字符处截断，其下的文件/会话无法打开。',
        fix: '从避开这些字符的路径运行 dsh（纯 ASCII 路径，或目录名不含此类字）。这是上游 <code>readUtf16</code> 解码 bug——请带上你的完整路径反馈。',
      },
      {
        id: 'macos-exfat-pnpm',
        code: 'exFAT 卷上 pnpm install 失败',
        title: 'lefthook inode 归属检查',
        desc: '在 macOS 的 exFAT/USB 卷上，<code>pnpm install</code> 在 lefthook 安装步骤中止——exFAT 不保留 Unix inode/归属，钩子安装检查失败。',
        fix: '把项目挪到 APFS/HFS+（或其他带日志的）卷再重装。exFAT 用于跨设备传输，不适合跑 pnpm 工作区。',
      },
    ],
  },
];

const stripHtml = (s) => (s || '').replace(/<[^>]*>/g, '');
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: sections.flatMap((s) =>
    s.items.map((i) => ({
      '@type': 'Question',
      name: `${i.code ? i.code + ' — ' : ''}${i.title}？`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: [stripHtml(i.desc), i.cmd, stripHtml(i.fix)].filter(Boolean).join(' '),
      },
    }))
  ),
};
---

<Base
  title="DeepSeek Harness 排错指南 — 常见 dsh 报错修复 | dshbase 中文"
  description="修复 DeepSeek Harness（dsh）常见报错：ERR_PNPM_FETCH_404、ERR_REQUIRE_ESM、插件不激活、MISSING_CREDENTIAL、上下文超限、crypto.randomUUID、dsh-tools 重复、Failed to load plugins 等——来自实测与官方仓库高频反馈的已验证修复。"
  currentPath="/troubleshooting/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="hero wrap">
    <p class="eyebrow">排错</p>
    <h1>修复常见 <span class="accent">dsh</span> 报错</h1>
    <p class="lede">下面的每个修复都来自真实运行 dsh，外加官方仓库反馈最多的问题。每条给出精确报错、原因和修复方法。</p>
  </section>

  <div class="ts-wrap wrap">
    <aside class="toc-side">
      <nav class="toc" aria-label="本页目录">
        <p class="toc-title">本页目录</p>
        <ol class="toc-list">
          {sections.map((s) => (
            <li><a href={`#${s.id}`}>{s.title}</a></li>
          ))}
        </ol>
      </nav>
    </aside>

    <section class="info ts-main">
      {sections.map((s) => (
        <Fragment>
          <h2 id={s.id} style="margin-top:28px">{s.title}</h2>
          {s.items.map((i) => (
            <Fragment>
              <h3 id={i.id} style="margin-top:24px">{i.code && <code>{i.code}</code>} {i.title}</h3>
              {i.desc && <p set:html={i.desc} />}
              {i.cmd && <pre class="code-block"><code>{i.cmd}</code></pre>}
              {i.fix && <p set:html={i.fix} />}
            </Fragment>
          ))}
        </Fragment>
      ))}

      <p style="margin-top:32px">还没解决？看<a href={installUrl}>安装指南</a>、<a href={pluginsUrl}>插件指南</a>或<a href={tutorialUrl}>教程</a>。</p>
    </section>
  </div>
</Base>

<style>
  .ts-wrap { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 40px; align-items: start; }
  .ts-main { padding: 42px 0; min-width: 0; }
  .ts-main h2 { scroll-margin-top: 84px; }
  .ts-main h3 { scroll-margin-top: 84px; font-size: 18px; margin: 0 0 8px; color: var(--ink); }
  .ts-main h3 code { font-size: 13.5px; background: var(--primary-soft); padding: 2px 8px; border-radius: 6px; color: var(--primary-600); }
  .ts-main p { color: var(--ink-2); line-height: 1.75; margin: 8px 0; }
  .toc-side { position: sticky; top: 84px; padding-top: 42px; }
  .toc { border-left: 2px solid var(--border); padding-left: 16px; }
  .toc-title { font-size: 11px; font-weight: 700; color: var(--ink-2); text-transform: uppercase; letter-spacing: .06em; margin: 0 0 8px; }
  .toc-list { list-style: none; margin: 0; padding: 0; }
  .toc-list li { margin: 0; }
  .toc-list a { display: block; padding: 4px 0; color: var(--ink-2); text-decoration: none; line-height: 1.4; font-size: 13px; }
  .toc-list a:hover { color: var(--primary); }
  @media (max-width: 900px) {
    .ts-wrap { grid-template-columns: 1fr; }
    .toc-side { position: static; padding-top: 24px; order: -1; }
    .toc { border-left: none; border-bottom: 1px solid var(--border); padding: 0 0 12px; }
    .toc-list { display: flex; flex-wrap: wrap; gap: 4px 18px; }
    .toc-list a { padding: 3px 0; }
  }
</style>
