---
import Base from '../../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import plugins from '../../data/plugins.json';
const installUrl = getRelativeLocaleUrl('zh', '/install/');
const tutorialUrl = getRelativeLocaleUrl('zh', '/tutorial/');
const pluginsUrl = getRelativeLocaleUrl('zh', '/plugins/');
const directoryUrl = getRelativeLocaleUrl('zh', '/plugins/directory/');
const troubleshootingUrl = getRelativeLocaleUrl('zh', '/troubleshooting/');
const allPlugins = Object.values(plugins).flat();
const verifiedCount = allPlugins.filter((p) => p.test === 'verified').length.toLocaleString('en-US');
---
<Base
  title="如何使用 DeepSeek Harness — 安装、开发插件、迁移 | dshbase 中文"
  description="如何使用 DeepSeek Harness（dsh）：任意系统安装、跑第一个任务、装插件、开发插件、从 Claude Code 迁移、修复报错——逐步指南。"
  currentPath="/how-to/"
>
  <section class="hero wrap">
    <p class="eyebrow">How-to</p>
    <h1>如何使用 <span class="accent">DeepSeek Harness</span></h1>
    <p class="lede">最高频「how to」问题的逐步解答——每条都链到完整指南。</p>
  </section>

  <section class="info wrap">
    <h2>如何安装 DeepSeek Harness</h2>
    <p>装 Node.js LTS（18+），然后运行：</p>
    <pre class="code-block"><code>npx @deepseek-ai/dsh web</code></pre>
    <p>打开 http://127.0.0.1:3080。Windows/macOS/Linux/WSL 一键脚本见<a href={installUrl}>安装指南</a>。</p>

    <h2 style="margin-top:24px">如何跑第一个任务</h2>
    <ol class="steps">
      <li>启动 web UI（<code>npx @deepseek-ai/dsh web</code>）。</li>
      <li>在<strong>设置 → 模型</strong>填 DeepSeek API key。</li>
      <li>点<strong>选择工作区</strong>选一个项目目录。</li>
      <li>发任务，如 <code>总结这个仓库</code>。</li>
    </ol>
    <p>完整流程见<a href={tutorialUrl}>教程</a>。</p>

    <h2 style="margin-top:24px">如何安装插件</h2>
    <pre class="code-block"><code>dsh plugin --profile web add dsh-memory</code></pre>
    <p>浏览 {verifiedCount} 个已实测插件，见<a href={directoryUrl}>插件目录</a>。</p>

    <h2 style="margin-top:24px">如何开发自己的插件</h2>
    <p>插件就是一个导出 <code>apply(ctx)</code> 的 TypeScript 模块，配 <code>cordis.patch.yml</code> 和 <code>dsh.bundle</code> 清单，必须 ESM。完整流程见<a href={pluginsUrl}>插件指南</a>。</p>

    <h2 style="margin-top:24px">如何从 Claude Code 迁移</h2>
    <p>用 <code>dsh-claude-marketplace</code> 加载 Claude skills/commands，用 <code>dsh-plugin-session-import</code> 导入历史：</p>
    <pre class="code-block"><code>dsh plugin add dsh-claude-marketplace</code></pre>

    <h2 style="margin-top:24px">如何修复常见报错</h2>
    <p>我们实测踩过的所有坑——<code>ERR_PNPM_FETCH_404</code>、<code>ERR_REQUIRE_ESM</code>、插件不激活等——都在<a href={troubleshootingUrl}>排错指南</a>。</p>
  </section>
</Base>
