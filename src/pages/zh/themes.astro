---
import Base from '../../layouts/Base.astro';
import skinsData from '../../data/skins.json';
import { getRelativeLocaleUrl } from 'astro:i18n';
const directoryUrl = getRelativeLocaleUrl('zh', '/plugins/directory/');
const advancedUrl = getRelativeLocaleUrl('zh', '/advanced-skins/');
const skins = skinsData.skins;
const groups = skinsData.groups;
const featuredIds = skinsData.featured || [];
const featured = featuredIds.map((id) => skins.find((s) => s.id === id)).filter(Boolean);
const grouped = groups.map((g) => ({ name: g.name, count: g.count, skins: skins.filter((s) => s.group === g.name) })).filter((g) => g.skins.length > 0);
const thumb = (s, kind) => `/skins/${kind === 'light' ? s.thumb.light : s.thumb.dark}`;
const advancedFeatured = [
  { img: '/skins/heige/qq2008.webp', name: 'QQ 2008 · 粉', ip: 'QQ' },
  { img: '/skins/heige/qq2007.webp', name: 'QQ 2007', ip: 'QQ' },
  { img: '/skins/heige/genshin-dark.webp', name: '原神 · 璃月夜', ip: '原神' },
  { img: '/skins/heige/waves-1.webp', name: '鸣潮 · 黑青', ip: '鸣潮' },
  { img: '/skins/heige/miku.webp', name: '初音未来', ip: '初音未来' },
  { img: '/skins/heige/deepseek-nv-q.webp', name: 'DeepSeek 娘 · Q 版', ip: 'DeepSeek 娘' },
  { img: '/skins/heige/neice-dalao.webp', name: '内测大佬', ip: '原创' },
  { img: '/skins/heige/fengge.webp', name: '峰哥骑鲸', ip: '原创' },
];
---
<Base title="DeepSeek Harness 皮肤中心 — 151 款昼夜皮肤 | dshbase 中文" description="DeepSeek Harness 皮肤中心：151 款昼夜皮肤、真实预览图、14 个风格分组。点击任意皮肤可切换日间/夜间。dsh plugin add dsh-themes 一键安装。" currentPath="/themes/">
  <section class="hero wrap">
    <p class="eyebrow">皮肤中心</p>
    <h1>DeepSeek Harness <span class="accent">皮肤</span></h1>
    <p class="lede">给你的 DSH Web UI 换个新皮肤——<strong>{skins.length} 款昼夜皮肤</strong>、{groups.length} 个风格分组。点击任意预览切换<strong>日间 ⇄ 夜间</strong>。</p>
  </section>

  <section class="info wrap">
    <h2>安装</h2>
    <pre class="code-block"><code>dsh plugin add dsh-themes</code></pre>
    <p>重启 <code>dsh web</code>，然后在 设置 → 插件 里找到皮肤中心。单款皮肤：先克隆仓库，再按本地路径安装，<code>&lt;id&gt;</code> 见每张卡片下方：</p>
    <pre class="code-block"><code>git clone https://github.com/whyihaveyou/dsh-themes.git
dsh plugin add ./dsh-themes/skins/&lt;id&gt;</code></pre>

    <p class="callout">想要<strong>更高保真、带背景图的皮肤</strong>？我们还收录了一套源码级换肤引擎，21 款皮肤 + 传图定制——看<a href={advancedUrl}>高级皮肤页 →</a></p>

    <h2 style="margin-top:32px">精选皮肤</h2>
    <div class="skin-grid featured">
      {featured.map((s) => (
        <div class="skin-card" style={`--accent:${s.accent}`}>
          <button class="skin-shot" type="button" aria-label={`${s.name} — 点击切换日间/夜间`}>
            <img src={thumb(s, 'light')} alt={`${s.name} 日间预览`} loading="lazy" width="320" height="200">
            <img src={thumb(s, 'dark')} alt={`${s.name} 夜间预览`} loading="lazy" width="320" height="200" class="shot-night">
            <span class="shot-tag" data-day="日间" data-night="夜间">日间</span>
          </button>
          <div class="skin-meta">
            <span class="skin-name">{s.name}</span>
            <span class="skin-tag">{s.tagline || s.group}</span>
            <div class="skin-cmd">
              <code>dsh plugin add ./dsh-themes/skins/{s.id}</code>
              <button type="button" class="cmd-copy" data-cmd={`dsh plugin add ./dsh-themes/skins/${s.id}`}>复制</button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="skin-group">
      <h2 style="margin-top:36px">高级皮肤精选 <span class="muted small">(源码级 · 带背景图)</span></h2>
      <p class="muted small" style="margin-top:-4px">更高保真的源码级皮肤，带完整背景图。点击图片可放大，完整 21 款见<a href={advancedUrl}>高级皮肤页 →</a></p>
      <div class="skin-grid featured">
        {advancedFeatured.map((s) => (
          <div class="skin-card">
            <button class="shot-frame" type="button" data-lightbox={s.img} aria-label={`${s.name} — 点击放大`}>
              <img src={s.img} alt={`${s.name} 真机截图`} loading="lazy" width="320" height="200">
              <span class="shot-tag">{s.ip}</span>
            </button>
            <div class="skin-meta">
              <span class="skin-name">{s.name}</span>
              <span class="skin-tag">{s.ip} · 源码级</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    {grouped.map((g) => (
      <div class="skin-group">
        <h2 style="margin-top:36px" id={`group-${g.name}`}>{g.name} <span class="muted small">({g.count})</span></h2>
        <div class="skin-grid">
          {g.skins.map((s) => (
            <div class="skin-card" style={`--accent:${s.accent}`}>
              <button class="skin-shot" type="button" aria-label={`${s.name} — 点击切换日间/夜间`}>
                <img src={thumb(s, 'light')} alt={`${s.name} 日间预览`} loading="lazy" width="320" height="200">
                <img src={thumb(s, 'dark')} alt={`${s.name} 夜间预览`} loading="lazy" width="320" height="200" class="shot-night">
                <span class="shot-tag" data-day="日间" data-night="夜间">日间</span>
              </button>
              <div class="skin-meta">
                <span class="skin-name">{s.name}</span>
                <span class="skin-tag">{s.tagline || s.group}</span>
                <div class="skin-cmd">
                  <code>dsh plugin add ./dsh-themes/skins/{s.id}</code>
                  <button type="button" class="cmd-copy" data-cmd={`dsh plugin add ./dsh-themes/skins/${s.id}`}>复制</button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

    <h2 style="margin-top:32px">关于皮肤系统</h2>
    <p>DSH 的外观是插件驱动的——皮肤本身就是插件。<code>dsh-themes</code> 打包了 {skins.length} 对皮肤（每对含日间 + 夜间变体），上方每张预览都是皮肤真实套到 Web UI 上的截图。它是 dsh-suite 生态的一部分，MIT 许可。</p>
    <p>版本、安装状态、实测结果见<a href="/zh/plugins/dsh-themes/">插件目录</a>。</p>

    <p style="margin-top:24px"><a class="btn btn-ghost" href={directoryUrl}>浏览全部插件 &rarr;</a></p>
  </section>
</Base>

<style>
  .skin-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; margin-top: 16px; }
  .skin-grid.featured { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .skin-card { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: #fff; }
  .skin-shot { position: relative; display: block; width: 100%; padding: 0; margin: 0; border: none; cursor: pointer; background: #0b0d14; line-height: 0; }
  .skin-shot img { display: block; width: 100%; height: auto; aspect-ratio: 16/10; object-fit: cover; background: linear-gradient(160deg, var(--accent) 0%, #ffffff 100%); }
  .skin-shot img.shot-night { display: none; background: linear-gradient(160deg, var(--accent) 0%, #0b0d14 100%); }
  .skin-shot.is-night img { display: none; }
  .skin-shot.is-night img.shot-night { display: block; }
  .shot-tag {
    position: absolute; right: 6px; bottom: 6px;
    font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    color: #fff; background: rgba(15, 23, 42, .62); border: 1px solid rgba(255,255,255,.22);
    border-radius: 999px; padding: 2px 8px; pointer-events: none;
  }
  .skin-meta { padding: 12px 14px 14px; }
  .skin-name { display: block; font-size: 14px; font-weight: 700; color: var(--ink); }
  .skin-tag { display: block; font-size: 12px; color: var(--ink-2); margin-top: 3px; line-height: 1.4; }
  .skin-group h2 { font-size: 20px; }
  .callout { border: 1px solid var(--border); border-left: 3px solid var(--primary); background: var(--primary-soft); border-radius: 10px; padding: 12px 16px; margin: 18px 0 0; }
  .skin-cmd { display: flex; align-items: center; gap: 6px; margin-top: 10px; }
  .skin-cmd code { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; background: var(--bg-soft); border: 1px solid var(--border); border-radius: 7px; padding: 4px 8px; color: var(--ink-2); }
  .skin-cmd button { flex: none; font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 7px; background: #fff; border: 1px solid var(--border-strong); color: var(--ink-2); cursor: pointer; }
  .skin-cmd button:hover { border-color: var(--primary); color: var(--primary-600); }
  .shot-frame { position: relative; display: block; width: 100%; padding: 0; margin: 0; border: none; cursor: zoom-in; background: #0b0d14; line-height: 0; }
  .shot-frame img { display: block; width: 100%; height: auto; aspect-ratio: 16/10; object-fit: cover; }
  .shot-frame:hover img { filter: brightness(1.05); }
</style>

<script>
  document.querySelectorAll('.skin-shot').forEach((btn) => {
    btn.addEventListener('click', () => {
      btn.classList.toggle('is-night');
      const tag = btn.querySelector('.shot-tag');
      if (tag) tag.textContent = btn.classList.contains('is-night') ? tag.dataset.night : tag.dataset.day;
    });
  });

  document.querySelectorAll('.cmd-copy').forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(btn.getAttribute('data-cmd')); btn.textContent = '已复制!'; }
      catch (e) { btn.textContent = '失败'; }
      setTimeout(() => { btn.textContent = label; }, 1500);
    });
  });
</script>
