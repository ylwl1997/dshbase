---
import Base from '../../../layouts/Base.astro';
import plugins from '../../../data/plugins.json';
import syncDate from '../../../data/sync-date.json';
const catLabels = {
  'UI Enhancements': '界面增强',
  'Sessions & Messages': '会话与消息',
  'Tools & Capabilities': '工具与能力',
  'Workflow & Automation': '工作流与自动化',
  'Notifications & Integrations': '通知与集成',
  'Development & Runtime': '开发与运行时',
  'Just for Fun': '趣味',
};
const catOrder = Object.keys(plugins);
// sort each category by stars desc
const sortByStars = (a, b) => (b.stars ?? 0) - (a.stars ?? 0);
catOrder.forEach((k) => plugins[k].sort(sortByStars));
const total = catOrder.reduce((s, k) => s + plugins[k].length, 0);
const all = catOrder.flatMap((k) => plugins[k]);
const nVerified = all.filter((p) => p.test === 'verified').length;
const nPending = all.filter((p) => p.test === 'pending').length;
const nBroken = all.filter((p) => p.test === 'broken').length;
const nNpm = all.filter((p) => p.npm).length;

// 分类分布（堆叠条）
const catDist = catOrder.map((cat) => [catLabels[cat] || cat, plugins[cat].length]);

// 增长曲线：按收录日期累计
const byDay = {};
all.forEach((p) => { const d = p.added; if (d) byDay[d] = (byDay[d] || 0) + 1; });
let _cum = 0;
const growth = Object.keys(byDay).sort().map((d) => { _cum += byDay[d]; return [d.slice(5), _cum]; });
const maxG = growth.length ? growth[growth.length - 1][1] : 1;
const GW = 800, GH = 170;
const gPadL = 24, gPadR = 24, gPadT = 22, gPadB = 32;
const gPlotW = GW - gPadL - gPadR;
const gPlotH = GH - gPadT - gPadB;
const gX = (i) => gPadL + (i / Math.max(growth.length - 1, 1)) * gPlotW;
const gY = (v) => gPadT + (1 - v / maxG) * gPlotH;
const gPts = growth.map(([, v], i) => [gX(i), gY(v)]);
const gLine = gPts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const gArea = `${gPadL},${GH - gPadB} ${gLine} ${GW - gPadR},${GH - gPadB}`;

// 大分类 tab：热门（按 stars）+ 新收录（按 added 日期）
const hotPlugins = [...all].sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0)).slice(0, 60);
const newPlugins = [...all].sort((a, b) => (b.added || '').localeCompare(a.added || '')).slice(0, 60);

const repo = (u) => u.replace('https://github.com/', '');
const npmHome = (p) => p.pkg ? `https://www.npmjs.com/package/${p.pkg}` : '';
const isFeatured = (p) => (p.stars ?? 0) >= 100 && p.test !== 'broken';
const statusLabel = {
  verified: '已验证',
  pending: '待验证',
  broken: '异常',
};
const statusClass = {
  verified: 'st-ok',
  pending: 'st-warn',
  broken: 'st-broken',
};
---
<Base title={`DeepSeek Harness 插件目录 — ${total} 个插件、含实测结果与安装命令 | dshbase 中文`} description={`DeepSeek Harness（dsh）插件生态目录：${catOrder.length} 大类 ${total} 个插件，每张卡片标注 npm 可装状态、实测结果与安装命令，来自 awesome-dsh-plugin 精选列表。`} currentPath="/plugins/directory/">
  <section class="hero wrap">
    <p class="eyebrow">插件目录</p>
    <h1>DeepSeek Harness <span class="accent">插件生态</span></h1>
    <p class="lede">来自 <a href="https://github.com/awesome-dsh-plugin/awesome-dsh-plugin" target="_blank" rel="noopener">awesome-dsh-plugin</a> 精选列表——{catOrder.length} 大类、{total} 个插件。每张卡片直接标注插件是否<strong>已发布到 npm</strong>、<strong>实测结果</strong>和<strong>安装命令</strong>，不用点进仓库再确认。</p>
    <p style="margin-top:14px"><a class="btn btn-primary" href="https://github.com/ylwl1997/dshbase/issues/new?template=plugin-submission.yml" target="_blank" rel="noopener">提交你的插件 &rarr;</a> <a class="btn btn-ghost" href="https://github.com/deepseek-ai/deepseek-harness/discussions" target="_blank" rel="noopener">官方社区 &rarr;</a></p>
    <div class="agent-box">
      <div class="agent-slides">
        <a class="agent-slide" href="/zh/plugins/dshbase-catalog/"><strong>🤖 dshbase-catalog</strong> — 让 agent 自己查目录：<code>dsh plugin add dshbase-catalog</code></a>
        <a class="agent-slide" href="/zh/plugins/dsh-browser-bsk/"><strong>🌐 dsh-browser-bsk</strong> — 浏览器自动化：<code>dsh plugin add dsh-browser-bsk</code></a>
        <a class="agent-slide" href="/zh/plugins/noatmark-dsh-plugin/"><strong>🧹 noatmark-dsh-plugin</strong> — 文本卫生工具：<code>dsh plugin add noatmark-dsh-plugin</code></a>
        <a class="agent-slide" href="/zh/plugins/modlens/"><strong>⭐ modlens</strong> — 最热门的视觉插件：<code>dsh plugin add modlens</code></a>
        <a class="agent-slide" href="/zh/plugins/dsh-cc-tui/"><strong>⭐ dsh-cc-tui</strong> — 终端 UI：<code>dsh plugin add github:ccch1mneyyy/dsh-cc-tui</code></a>
      </div>
    </div>
  </section>
  <section class="info wrap">
    <p class="stats-line">实测于 dsh 0.1.0-rc.6——每张卡片标注实测状态与安装命令。GitHub 源码插件用 <code>dsh plugin add github:owner/repo</code> 安装。</p>
    <div class="eco">
      <div class="statline">
        <div class="stat"><b>{total.toLocaleString('en-US')}</b><span>插件总数</span></div>
        <div class="stat"><b>{nVerified}</b><span>已验证</span></div>
        <div class="stat"><b>{nPending}</b><span>待验证</span></div>
        <div class="stat"><b>{nBroken}</b><span>异常</span></div>
        <div class="stat"><b>{nNpm}</b><span>npm 可装</span></div>
      </div>
      <div class="eco-cards">
        <div class="eco-card">
          <h3 class="eco-title">增长曲线</h3>
          <svg class="growth-svg" viewBox={`0 0 ${GW} ${GH}`} role="img" aria-label="插件收录增长曲线">
            <defs>
              <linearGradient id="gfill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#4D6BFE" stop-opacity="0.16" />
                <stop offset="100%" stop-color="#4D6BFE" stop-opacity="0" />
              </linearGradient>
            </defs>
            <polygon points={gArea} fill="url(#gfill)" />
            <polyline points={gLine} fill="none" stroke="#4D6BFE" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            {gPts.map(([x, y], i) => (
              <g>
                <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="4.5" fill="#fff" stroke="#4D6BFE" stroke-width="2.5">
                  <title>{growth[i][0]} — {growth[i][1]} 个插件</title>
                </circle>
                <text class="g-val" x={x.toFixed(1)} y={(y - 11).toFixed(1)} text-anchor="middle">{growth[i][1]}</text>
              </g>
            ))}
            {growth.map(([d], i) => (
              <text class="g-tick" x={gX(i).toFixed(1)} y={GH - gPadB + 18} text-anchor="middle">{d}</text>
            ))}
          </svg>
        </div>
        <div class="eco-card">
          <h3 class="eco-title">分类分布</h3>
          <div class="cat-bar">
            {catDist.map(([cat, n], i) => {
              const colors = ['#4D6BFE', '#7c8cf8', '#8b5cf6', '#a78bfa', '#6366f1', '#93c5fd', '#c4b5fd'];
              return <div class="cat-seg" style={`width:${(n / total) * 100}%;background:${colors[i % colors.length]}`} title={`${cat}: ${n}`}></div>;
            })}
          </div>
          <div class="cat-legend">
            {catDist.map(([cat, n], i) => {
              const colors = ['#4D6BFE', '#7c8cf8', '#8b5cf6', '#a78bfa', '#6366f1', '#93c5fd', '#c4b5fd'];
              return <span class="cat-item"><span class="cat-dot" style={`background:${colors[i % colors.length]}`}></span>{cat} <b>{n}</b></span>;
            })}
          </div>
        </div>
      </div>
      <p class="eco-note">数据源：GitHub dsh-plugin topic · 更新于 {syncDate.updated}</p>
    </div>
    <div class="top-plugins">
      <div class="tp-head">🔥 按 Stars 热门 Top 10</div>
      <div class="tp-grid">
        {[...all].sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0)).slice(0, 10).map((t, i) => (
          <a class="tp-item" href={`/zh/plugins/${t.name}/`}>
            <span class="tp-rank">{i + 1}</span>
            <span class="tp-name">{t.name}</span>
            <span class="tp-stars" data-stars-name={t.name}>★{t.stars ?? 0}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="nav-toolbar">
      <div class="big-tabs" role="tablist" aria-label="合集">
        <button class="btab is-active" data-tab="all">全部</button>
        <button class="btab" data-tab="hot">🔥 热门</button>
        <button class="btab" data-tab="new">🆕 新收录</button>
      </div>
      <div class="cat-nav">
        {catOrder.map((cat) => (
          <button class="chip" data-cat={cat.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{catLabels[cat] || cat}</button>
        ))}
      </div>
      <div class="filter-bar" role="group" aria-label="筛选插件">
        <button class="fbtn is-active" data-filter="all">全部 <span class="fcount">{total}</span></button>
        <button class="fbtn" data-filter="verified">已验证 <span class="fcount">{nVerified}</span></button>
        <button class="fbtn" data-filter="pending">待验证 <span class="fcount">{nPending}</span></button>
        <button class="fbtn" data-filter="broken">异常 <span class="fcount">{nBroken}</span></button>
      </div>
    </div>
    <div id="cat-sections">
    {catOrder.map((cat) => {
      const catId = cat.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      return (
      <Fragment>
        <h3 id={catId} class="cat-head" style="margin-top:26px">{catLabels[cat] || cat} <span class="muted" style="font-size:13px;font-weight:400">({plugins[cat].length})</span></h3>
        <div class="grid3">
          {plugins[cat].map((p) => {
            const r = repo(p.url);
            return (
              <a class="card pcard" href={`/zh/plugins/${p.name}/`} data-test={p.test} data-npm={p.npm ? '1' : '0'}>
                <div class="pcard-head">
                  <span class="pcard-name">{p.name}{isFeatured(p) ? ' ⭐' : ''}</span>
                  <span class={`badge ${statusClass[p.test]}`}>{statusLabel[p.test]}</span>
                </div>
                <p class="pcard-repo">{r}</p>
                {(p.desc_zh || p.desc) && <p class="pcard-desc">{p.desc_zh || p.desc}</p>}
                <div class="pcard-install">
                  {p.npm && p.pkg ? (
                    <pre class="code-block install-chip"><code>dsh plugin add {p.pkg}</code></pre>
                  ) : (
                    <span class="muted small">GitHub 源码</span>
                  )}
                  <span class="view-link">查看详情 &rarr;</span>
                </div>
              </a>
            );
          })}
        </div>
      </Fragment>
      );
    })}
    </div>
    <div id="hot-panel" hidden>
      <h3 class="cat-head" style="margin-top:26px">🔥 热门插件 <span class="muted" style="font-size:13px;font-weight:400">(按 stars 前 {hotPlugins.length})</span></h3>
      <div class="grid3">
        {hotPlugins.map((p) => {
          const r = repo(p.url);
          return (
            <a class="card pcard" href={`/zh/plugins/${p.name}/`} data-test={p.test} data-npm={p.npm ? '1' : '0'}>
              <div class="pcard-head">
                <span class="pcard-name">{p.name}{isFeatured(p) ? ' ⭐' : ''}</span>
                <span class={`badge ${statusClass[p.test]}`}>{statusLabel[p.test]}</span>
              </div>
              <p class="pcard-repo">{r}</p>
              {(p.desc_zh || p.desc) && <p class="pcard-desc">{p.desc_zh || p.desc}</p>}
              <div class="pcard-install">
                {p.npm && p.pkg ? (
                  <pre class="code-block install-chip"><code>dsh plugin add {p.pkg}</code></pre>
                ) : (
                  <span class="muted small">GitHub 源码</span>
                )}
                <span class="view-link">查看详情 &rarr;</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
    <div id="new-panel" hidden>
      <h3 class="cat-head" style="margin-top:26px">🆕 新收录 <span class="muted" style="font-size:13px;font-weight:400">(最近 {newPlugins.length})</span></h3>
      <div class="grid3">
        {newPlugins.map((p) => {
          const r = repo(p.url);
          return (
            <a class="card pcard" href={`/zh/plugins/${p.name}/`} data-test={p.test} data-npm={p.npm ? '1' : '0'}>
              <div class="pcard-head">
                <span class="pcard-name">{p.name}{isFeatured(p) ? ' ⭐' : ''}</span>
                <span class={`badge ${statusClass[p.test]}`}>{statusLabel[p.test]}</span>
              </div>
              <p class="pcard-repo">{r}</p>
              {(p.desc_zh || p.desc) && <p class="pcard-desc">{p.desc_zh || p.desc}</p>}
              <div class="pcard-install">
                {p.npm && p.pkg ? (
                  <pre class="code-block install-chip"><code>dsh plugin add {p.pkg}</code></pre>
                ) : (
                  <span class="muted small">GitHub 源码</span>
                )}
                <span class="view-link">查看详情 &rarr;</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>

<style>
  .pcard { display: flex; flex-direction: column; gap: 8px; text-decoration: none; color: inherit; }
  .pcard:hover { border-color: var(--primary); transform: translateY(-2px); box-shadow: var(--shadow-md, 0 8px 24px rgba(0,0,0,.08)); }
  .pcard-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
  .pcard-name { font-weight: 700; font-size: 15px; color: var(--ink); }
  .pcard-repo { font-size: 12px; color: var(--ink-3); font-family: var(--mono, monospace); }
  .pcard-desc { font-size: 13px; color: var(--ink-2); margin: 0; line-height: 1.55; }
  .pcard-install { margin-top: auto; display: flex; flex-direction: column; gap: 6px; }
  .view-link { font-size: 13px; font-weight: 600; color: var(--primary); }
  .pcard:hover .view-link { text-decoration: underline; }
  .nav-toolbar { position: sticky; top: 0; z-index: 30; background: var(--bg); padding: 12px 0 8px; margin: 18px 0 0; border-bottom: 1px solid var(--border); }
  .big-tabs { display: flex; gap: 10px; justify-content: center; margin-bottom: 12px; }
  .btab { font-size: 14px; font-weight: 600; padding: 8px 22px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-card); color: var(--ink-2); cursor: pointer; }
  .btab.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .cat-nav { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 0 0 8px; }
  .chip { font-size: 11.5px; color: var(--ink-2); border: 1px solid var(--border); border-radius: 999px; padding: 4px 10px; background: var(--bg-card); cursor: pointer; font-family: inherit; }
  .chip:hover { color: var(--primary); border-color: var(--primary); }
  .chip.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .filter-bar { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 0; }
  .fbtn { font-size: 12px; padding: 5px 12px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-card); color: var(--ink-2); cursor: pointer; }
  .fbtn.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .fcount { opacity: .7; font-size: 12px; }
  .pcard[hidden] { display: none; }
  .cat-head[hidden] { display: none; }
  .top-plugins { margin: 22px 0 6px; }
  .tp-head { font-size: 14px; font-weight: 700; color: var(--ink); margin-bottom: 10px; }
  .tp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; }
  .tp-item { display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; text-decoration: none; color: inherit; font-size: 13px; }
  .tp-item:hover { border-color: var(--primary); }
  .tp-rank { font-weight: 800; color: var(--primary); font-size: 12px; min-width: 14px; }
  .tp-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tp-stars { color: #b45309; font-weight: 600; }
  .install-chip { margin: 0; font-size: 12px; padding: 6px 10px; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 6px; color: #334155; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .badge { font-size: 11px; padding: 3px 9px; white-space: nowrap; }
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; }
  .st-ok { color: #1a7f37; border-color: #b7e0c0; background: #f0fff4; }
  .st-ok .dot { background: #1a7f37; }
  .st-src { color: var(--ink-2); background: #f7f8fa; }
  .st-src .dot { background: #9aa1ad; }
  .st-warn { color: #9a6700; border-color: #e5c27a; background: #fff8e6; }
  .st-warn .dot { background: #d4a72c; }
  .st-broken { color: #c62828; border-color: #f0b9b9; background: #fff1f1; }
  .st-broken .dot { background: #c62828; }
  .legend .badge { color: var(--ink-2); }
  .stats-line { font-size: 14px; color: var(--ink-2); margin: 18px 0 0; text-align: center; }
  .agent-box { font-size: 13.5px; color: var(--ink-2); background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 12px 16px; margin: 14px 0 0; overflow: hidden; }
  .agent-slides { position: relative; }
  .agent-slide { display: none; text-decoration: none; color: inherit; cursor: pointer; }
  .agent-slide.is-active { display: block; animation: fadeIn .4s; }
  .agent-slide:hover strong { text-decoration: underline; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .c-ok { color: #1a7f37; }
  .c-warn { color: #9a6700; }
  .eco { margin: 20px 0 8px; }
  .statline { display: flex; flex-wrap: wrap; gap: 8px 36px; justify-content: center; padding: 16px 0; border-bottom: 1px solid var(--border); }
  .stat { display: flex; flex-direction: column; align-items: center; line-height: 1.25; }
  .stat b { font-size: 20px; font-weight: 800; color: var(--primary); }
  .stat span { font-size: 12px; color: var(--ink-3); }
  .eco-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
  .eco-card { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; }
  .eco-title { font-size: 13px; font-weight: 700; color: var(--ink-2); margin: 0 0 14px; }
  .growth-svg { width: 100%; display: block; }
  .g-val { font-size: 11px; font-weight: 700; fill: var(--ink); }
  .g-tick { font-size: 11px; fill: var(--ink-3); }
  .cat-bar { display: flex; height: 22px; border-radius: 6px; overflow: hidden; gap: 2px; background: #eef1f6; }
  .cat-seg { height: 100%; min-width: 3px; }
  .cat-legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 14px; }
  .cat-item { font-size: 12px; color: var(--ink-2); display: inline-flex; align-items: center; gap: 5px; }
  .cat-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .cat-item b { color: var(--ink); font-weight: 700; }
  .eco-note { text-align: center; font-size: 12px; color: var(--ink-3); margin: 14px 0 0; }
  @media (max-width: 640px) { .eco-cards { grid-template-columns: 1fr; } }
</style>

<script>
  // 推荐插件轮播
  (() => {
    const slides = document.querySelectorAll('.agent-slide');
    if (slides.length < 2) return;
    let i = 0;
    slides[0].classList.add('is-active');
    setInterval(() => {
      slides[i].classList.remove('is-active');
      i = (i + 1) % slides.length;
      slides[i].classList.add('is-active');
    }, 3500);
  })();

  const filterBtns = document.querySelectorAll('.fbtn');
  const tabs = document.querySelectorAll('.btab');
  const chips = document.querySelectorAll('.chip');
  const cards = document.querySelectorAll('.pcard');
  const catHeads = document.querySelectorAll('#cat-sections .cat-head');
  const catSections = document.getElementById('cat-sections');
  const hotPanel = document.getElementById('hot-panel');
  const newPanel = document.getElementById('new-panel');
  const match = (card, f) => {
    const t = card.dataset.test;
    if (f === 'all') return true;
    if (f === 'verified') return t === 'verified';
    if (f === 'pending') return t === 'pending';
    if (f === 'broken') return t === 'broken';
    return true;
  };

  let activeTab = 'all';
  let activeCat = null;
  let activeFilter = 'all';

  function applyFilters() {
    catSections.hidden = activeTab !== 'all';
    hotPanel.hidden = activeTab !== 'hot';
    newPanel.hidden = activeTab !== 'new';
    cards.forEach((c) => { c.hidden = !match(c, activeFilter); });
    catHeads.forEach((h) => {
      const grid = h.nextElementSibling;
      const inCat = !activeCat || h.id === activeCat;
      let anyVisible = false;
      if (grid) grid.querySelectorAll('.pcard').forEach((c) => { if (!c.hidden) anyVisible = true; });
      const show = inCat && anyVisible;
      h.hidden = !show;
      if (grid) grid.hidden = !show;
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      activeFilter = btn.dataset.filter;
      applyFilters();
    });
  });

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('is-active'));
      tab.classList.add('is-active');
      activeTab = tab.dataset.tab;
      applyFilters();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const catId = chip.dataset.cat;
      if (activeCat === catId) {
        activeCat = null;
        chips.forEach((c) => c.classList.remove('is-active'));
      } else {
        activeCat = catId;
        chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      }
      applyFilters();
    });
  });
</script>
