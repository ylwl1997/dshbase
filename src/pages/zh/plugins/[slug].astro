---
import Base from '../../../layouts/Base.astro';
import plugins from '../../../data/plugins.json';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { readFileSync, existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

let buildsMap: Record<string, string> = {};
try {
  if (existsSync('public/builds/manifest.json')) {
    const manifest = JSON.parse(readFileSync('public/builds/manifest.json', 'utf-8'));
    for (const b of manifest) {
      if (b.status === 'OK') buildsMap[b.name] = b.file;
    }
  }
} catch {}

export function getStaticPaths() {
  return Object.entries(plugins).flatMap(([cat, items]) =>
    items.map((p) => ({ params: { slug: p.name }, props: { cat, p } }))
  );
}

const { cat, p } = Astro.props;
const catId = cat.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const dirUrl = getRelativeLocaleUrl('zh', '/plugins/directory/');
const catUrl = `${dirUrl}#${catId}`;
const repo = p.url.replace('https://github.com/', '');
const npmHome = p.pkg ? `https://www.npmjs.com/package/${p.pkg}` : '';
const statusLabel = {
  ok: '已验证 · 可安装并启动',
  'git-ok': 'GitHub · 已验证（可安装启动）',
  'git-build': 'GitHub · 需构建步骤',
  'git-ui': 'GitHub · 需 Web/TUI 界面',
  'git-fail': '安装失败',
  ui: '可安装 · 需 Web/TUI 界面',
  'load-fail': '加载异常',
  'install-fail': '安装失败（依赖未发 npm）',
  'not-on-npm': '仅 GitHub 源码',
};
const statusClass = {
  ok: 'st-ok',
  'git-ok': 'st-ok',
  'git-build': 'st-warn',
  'git-ui': 'st-warn',
  'git-fail': 'st-warn',
  ui: 'st-warn',
  'load-fail': 'st-warn',
  'install-fail': 'st-warn',
  'not-on-npm': 'st-src',
};
const desc = p.desc_zh || p.desc || `${cat} 类别的 DeepSeek Harness 插件。`;
const fmt = (n) => (n >= 1000 ? (n / 1000).toFixed(1) + 'k' : String(n ?? 0));
const stars = p.stars ?? 0;
const verdict = p.archived
  ? { label: '已归档 — 不再维护，谨慎使用', cls: 'v-warn', icon: '⚠️' }
  : p.test === 'ok' || p.test === 'git-ok'
    ? stars >= 100
      ? { label: '推荐 — 实测可用且热门', cls: 'v-ok', icon: '✅' }
      : stars >= 20
        ? { label: '可用 — 实测通过，社区增长中', cls: 'v-ok', icon: '✅' }
        : { label: '可用 — 实测通过，早期项目', cls: 'v-ok', icon: '✅' }
    : p.test === 'ui' || p.test === 'git-ui'
      ? { label: '界面插件 — 可安装激活，需 Web/TUI 界面', cls: 'v-warn', icon: '🖥️' }
      : p.test === 'git-build'
        ? { label: '可安装 — 需构建步骤（pnpm allowBuilds）', cls: 'v-warn', icon: '🔧' }
        : p.test === 'install-fail' || p.test === 'git-fail'
        ? { label: '安装异常 — 依赖未发布到 npm', cls: 'v-warn', icon: '⚠️' }
        : stars >= 50
          ? { label: '源码插件 — 活跃项目，从 GitHub 安装', cls: 'v-src', icon: '📦' }
          : stars >= 10
            ? { label: '源码插件 — 从 GitHub 安装', cls: 'v-src', icon: '📦' }
            : { label: '源码插件 — 早期项目，从 GitHub 安装', cls: 'v-src', icon: '📦' };
const review = p.archived
  ? `该插件已归档、不再维护——除非你愿意自己维护，否则慎用。`
  : p.test === 'ok' || p.test === 'git-ok'
    ? `${desc} 实测能干净安装、正常启动${p.test === 'git-ok' ? '（从 GitHub 源码）' : ''}。${stars >= 100 ? `${stars}+ stars，社区认可度高，是低风险选择。` : stars >= 20 ? `社区在增长，是个稳妥选择。` : `早期项目，但功能可用。`}`
    : p.test === 'ui' || p.test === 'git-ui'
      ? `${desc} 注意它是界面类插件——需要 Web/TUI 界面才能起效，在 \`dsh web\` 里测，别在 headless 下测。`
      : p.test === 'git-build'
        ? `${desc} 从 GitHub 源码安装，但带构建步骤（pnpm 默认阻止）——把提示的 \`allowBuilds\` key 加上，或拿预构建版。`
        : p.test === 'install-fail' || p.test === 'git-fail'
          ? `${desc} 注意：目前安装失败（依赖缺失或构建损坏）——依赖它之前先看仓库。`
          : `${desc} 以 GitHub 源码分发——用 \`dsh plugin add github:owner/repo\` 安装。`;
const related = (plugins[cat] || []).filter((x) => x.name !== p.name).slice(0, 6);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.name,
  description: desc,
  url: `https://dshbase.com/plugins/${p.name}/`,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  ...(p.ver ? { softwareVersion: p.ver } : {}),
  ...(p.stars > 0 ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: p.stars, bestRating: 1000, ratingCount: p.stars } } : {}),
};
---
<Base title={`${p.name} — DSH 插件安装指南与兼容性评估 | dshbase 中文`} description={`${desc} — 如何安装 ${p.name}（${p.npm ? `dsh plugin add ${p.pkg}` : 'npm 源码'}）及其与 dsh 0.1.0-rc.6 的兼容性。`} currentPath={`/plugins/${p.name}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="hero wrap">
    <p class="eyebrow"><a href={dirUrl}>插件目录</a> / <a href={catUrl}>{cat}</a> / {p.name}</p>
    <h1>{p.name}</h1>
    <p class="lede">
      <span class={`badge ${statusClass[p.test]}`}>{statusLabel[p.test]}</span>{' '}
      <a href={p.url} target="_blank" rel="noopener">{repo} ↗</a>
    </p>
    <p style="margin-top:14px"><a class="btn btn-ghost btn-sm" href={dirUrl}>&larr; 返回插件目录</a></p>
  </section>

  <section class="wrap">
    <div class="metrics">
      <div class="metric"><span class="m-val" data-stars-name={p.name} data-stats-kind="stars">{p.stars ?? 0}</span><span class="m-lab">Stars</span></div>
      <div class="metric"><span class="m-val" data-stars-name={p.name} data-stats-kind="forks">{p.forks ?? 0}</span><span class="m-lab">Forks</span></div>
      <div class="metric"><span class="m-val" data-stars-name={p.name} data-stats-kind="issues">{p.issues ?? 0}</span><span class="m-lab">未关闭 issue</span></div>
      <div class="metric"><span class="m-val">{p.language || '—'}</span><span class="m-lab">语言</span></div>
      <div class="metric"><span class="m-val">{p.updated || '—'}</span><span class="m-lab">最近推送</span></div>
    </div>
  </section>

  <section class="info wrap">
    <h2>功能简介</h2>
    <p class="what-it-does">{desc}</p>

    <div class={`verdict ${verdict.cls}`}>
      <span class="v-icon">{verdict.icon}</span>
      <div><strong>我们的评价</strong><br/>{verdict.label}</div>
    </div>
    <p class="review-text">{review}</p>

    {p.npm && p.pkg ? (
      <Fragment>
        <h2>安装</h2>
        <pre class="code-block"><code>dsh plugin --profile web add {p.pkg}</code></pre>
        <ol class="steps">
          <li>先装 pnpm：<code>npm install -g pnpm</code>（插件管理会调用它）。</li>
          <li>装进 web profile：<code>dsh plugin --profile web add {p.pkg}</code>。</li>
          <li>重启 <code>dsh web</code>——下次启动自动加载。</li>
          <li>验证：<code>dsh plugin --profile web list</code>。</li>
        </ol>
        <h2 style="margin-top:24px">包信息</h2>
        <p>npm：<a href={npmHome} target="_blank" rel="noopener">{p.pkg}</a> · 版本 <strong>{p.ver || '—'}</strong> · 实测环境 dsh <strong>0.1.0-rc.6</strong></p>
        <h2 style="margin-top:24px">实测报告</h2>
        <p>{p.test === 'ok' && '端到端验证通过：`dsh plugin add` 安装成功、进入 profile 配置树、启动任务正常。'}
           {p.test === 'ui' && '可安装并激活，但在 headless 测试环境无法启动——它需要 Web/TUI 界面。正常 `dsh web` 里应该能用。'}
           {p.test === 'install-fail' && '安装失败——依赖树里有包没发到 npm。可到仓库看是否有待发布的依赖。'}</p>
      </Fragment>
    ) : (
      <Fragment>
        <h2>安装</h2>
        <p>该插件是 <strong>GitHub 源码</strong>（未发 npm）——直接从仓库装：</p>
        <pre class="code-block"><code>dsh plugin --profile web add github:{repo}</code></pre>
        <ol class="steps">
          <li>先装 pnpm：<code>npm install -g pnpm</code>。</li>
          <li>从 GitHub 装：<code>dsh plugin --profile web add github:{repo}</code>。</li>
          <li>重启 <code>dsh web</code>。</li>
        </ol>
        <p class="muted small">注：带 <code>prepare</code> 构建脚本的插件，pnpm 会要求确认——把提示的 key 加进 <code>pnpm-workspace.yaml</code> 的 <code>allowBuilds</code> 再重跑即可。</p>
        {buildsMap[p.name] && (
          <div class="build-box">
            <strong>⚡ 有预构建版</strong> — 跳过构建步骤，直接装编译好的版本：
            <pre class="code-block"><code>dsh plugin --profile web add https://dshbase.com/builds/{buildsMap[p.name]}</code></pre>
          </div>
        )}
        {p.test !== 'not-on-npm' && (
          <Fragment>
            <h2 style="margin-top:24px">实测报告</h2>
            <p>{p.test === 'git-ok' && '验证通过：从 GitHub 安装成功、进入配置树、启动任务正常。'}
               {p.test === 'git-ui' && '已安装并激活，但 headless 测试环境无法启动——需要 Web/TUI 界面，正常 `dsh web` 里应该能用。'}
               {p.test === 'git-build' && '安装需构建步骤：插件带 `prepare` 脚本，pnpm 默认阻止。把提示的 key 加进 `pnpm-workspace.yaml` 的 `allowBuilds` 再重跑。'}
               {p.test === 'git-fail' && '从 GitHub 安装失败——检查仓库是否有缺失依赖或损坏的构建。'}</p>
          </Fragment>
        )}
      </Fragment>
    )}

    <h2 style="margin-top:28px">仓库</h2>
    <p><a href={p.url} target="_blank" rel="noopener">github.com/{repo} ↗</a>{p.archived ? ' · <span class="muted">已归档</span>' : ''}</p>

    {related.length > 0 && (
      <Fragment>
        <h2 style="margin-top:28px">{cat} 里更多</h2>
        <div class="grid3">
          {related.map((r) => (
            <a class="card card-link" href={`/zh/plugins/${r.name}/`}>
              <h3>{r.name}</h3>
              <p>{r.test === 'ok' ? '✅ 已验证' : r.npm ? 'npm 可装' : 'GitHub 源码'} · ★{r.stars ?? 0}</p>
            </a>
          ))}
        </div>
        <p style="margin-top:16px"><a class="btn btn-ghost" href={dirUrl}>浏览全部 {Object.values(plugins).reduce((s, a) => s + a.length, 0)} 个插件 &rarr;</a></p>
      </Fragment>
    )}
  </section>
</Base>

<style>
  .badge { font-size: 13px; padding: 4px 12px; white-space: nowrap; }
  .st-ok { color: #1a7f37; border-color: #b7e0c0; background: #f0fff4; }
  .st-src { color: var(--ink-2); background: #f7f8fa; }
  .st-warn { color: #9a6700; border-color: #e5c27a; background: #fff8e6; }
  .what-it-does { font-size: 15px; line-height: 1.7; color: var(--ink); background: #f7f8fc; border-left: 3px solid var(--primary); padding: 14px 16px; border-radius: 8px; }
  .review-text { font-size: 14px; line-height: 1.7; color: var(--ink-2); margin: 10px 0 4px; }
  .build-box { font-size: 13.5px; color: var(--ink-2); background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 12px 16px; margin: 14px 0; }
  .build-box .code-block { margin: 8px 0 0; }
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin: 4px 0; }
  .metric { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 12px; text-align: center; }
  .m-val { display: block; font-size: 20px; font-weight: 800; color: var(--ink); }
  .m-lab { font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .03em; }
  .verdict { display: flex; align-items: center; gap: 12px; margin: 18px 0 6px; padding: 14px 16px; border-radius: 10px; font-size: 14px; line-height: 1.5; }
  .v-icon { font-size: 22px; }
  .v-ok { background: #f0fff4; border: 1px solid #b7e0c0; color: #1a4d2e; }
  .v-warn { background: #fff8e6; border: 1px solid #e5c27a; color: #6b4d00; }
  .v-src { background: #f1f5f9; border: 1px solid #e2e8f0; color: #334155; }
</style>
