---
import Base from '../../../layouts/Base.astro';
import plugins from '../../../data/plugins.json';
import notes from '../../../data/plugin-notes.json';
import security from '../../../data/security.json';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { readFileSync, existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

let buildsMap: Record<string, string> = {};
try {
  if (existsSync('public/builds/manifest.json')) {
    const manifest = JSON.parse(readFileSync('public/builds/manifest.json', 'utf-8'));
    for (const b of manifest) {
      if (b.status === 'OK') buildsMap[b.name] = b.file;
    }
  }
} catch {}

export function getStaticPaths() {
  return Object.entries(plugins).flatMap(([cat, items]) =>
    items.map((p) => ({ params: { slug: p.slug ?? p.name }, props: { cat, p } }))
  );
}

const { cat, p } = Astro.props;
const note = notes[p.name];
const catId = cat.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const dirUrl = getRelativeLocaleUrl('zh', '/plugins/directory/');
const catUrl = `${dirUrl}#${catId}`;
const repo = p.url.replace('https://github.com/', '');
const npmHome = p.pkg ? `https://www.npmjs.com/package/${p.pkg}` : '';
const statusLabel = {
  verified: '已验证 · 实测可装',
  pending: '未测试',
};
const statusClass = {
  verified: 'st-ok',
  pending: 'st-warn',
};
const sec = security[p.name];
const riskLabel = { low: '低', medium: '中', high: '高', critical: '严重' };
const riskClass = { low: 'sec-low', medium: 'sec-med', high: 'sec-high', critical: 'sec-crit' };
const catLabel = { secrets: '硬编码密钥', 'dangerous-cmd': '危险命令', exfil: '外传回调', permissions: '越权访问' };
const badgeAlt = p.test === 'verified' ? 'dshbase 实测可装' : 'dshbase 已收录';
const badgeMd = `[![${badgeAlt}](https://dshbase.com/badges/${p.slug}.svg)](https://dshbase.com/zh/plugins/${p.slug}/)`;
const desc = p.desc_zh || p.desc || `${cat} 类别的 DeepSeek Harness 插件。`;
const fmt = (n) => (n >= 1000 ? (n / 1000).toFixed(1) + 'k' : String(n ?? 0));
const stars = p.stars ?? 0;
const verdict = p.archived
  ? { label: '已归档 — 不再维护，谨慎使用', cls: 'v-warn', icon: '⚠️' }
  : p.test === 'verified'
    ? stars >= 100
      ? { label: '推荐 — 实测可用且热门', cls: 'v-ok', icon: '✅' }
      : stars >= 20
        ? { label: '可用 — 实测通过，社区增长中', cls: 'v-ok', icon: '✅' }
        : { label: '可用 — 实测通过，早期项目', cls: 'v-ok', icon: '✅' }
    : { label: '未测试 — 尚未实测', cls: 'v-warn', icon: '⏳' };
const review = p.archived
  ? `该插件已归档、不再维护——除非你愿意自己维护，否则慎用。`
  : p.test === 'verified'
    ? `${desc} 实测能干净安装、正常启动。${stars >= 100 ? `${stars}+ stars，社区认可度高，是低风险选择。` : stars >= 20 ? `社区在增长，是个稳妥选择。` : `早期项目，但功能可用。`}`
    : `${desc} 尚未验证——请自行安装测试。`;
const related = (plugins[cat] || []).filter((x) => x.slug !== p.slug).slice(0, 6);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.name,
  description: desc,
  url: `https://dshbase.com/plugins/${p.slug}/`,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  ...(p.ver ? { softwareVersion: p.ver } : {}),
};
---
<Base title={`${p.name} — DSH 插件安装指南与兼容性评估 | dshbase 中文`} description={`${desc} — 如何安装 ${p.name}（${p.npm ? `dsh plugin add ${p.pkg}` : 'npm 源码'}）及其与 dsh 0.1.0-rc.6 的兼容性。`} currentPath={`/plugins/${p.slug}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="hero wrap">
    <p class="eyebrow"><a href={dirUrl}>插件目录</a> / <a href={catUrl}>{cat}</a> / {p.name}</p>
    <h1>{p.name}</h1>
    <p class="lede">
      <span class={`badge ${statusClass[p.test]}`}>{statusLabel[p.test]}</span>{' '}
      <a href={p.url} target="_blank" rel="noopener">{repo} ↗</a>
    </p>
    <p style="margin-top:14px"><a class="btn btn-ghost btn-sm" href={dirUrl}>&larr; 返回插件目录</a></p>
  </section>

  <section class="wrap">
    <div class="metrics">
      <div class="metric"><span class="m-val" data-stars-slug={p.slug} data-stats-kind="stars">{p.stars ?? 0}</span><span class="m-lab">Stars</span></div>
      <div class="metric"><span class="m-val" data-stars-slug={p.slug} data-stats-kind="forks">{p.forks ?? 0}</span><span class="m-lab">Forks</span></div>
      <div class="metric"><span class="m-val" data-stars-slug={p.slug} data-stats-kind="issues">{p.issues ?? 0}</span><span class="m-lab">未关闭 issue</span></div>
      <div class="metric"><span class="m-val">{p.language || '—'}</span><span class="m-lab">语言</span></div>
      <div class="metric"><span class="m-val">{p.updated || '—'}</span><span class="m-lab">最近推送</span></div>
    </div>
  </section>

  <section class="info wrap">
    <h2>功能简介</h2>
    <p class="what-it-does">{desc}</p>

    <div class={`verdict ${verdict.cls}`}>
      <span class="v-icon">{verdict.icon}</span>
      <div><strong>我们的评价</strong><br/>{verdict.label}</div>
    </div>
    <p class="review-text">{review}</p>

    <p class="honest-note">「{p.test === 'verified' ? '已验证' : '未测试'}」表示我们的自动化 CI{' '}
      {p.test === 'verified' ? (
        <Fragment>在干净 profile 里实际执行了 <code>dsh plugin add</code> 并启动成功——仅此而已</Fragment>
      ) : (
        '尚未安装过该插件'
      )}。功能描述与版本兼容性均为作者声明。这不是安全审计，也不代表对第三方代码的背书。</p>

    <div class="sec-box">
      {sec ? (
        <Fragment>
          <span class={`sec-badge ${riskClass[sec.risk]}`}>{sec.risk === 'low' ? '✓ ' : '⚠ '}{riskLabel[sec.risk]}风险</span>{' '}
          <span class="sec-meta">静态扫描 · {sec.files} 个文件 · {sec.scannedAt?.slice(0, 10)}</span>
          {sec.findings && sec.findings.length > 0 && (
            <ul class="sec-findings">
              {sec.findings.slice(0, 3).map((f) => (
                <li>{catLabel[f.cat] || f.cat} <span class="muted">({f.sev})</span></li>
              ))}
            </ul>
          )}
        </Fragment>
      ) : (
        <span class="sec-meta">安全：尚未扫描——我们的每日静态扫描将很快覆盖它。</span>
      )}
    </div>

    {note && (
      <Fragment>
        <h2 style="margin-top:24px">使用场景</h2>
        <p>{note.use_zh}</p>
        <h2>适合谁</h2>
        <p>{note.aud_zh}</p>
        <h2>二次开发建议</h2>
        <p>{note.dev_zh}</p>
      </Fragment>
    )}

    {p.npm && p.pkg ? (
      <Fragment>
        <h2>安装</h2>
        <pre class="code-block"><code>dsh plugin --profile web add {p.pkg}</code></pre>
        <ol class="steps">
          <li>先装 pnpm：<code>npm install -g pnpm</code>（插件管理会调用它）。</li>
          <li>装进 web profile：<code>dsh plugin --profile web add {p.pkg}</code>。</li>
          <li>重启 <code>dsh web</code>——下次启动自动加载。</li>
          <li>验证：<code>dsh plugin --profile web list</code>。</li>
        </ol>
        <h2 style="margin-top:24px">包信息</h2>
        <p>npm：<a href={npmHome} target="_blank" rel="noopener">{p.pkg}</a> · 版本 <strong>{p.ver || '—'}</strong> · 实测环境 dsh <strong>0.1.0-rc.6</strong></p>
        <h2 style="margin-top:24px">实测报告</h2>
        <p>{p.test === 'verified' && '端到端验证通过：`dsh plugin add` 安装成功、进入 profile 配置树、启动任务正常。'}
           {p.test === 'pending' && '尚未验证——请自行安装测试，或稍后回来查看。'}</p>
      </Fragment>
    ) : (
      <Fragment>
        <h2>安装</h2>
        <p>该插件是 <strong>GitHub 源码</strong>（未发 npm）——直接从仓库装：</p>
        <pre class="code-block"><code>dsh plugin --profile web add github:{repo}</code></pre>
        <ol class="steps">
          <li>先装 pnpm：<code>npm install -g pnpm</code>。</li>
          <li>从 GitHub 装：<code>dsh plugin --profile web add github:{repo}</code>。</li>
          <li>重启 <code>dsh web</code>。</li>
        </ol>
        <p class="muted small">注：带 <code>prepare</code> 构建脚本的插件，pnpm 会要求确认——把提示的 key 加进 <code>pnpm-workspace.yaml</code> 的 <code>allowBuilds</code> 再重跑即可。</p>
        {buildsMap[p.name] && (
          <div class="build-box">
            <strong>⚡ 有预构建版</strong> — 跳过构建步骤，直接装编译好的版本：
            <pre class="code-block"><code>dsh plugin --profile web add https://dshbase.com/builds/{buildsMap[p.name]}</code></pre>
          </div>
        )}
        {p.test !== 'not-on-npm' && (
          <Fragment>
            <h2 style="margin-top:24px">实测报告</h2>
            <p>{p.test === 'verified' && '验证通过：从 GitHub 安装成功、进入配置树、启动任务正常。'}
               {p.test === 'pending' && '尚未验证——请自行安装测试。'}</p>
          </Fragment>
        )}
      </Fragment>
    )}

    <h2 style="margin-top:28px">仓库</h2>
    <p><a href={p.url} target="_blank" rel="noopener">github.com/{repo} ↗</a>{p.archived ? ' · <span class="muted">已归档</span>' : ''}</p>

    <h2 style="margin-top:28px">分享徽章</h2>
    <p>把这段粘进你的 README——它会链回本页，测试状态变化时自动更新：</p>
    <pre class="code-block"><code>{badgeMd}</code></pre>
    <p><button type="button" class="btn btn-ghost btn-sm badge-copy" data-cmd={badgeMd}>复制徽章代码</button></p>
    <p><img src={`/badges/${p.slug}.svg`} alt={badgeAlt} width="210" height="20" style="height:20px" /></p>

    {related.length > 0 && (
      <Fragment>
        <h2 style="margin-top:28px">{cat} 里更多</h2>
        <div class="grid3">
          {related.map((r) => (
            <a class="card card-link" href={`/zh/plugins/${r.slug}/`}>
              <h3>{r.name}</h3>
              <p>{r.test === 'verified' ? '✅ 已验证' : r.test === 'pending' ? '⏳ 未测试' : r.npm ? 'npm 可装' : 'GitHub 源码'} · ★{r.stars ?? 0}</p>
            </a>
          ))}
        </div>
        <p style="margin-top:16px"><a class="btn btn-ghost" href={dirUrl}>浏览全部 {Object.values(plugins).reduce((s, a) => s + a.length, 0)} 个插件 &rarr;</a></p>
      </Fragment>
    )}
  </section>
</Base>

<style>
  .badge { font-size: 13px; padding: 4px 12px; white-space: nowrap; }
  .st-ok { color: #1a7f37; border-color: #b7e0c0; background: #f0fff4; }
  .st-src { color: var(--ink-2); background: #f7f8fa; }
  .st-warn { color: #9a6700; border-color: #e5c27a; background: #fff8e6; }
  .what-it-does { font-size: 15px; line-height: 1.7; color: var(--ink); background: #f7f8fc; border-left: 3px solid var(--primary); padding: 14px 16px; border-radius: 8px; }
  .review-text { font-size: 14px; line-height: 1.7; color: var(--ink-2); margin: 10px 0 4px; }
  .honest-note { font-size: 12.5px; line-height: 1.6; color: var(--ink-3); background: #f8fafc; border: 1px dashed var(--border); border-radius: 8px; padding: 10px 12px; margin: 12px 0; }
  .sec-box { font-size: 13px; line-height: 1.6; color: var(--ink-2); background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; margin: 12px 0; }
  .sec-badge { font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 6px; white-space: nowrap; }
  .sec-low { color: #1a7f37; background: #f0fff4; border: 1px solid #b7e0c0; }
  .sec-med { color: #9a6700; background: #fff8e6; border: 1px solid #e5c27a; }
  .sec-high { color: #b45309; background: #fff1e6; border: 1px solid #f5c6a0; }
  .sec-crit { color: #b91c1c; background: #fef2f2; border: 1px solid #fca5a5; }
  .sec-meta { font-size: 12px; color: var(--ink-3); }
  .sec-findings { margin: 8px 0 0; padding-left: 18px; font-size: 12.5px; color: var(--ink-2); }
  .build-box { font-size: 13.5px; color: var(--ink-2); background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 12px 16px; margin: 14px 0; }
  .build-box .code-block { margin: 8px 0 0; }
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin: 4px 0; }
  .metric { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 12px; text-align: center; }
  .m-val { display: block; font-size: 20px; font-weight: 800; color: var(--ink); }
  .m-lab { font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .03em; }
  .verdict { display: flex; align-items: center; gap: 12px; margin: 18px 0 6px; padding: 14px 16px; border-radius: 10px; font-size: 14px; line-height: 1.5; }
  .v-icon { font-size: 22px; }
  .v-ok { background: #f0fff4; border: 1px solid #b7e0c0; color: #1a4d2e; }
  .v-warn { background: #fff8e6; border: 1px solid #e5c27a; color: #6b4d00; }
  .v-src { background: #f1f5f9; border: 1px solid #e2e8f0; color: #334155; }
</style>

<script>
  document.querySelectorAll('.badge-copy').forEach((btn) => {
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(btn.dataset.cmd).then(() => {
        const orig = btn.textContent;
        btn.textContent = '✅ 已复制';
        setTimeout(() => { btn.textContent = orig; }, 1500);
      });
    });
  });
</script>
