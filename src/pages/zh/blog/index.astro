---
import Base from '../../../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
const locale = Astro.currentLocale ?? 'zh';
const posts = [
  { path: '/blog/vs-claude-code/', cat: '对比', zh: 'DeepSeek Harness vs Claude Code', desc_zh: '插件 vs MCP、开源 vs 闭源、价格与选择。' },
  { path: '/blog/why-deepseek-harness/', cat: '概念', zh: '为什么叫 Harness', desc_zh: 'Agent = Model + Harness、Cordis 内核与时间/空间可组合性。' },
  { path: '/blog/deepseek-harness-modes/', cat: '指南', zh: '四种模式', desc_zh: '标准 / PTC / 极简 / 创造——完整指南。' },
  { path: '/blog/deepseek-harness-session-log/', cat: '分析', zh: '只追加会话日志', desc_zh: '可观测、可审计、可复现的 Agent 调试。' },
  { path: '/blog/deepseek-harness-cost/', cat: '分析', zh: '成本与缓存', desc_zh: 'Harness 的选择如何让 token 成本差到 7 倍。' },
  { path: '/blog/deepseek-harness-review/', cat: '评测', zh: '上手体验与 V4 Pro 定价', desc_zh: '37k star、缓存价涨 12 倍、四模式与最佳社区插件。' },
  { path: '/blog/deepseek-harness-architecture/', cat: '架构', zh: '自进化 Agent', desc_zh: '一切皆插件、Cordis 与「现场造扳手」的创造模式。' },
  { path: '/blog/deepseek-harness-vs-codex/', cat: '对比', zh: 'vs Codex', desc_zh: 'Agent 预设 vs 场景模式、可重建会话与插件模型。' },
  { path: '/blog/pi-deepseek-cache/', cat: '分析', zh: 'Pi 与 99.93% 缓存命中率', desc_zh: '最小工具集 + 只追加会话 = 便宜的 DeepSeek。' },
];
---
<Base title="博客 — DeepSeek Harness 指南与分析 | dshbase 中文" description="DeepSeek Harness 文章：对比、深度解析与分析。" currentPath="/blog/">
  <section class="hero wrap">
    <p class="eyebrow">博客</p>
    <h1>DeepSeek Harness <span class="accent">文章</span></h1>
    <p class="lede">对比、深度解析与分析。</p>
  </section>
  <section class="info wrap">
    <div class="grid3">
      {posts.map((p) => (
        <a class="card card-link" href={getRelativeLocaleUrl(locale, p.path)}>
          <span class="cat">{p.cat}</span>
          <h3>{p.zh}</h3>
          <p>{p.desc_zh} <span class="arr">&rarr;</span></p>
        </a>
      ))}
    </div>
  </section>
</Base>
