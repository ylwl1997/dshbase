---
import Base from '../../../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
const locale = Astro.currentLocale ?? 'zh';
const posts = [
  { path: '/blog/wx-dsh-command-map/', cat: '指南', zh: "dsh 命令地图：安装者速查", desc_zh: "dsh 命令实用地图：Web UI、配置导出、模式、插件、权限与 rc.8 子代理。rc.x 会变，以最新文档为准。" },
  { path: '/blog/wx-orange-book-notes/', cat: '分析', zh: "安装者手记：DeepSeek Harness 橙皮书式拆解", desc_zh: "安装者视角：dump-config、只追加日志、创造模式风险、PTC 并不自动更省，以及已验证安装为何胜过 star 数。" },
  { path: '/blog/wx-rc8-multimodal/', cat: '指南', zh: "DeepSeek Harness rc.8：多模态输入与子代理捆绑", desc_zh: "rc.8 对安装者意味着什么：可配图像适配器、Claude Code/Codex 捆绑、Windows PTY，以及为什么已验证包仍然重要。" },
  { path: '/blog/dsh-rc8/', cat: '指南', zh: 'DeepSeek Harness 0.1.0-rc.8：Vision、Subagent 与已验证包', desc_zh: '枢纽：多模态叙事 vs 视觉 API 未就绪 vs packs；Claude Code/Codex 子代理。' },
  { path: '/blog/plugin-redefined/', cat: '概念', zh: '「一切皆插件」到底是什么意思', desc_zh: '会话、沙箱、文件系统也是可替换模块——以及为什么已验证安装很重要。' },
  { path: '/blog/harness-vs-benchmark/', cat: '分析', zh: '从 30.2% 到 96.2%：差距在 Harness', desc_zh: '同一权重、不同运行时。为什么只盯 V4 Pro 价格不够。' },
  { path: '/blog/first-day-with-dsh/', cat: '指南', zh: 'DeepSeek Harness 真实的第一天', desc_zh: 'dsh web、权限、模式、缓存——以及僵尸 Deep diving 陷阱。' },
  { path: '/blog/vs-cursor/', cat: '对比', zh: 'DeepSeek Harness vs Cursor（2026）', desc_zh: '更新：两边都有 Agent。开源 harness + CI vs AI IDE，以及怎么一起用。' },
  { path: '/blog/vs-claude-code/', cat: '对比', zh: 'DeepSeek Harness vs Claude Code', desc_zh: '插件 vs MCP、开源 vs 闭源、价格与选择。' },
  { path: '/blog/why-deepseek-harness/', cat: '概念', zh: '为什么叫 Harness', desc_zh: 'Agent = Model + Harness、Cordis 内核与时间/空间可组合性。' },
  { path: '/blog/deepseek-harness-modes/', cat: '指南', zh: '四种模式', desc_zh: '标准 / PTC / 极简 / 创造——完整指南。' },
  { path: '/blog/deepseek-harness-session-log/', cat: '分析', zh: '只追加会话日志', desc_zh: '可观测、可审计、可复现的 Agent 调试。' },
  { path: '/blog/deepseek-harness-cost/', cat: '分析', zh: '成本与缓存', desc_zh: 'Harness 的选择如何让 token 成本差到 7 倍。' },
  { path: '/blog/deepseek-harness-review/', cat: '评测', zh: '上手体验与 V4 Pro 定价', desc_zh: '37k star、缓存价涨 12 倍、四模式与最佳社区插件。' },
  { path: '/blog/deepseek-harness-architecture/', cat: '架构', zh: '自进化 Agent', desc_zh: '一切皆插件、Cordis 与「现场造扳手」的创造模式。' },
  { path: '/blog/deepseek-harness-vs-codex/', cat: '对比', zh: 'vs Codex', desc_zh: 'Agent 预设 vs 场景模式、可重建会话与插件模型。' },
  { path: '/blog/pi-deepseek-cache/', cat: '分析', zh: 'Pi 与 99.93% 缓存命中率', desc_zh: '最小工具集 + 只追加会话 = 便宜的 DeepSeek。' },
  { path: '/blog/dsh-vs-american-tools/', cat: '分析', zh: '冲击美国 Agent 工具', desc_zh: '5 天 15.8 万星——对 Claude Code、Codex、Cursor、Copilot 的冲击。' },
  { path: '/blog/deepseek-harness-comparison/', cat: '对比', zh: '横向对比 12 个编程工具', desc_zh: 'Claude Code、Codex、Cline、Pi、Reasonix、CodeWhale 等。' },
  { path: '/blog/dsh-plugin-philosophy/', cat: '概念', zh: '插件哲学：一切皆插件 vs 疲劳', desc_zh: 'DSH 与 VS Code、Claude Code 有何不同。' },
  { path: '/blog/dsh-self-evolving-software/', cat: '概念', zh: '自进化软件：福音还是灾难', desc_zh: '创造模式、Cordis 与 OpenClaw 的警示。' },
  { path: '/blog/why-typescript-agent-harness/', cat: '分析', zh: '为什么是 TypeScript / Node.js', desc_zh: 'npm 是插件分发层。' },
  { path: '/blog/dsh-trajectory-tracing/', cat: '教程', zh: 'Trajectory 追踪：killer feature', desc_zh: '从轨迹调试 Agent、削减 token 浪费。' },
  { path: '/blog/dsh-plugin-ecosystem/', cat: '分析', zh: '插件生态：209 个插件', desc_zh: '从 Show and tell 里归出十大类社区插件。' },
  { path: '/blog/dsh-feature-requests/', cat: '分析', zh: '社区最想要的 10 个功能', desc_zh: '297 条 Ideas 排行——桌面端、CLI/TUI、记忆、Docker 等。' },
  { path: '/blog/dsh-plugin-pollution/', cat: '分析', zh: 'dsh-plugin topic 被蹭标签污染', desc_zh: '我们如何鉴别真 DSH 插件与蹭标签仓库。' },
  { path: '/blog/deepseek-harness-faq/', cat: 'FAQ', zh: 'FAQ：社区高频问题', desc_zh: '权限、图片输入、token 成本、安装崩溃、Docker、记忆。' },
  { path: '/blog/dsh-bug-report/', cat: '分析', zh: '社区 Bug 报告全景：321 个讨论', desc_zh: '归成 8 大类真实问题。' },
  { path: '/blog/dsh-mcp/', cat: '指南', zh: 'MCP：接入 MCP Server', desc_zh: 'dsh-workspace-mcp 等。' },
  { path: '/blog/dsh-memory-guide/', cat: '指南', zh: '记忆插件：dsh-memory / dsh-mnemon', desc_zh: 'DSH 记忆插件全景。' },
  { path: '/blog/dsh-model-setup/', cat: '指南', zh: '模型接入教程：官方 API、OpenCode Go', desc_zh: '三种接入 + rc.8 视觉 API 现状（过渡期用 packs）。' },
  { path: '/blog/dsh-sandbox/', cat: '指南', zh: 'Sandbox：权限与安全', desc_zh: '权限预设、工具审批。' },
  { path: '/blog/dsh-subagent/', cat: '指南', zh: 'Subagent 教程：Claude Code / Codex / fork', desc_zh: 'rc.8 子代理：Claude Code/Codex 桥与已验证插件。' },
  { path: '/blog/dsh-vision/', cat: '指南', zh: 'Vision 教程：rc.8 叙事 vs 已验证 packs', desc_zh: 'catalog 缺口 vs modlens / vision toolkit 场景包。' },
  { path: '/blog/vs-cowork/', cat: '对比', zh: 'vs Claude Cowork', desc_zh: '开源框架 vs 闭源 Agent。' },
  { path: '/blog/dsh-desktop-alternatives/', cat: '指南', zh: 'DeepSeek Harness 有桌面端吗？CLI、VSCode、TUI、Electron 替代方案', desc_zh: 'DSH 没有官方桌面客户端——这里是真正的替代方案。' },
  { path: '/blog/dsh-im-integration/', cat: '指南', zh: 'IM 接入：微信、QQ、飞书、钉钉、Telegram', desc_zh: '把 DeepSeek Harness 塞进你的聊天软件——社区插件完整阵容。' },
  { path: '/blog/community-pulse-1/', cat: '脉搏', zh: '社区脉搏 · 第 1 期：用户现在最想要什么', desc_zh: '扫完 2638 个讨论：最响亮的诉求、本月的会话损坏 bug，以及拥挤的插件发现赛道。' },
  { path: '/blog/what-makes-a-good-dsh-plugin/', cat: '指南', zh: '什么才是 DeepSeek Harness 好的插件', desc_zh: '作者自查清单：bundle 清单、ESM、版本 pin、inject，以及如何拿到已验证。' },
];
const cats = [...new Set(posts.map((p) => p.cat))];
---
<Base title="博客 — DeepSeek Harness 教程、Vision、Subagent 与对比 | dshbase 中文" description="DeepSeek Harness（DSH）指南：安装与教程、rc.8 vision、subagent、vs Claude Code 与已验证插件分析。" currentPath="/blog/">
  <section class="hero wrap">
    <p class="eyebrow">博客</p>
    <h1>DeepSeek Harness <span class="accent">文章</span></h1>
    <p class="lede">教程、rc.8 枢纽、对比与分析。</p>
  </section>
  <section class="info wrap">
    <div class="cat-filter" role="tablist" aria-label="按分类筛选">
      <button class="fchip is-active" data-filter="all">全部 <b>{posts.length}</b></button>
      {cats.map((c) => (
        <button class="fchip" data-filter={c}>{c} <b>{posts.filter((p) => p.cat === c).length}</b></button>
      ))}
    </div>
    <div class="grid3" id="post-grid">
      {posts.map((p) => (
        <a class="card card-link post-card" data-cat={p.cat} href={getRelativeLocaleUrl(locale, p.path)}>
          <span class="cat">{p.cat}</span>
          <h3>{p.zh}</h3>
          <p>{p.desc_zh} <span class="arr">&rarr;</span></p>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .cat-filter { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 20px; }
  .fchip { font-size: 12.5px; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-card); color: var(--ink-2); cursor: pointer; font-family: inherit; }
  .fchip b { font-weight: 700; opacity: .6; }
  .fchip:hover { color: var(--primary); border-color: var(--primary); }
  .fchip.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .fchip.is-active b { opacity: .9; }
  .post-card[hidden] { display: none; }
</style>

<script>
  const chips = document.querySelectorAll('.fchip');
  const cards = document.querySelectorAll('.post-card');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      const f = chip.dataset.filter;
      cards.forEach((card) => { card.hidden = f !== 'all' && card.dataset.cat !== f; });
    });
  });
</script>
