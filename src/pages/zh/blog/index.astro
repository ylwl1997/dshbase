  { path: '/blog/dsh-vs-american-tools/', cat: '分析', zh: '冲击美国 Agent 工具', desc_zh: '5 天 15.8 万星——对 Claude Code、Codex、Cursor、Copilot 的冲击。' },
  { path: '/blog/deepseek-harness-comparison/', cat: '对比', zh: '横向对比 12 个编程工具', desc_zh: 'Claude Code、Codex、Cline、Pi、Reasonix、CodeWhale 等。' },
