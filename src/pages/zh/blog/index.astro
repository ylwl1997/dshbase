---
import Base from '../../../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
const locale = Astro.currentLocale ?? 'zh';
const posts = [
  { path: '/blog/wx-agent-architecture-control-three-schools/', cat: '分析', zh: "Claude Code、Codex 与 DSH 的架构分野：同一项任务，控制权交给谁", desc_zh: "三家 Agent 运行时把工程复杂度花在哪：工作流约定、操作系统级沙箱，还是连内核循环都可替换。" },
  { path: '/blog/wx-dsh-web-ui-plugin-skin-suite-review/', cat: '评测', zh: "dsh-web-ui 全家桶实测评测：一条命令把 DSH 毛坯界面装成工作台", desc_zh: "90 位贡献者、19 款皮肤、任务看板、Git 图谱、SSH 终端——dsh-web-ui 全家桶装了什么、付出什么、先审计哪一处。" },
