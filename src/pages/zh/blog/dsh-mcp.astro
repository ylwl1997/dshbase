---
import BlogPost from '../../../layouts/BlogPost.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
const directoryUrl = getRelativeLocaleUrl('zh', '/plugins/directory/');
const workspaceMcpUrl = getRelativeLocaleUrl('zh', '/plugins/dsh-workspace-mcp/');
const coworkUrl = getRelativeLocaleUrl('zh', '/plugins/dsh-cowork/');
