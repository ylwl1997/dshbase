---
import Base from '../../../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import packsData from '../../../data/packs.json';
import plugins from '../../../data/plugins.json';

const auditUrl = getRelativeLocaleUrl('zh', '/audit/');
const dirUrl = getRelativeLocaleUrl('zh', '/plugins/directory/');
const catalogUrl = getRelativeLocaleUrl('zh', '/plugins/dshbase-catalog/');
const installUrl = getRelativeLocaleUrl('zh', '/install/');
const visionBlog = getRelativeLocaleUrl('zh', '/blog/dsh-vision/');
const memoryBlog = getRelativeLocaleUrl('zh', '/blog/dsh-memory-guide/');
const imBlog = getRelativeLocaleUrl('zh', '/blog/dsh-im-integration/');
const modelBlog = getRelativeLocaleUrl('zh', '/blog/dsh-model-setup/');
const firstDay = getRelativeLocaleUrl('zh', '/blog/first-day-with-dsh/');

const bySlug = {};
Object.values(plugins).flat().forEach((p) => { bySlug[p.slug] = p; });

function resolvePack(pack) {
  return {
    ...pack,
    slots: pack.slots.map((s) => {
      const p = bySlug[s.slug];
      const ok = p && p.test === 'verified';
      return {
        ...s,
        plugin: p || null,
        ok,
        install: p
          ? (p.npm && p.pkg ? `dsh plugin add ${p.pkg}` : `dsh plugin add github:${(p.url || '').replace('https://github.com/', '')}`)
          : '',
      };
    }),
  };
}

const packs = packsData.packs.map(resolvePack);
const bad = packs.flatMap((p) => p.slots.filter((s) => !s.ok).map((s) => `${p.id}/${s.slug}`));
if (bad.length) {
  throw new Error(`Packs page build failed — non-verified slots: ${bad.join(', ')}`);
}

const personaPacks = packs.filter((p) => p.group === 'persona');
const capabilityPacks = packs.filter((p) => p.group === 'capability');
const slotCount = packs.reduce((n, p) => n + p.slots.length, 0);
---
<Base
  title="DeepSeek Harness 已验证场景包（程序员/艺术家/会计/学生/老师）| dshbase"
  description="按角色整理的 DSH 插件场景包：程序员、艺术家、会计、学生、老师、写作者、研究者——每个槽位都是 dshbase L3/L4 已验证，不按最高 Star 凑数。"
  currentPath="/packs/"
>
  <section class="packs-hero">
    <img class="packs-hero-img" src="/packs/hero.webp" width="1600" height="900" alt="dshbase DeepSeek Harness 已验证插件场景包氛围图：柔和日光工作台" decoding="async" />
    <div class="packs-hero-inner wrap">
      <p class="eyebrow">dshbase · 场景包</p>
      <h1>仅含<span class="accent">已验证</span>插件的 DeepSeek Harness 场景包</h1>
      <p class="lede">按角色选包：程序员、艺术家、会计、学生、老师……每个槽位都通过 L1–L4 实测。绝不用 pending 的「最高 Star」凑数。</p>
      <p class="lede-sub">{packs.length} 个场景包 · {slotCount} 个已验证槽位 · 见<a href={auditUrl}>审计方法</a> · 浏览完整<a href={dirUrl}>插件目录</a></p>
    </div>
  </section>

  <section class="info wrap packs-intro">
    <h2>什么是已验证场景包？</h2>
    <p>
      场景包是面向 <strong>DeepSeek Harness（DSH）</strong> 的短清单：按一个岗位/场景把能一起用的插件凑齐，
      而不是在上千条目录里瞎逛。适合编程、视觉、财务文档、学习笔记、教学、写作与科研。
      新手可先看<a href={installUrl}>安装指南</a>或<a href={firstDay}>DeepSeek Harness 真实的第一天</a>，再回这里选包。
    </p>
    <nav class="pack-jump" aria-label="跳转到场景包">
      <p class="jump-label">按角色跳转</p>
      <ul>
        {personaPacks.map((p) => (
          <li><a href={`#${p.id}`}>{p.title_zh}</a></li>
        ))}
      </ul>
      <p class="jump-label">按能力</p>
      <ul>
        {capabilityPacks.map((p) => (
          <li><a href={`#${p.id}`}>{p.title_zh}</a></li>
        ))}
      </ul>
    </nav>
  </section>

  <section class="wrap packs-section">
    <header class="sec-head">
      <h2>按角色的场景包</h2>
      <p>人格/岗位优先的 DeepSeek Harness 配置。复制安装命令，或打开插件页查看星数、笔记与徽章。</p>
    </header>
    {personaPacks.map((pack) => (
      <article class="pack-row" id={pack.id}>
        <div class="pack-lead">
          {pack.image && (
            <img class="pack-art" src={pack.image} width="480" height="480" alt={`${pack.title_zh} — DeepSeek Harness 已验证场景包配图`} loading="lazy" decoding="async" />
          )}
          <h3>{pack.title_zh}</h3>
          <p class="pack-desc">{pack.desc_zh}</p>
          <p class="pack-aud"><span>谁适合</span> {pack.audience_zh}</p>
          <span class="pack-count">{pack.slots.length} 个已验证槽位</span>
        </div>
        <ul class="slot-list">
          {pack.slots.map((s) => (
            <li class="slot">
              <div class="slot-meta">
                <span class="slot-label">{s.label_zh}</span>
                <span class="pill ok">已验证</span>
              </div>
              <a class="slot-name" href={`/zh/plugins/${s.plugin.slug}/`}>{s.plugin.name}</a>
              <div class="slot-cmd">
                <code>{s.install}</code>
                <button type="button" class="cmd-copy" data-cmd={s.install}>复制</button>
              </div>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <section class="wrap packs-section">
    <header class="sec-head">
      <h2>按能力的场景包</h2>
      <p>跨角色积木：纯文本模型视觉外挂、长期记忆、IM 接入、安全审计，以及含 <strong>dsh better sidebar</strong>、<strong>dsh-find-plugin</strong> 的界面发现包。</p>
    </header>
    {capabilityPacks.map((pack) => (
      <article class="pack-row" id={pack.id}>
        <div class="pack-lead">
          {pack.image && (
            <img class="pack-art" src={pack.image} width="480" height="480" alt={`${pack.title_zh} — DSH 能力场景包配图`} loading="lazy" decoding="async" />
          )}
          <h3>{pack.title_zh}</h3>
          <p class="pack-desc">{pack.desc_zh}</p>
          <p class="pack-aud"><span>谁适合</span> {pack.audience_zh}</p>
          <span class="pack-count">{pack.slots.length} 个已验证槽位</span>
        </div>
        <ul class="slot-list">
          {pack.slots.map((s) => (
            <li class="slot">
              <div class="slot-meta">
                <span class="slot-label">{s.label_zh}</span>
                <span class="pill ok">已验证</span>
              </div>
              <a class="slot-name" href={`/zh/plugins/${s.plugin.slug}/`}>{s.plugin.name}</a>
              <div class="slot-cmd">
                <code>{s.install}</code>
                <button type="button" class="cmd-copy" data-cmd={s.install}>复制</button>
              </div>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <section class="info wrap faq packs-faq">
    <h2>FAQ · 场景包与已验证插件</h2>
    <details>
      <summary>为什么不直接装 Star 最高的 DeepSeek Harness 插件？</summary>
      <p>Star 代表关注度，不代表能装能跑。我们的<a href={auditUrl}>插件审计</a>要求真实 profile 安装（需要时再加 web CDP）。场景包只引用<a href={dirUrl}>插件目录</a>里 <code>test=verified</code> 的条目。</p>
    </details>
    <details>
      <summary>我是程序员，该从哪个包开始？</summary>
      <p>用<a href="#dev-workbench">程序员工作台</a>：TokenLedger、dsh-cc-tui、LSP、Git 图、<strong>dsh better sidebar</strong> 与 <strong>dsh-at-file</strong>——也是搜索里常出现的 DSH UI 工具词。</p>
    </details>
    <details>
      <summary>怎么加视觉 / dsh vision toolkit？</summary>
      <p>装<a href="#artist-creative">艺术家 / 创意视觉包</a>，或专用的<a href="#vision">纯文本模型视觉外挂</a>。深入阅读：<a href={visionBlog}>Vision：图片输入与视觉插件</a>。</p>
    </details>
    <details>
      <summary>记忆包和 IM 包怎么用？</summary>
      <p>见<a href="#memory">长期记忆</a>与<a href="#im">IM 接入</a>，以及<a href={memoryBlog}>记忆插件指南</a>、<a href={imBlog}>微信 / 飞书 / Telegram / 钉钉</a>。模型密钥见<a href={modelBlog}>模型接入</a>。</p>
    </details>
    <details>
      <summary>能在 DSH 里发现场景包吗？</summary>
      <p>可以——安装 <a href={catalogUrl}>dshbase-catalog</a>，或用包含 dsh-find-plugin 的<a href="#ui-polish">界面美化与发现</a>包。</p>
    </details>
  </section>

  <section class="info wrap">
    <h2>继续探索</h2>
    <p>
      想浏览全部？打开<a href={dirUrl}>插件目录</a>。
      想了解「已验证」怎么来的？读<a href={auditUrl}>我们如何审计插件</a>。
      刚接触 DeepSeek Harness？从<a href={installUrl}>安装指南</a>开始。
    </p>
  </section>
</Base>

<style>
  .packs-hero {
    position: relative;
    isolation: isolate;
    padding: 88px 0 56px;
    overflow: hidden;
    background: linear-gradient(180deg, #e8eefc 0%, #f6f8fc 55%, #fff 100%);
  }
  .packs-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.28;
    z-index: -1;
  }
  .packs-hero-inner { text-align: center; }
  .packs-hero h1 {
    font-size: clamp(28px, 4.2vw, 42px);
    margin: 0 0 16px;
    font-weight: 800;
  }
  .packs-intro { padding-top: 8px; }
  .pack-jump {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }
  .jump-label {
    margin: 14px 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .pack-jump ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
  }
  .pack-jump a {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1px solid transparent;
  }
  .pack-jump a:hover {
    color: var(--primary-600);
    border-bottom-color: var(--primary);
  }

  .packs-section { padding: 12px 22px 28px; max-width: 980px; margin: 0 auto; }
  .sec-head { margin: 12px 0 22px; }
  .sec-head h2 { font-size: 26px; margin: 0 0 8px; }
  .sec-head p { margin: 0; color: var(--ink-2); max-width: 640px; }

  .pack-row {
    display: grid;
    grid-template-columns: minmax(200px, 280px) 1fr;
    gap: 22px 28px;
    padding: 26px 0;
    border-top: 1px solid var(--border);
    scroll-margin-top: 88px;
  }
  .pack-row:last-child { border-bottom: 1px solid var(--border); }
  .pack-art {
    width: 100%;
    max-width: 160px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 12px;
    display: block;
  }
  .pack-lead h3 {
    margin: 0 0 8px;
    font-size: 22px;
    font-weight: 800;
  }
  .pack-desc { margin: 0 0 10px; color: var(--ink-2); font-size: 15px; line-height: 1.55; }
  .pack-aud {
    margin: 0 0 10px;
    font-size: 13.5px;
    color: var(--ink-2);
    line-height: 1.5;
  }
  .pack-aud span {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 2px;
  }
  .pack-count {
    font-size: 12px;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .slot-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .slot {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    background: #fff;
  }
  .slot-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }
  .slot-label {
    font-size: 12px;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  .slot-name {
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    font-size: 15px;
  }
  .slot-name:hover { color: var(--primary); }
  .pill {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 6px;
  }
  .pill.ok { background: #ecfdf5; color: #047857; }
  .slot-cmd {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .slot-cmd code {
    flex: 1;
    min-width: 0;
    font-size: 12.5px;
    background: var(--bg-soft);
    padding: 7px 10px;
    border-radius: 6px;
    color: var(--ink);
    overflow-x: auto;
  }
  .cmd-copy {
    appearance: none;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 12.5px;
    font-weight: 600;
    padding: 6px 10px;
    border-radius: 6px;
    cursor: pointer;
  }
  .cmd-copy:hover {
    border-color: var(--primary);
    color: var(--primary-600);
  }
  .packs-faq details { margin-bottom: 8px; }

  @media (max-width: 760px) {
    .packs-hero { padding: 56px 0 36px; }
    .pack-row { grid-template-columns: 1fr; gap: 14px; }
    .pack-art { max-width: 120px; }
  }
</style>

<script>
  document.querySelectorAll('.cmd-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cmd = btn.getAttribute('data-cmd') || '';
      try {
        await navigator.clipboard.writeText(cmd);
        const prev = btn.textContent;
        btn.textContent = '已复制!';
        setTimeout(() => { btn.textContent = prev; }, 1400);
      } catch (_) {}
    });
  });
</script>
