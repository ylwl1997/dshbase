---
import Base from '../../../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import packsData from '../../../data/packs.json';
import plugins from '../../../data/plugins.json';

const auditUrl = getRelativeLocaleUrl('zh', '/audit/');
const dirUrl = getRelativeLocaleUrl('zh', '/plugins/directory/');
const catalogUrl = getRelativeLocaleUrl('zh', '/plugins/dshbase-catalog/');
const installUrl = getRelativeLocaleUrl('zh', '/install/');
const visionBlog = getRelativeLocaleUrl('zh', '/blog/dsh-vision/');
const memoryBlog = getRelativeLocaleUrl('zh', '/blog/dsh-memory-guide/');
const imBlog = getRelativeLocaleUrl('zh', '/blog/dsh-im-integration/');
const modelBlog = getRelativeLocaleUrl('zh', '/blog/dsh-model-setup/');
const firstDay = getRelativeLocaleUrl('zh', '/blog/first-day-with-dsh/');

const CATALOG_CMD = 'dsh plugin add dshbase-catalog';

const bySlug = {};
Object.values(plugins).flat().forEach((p) => { bySlug[p.slug] = p; });

function installCmd(p) {
  if (!p) return '';
  if (p.npm && p.pkg) return `dsh plugin add ${p.pkg}`;
  const repo = (p.url || '').replace(/^https:\/\/github\.com\//, '').replace(/\.git$/, '');
  return repo ? `dsh plugin add github:${repo}` : '';
}

function resolvePack(pack) {
  const slots = pack.slots.map((s) => {
    const p = bySlug[s.slug];
    const ok = p && p.test === 'verified';
    return {
      ...s,
      plugin: p || null,
      ok,
      install: installCmd(p),
    };
  });
  const names = slots.map((s) => s.plugin?.name || s.slug).join('、');
  return {
    ...pack,
    slots,
    agentAsk: `帮我安装这些已验证的 dshbase 插件：${names}`,
  };
}

const packs = packsData.packs.map(resolvePack);
const bad = packs.flatMap((p) => p.slots.filter((s) => !s.ok).map((s) => `${p.id}/${s.slug}`));
if (bad.length) {
  throw new Error(`Packs page build failed — non-verified slots: ${bad.join(', ')}`);
}

const personaPacks = packs.filter((p) => p.group === 'persona');
const capabilityPacks = packs.filter((p) => p.group === 'capability');
const slotCount = packs.reduce((n, p) => n + p.slots.length, 0);
---
<Base
  title="DeepSeek Harness 已验证场景包（程序员/艺术家/会计/学生/老师）| dshbase"
  description="按角色整理的 DSH 插件场景包：程序员、艺术家、会计、学生、老师、写作者、研究者——每个槽位都是 dshbase L3/L4 已验证，不按最高 Star 凑数。"
  currentPath="/packs/"
>
  <section class="packs-hero">
    <img class="packs-hero-img" src="/packs/hero.webp" width="1600" height="900" alt="dshbase DeepSeek Harness 已验证插件场景包氛围图：柔和日光工作台" decoding="async" />
    <div class="packs-hero-inner wrap">
      <p class="eyebrow">dshbase</p>
      <h1>仅含<span class="accent">已验证</span>插件的场景包</h1>
      <p class="lede">按角色选 DeepSeek Harness 插件组合。每个槽位都通过 L1–L4 实测——绝不用 pending 的「最高 Star」凑数。</p>
      <p class="lede-sub">{packs.length} 个包 · {slotCount} 个槽位 · <a href={auditUrl}>审计</a> · <a href={dirUrl}>目录</a></p>
    </div>
  </section>

  <section class="wrap packs-howto" id="howto">
    <header class="sec-head">
      <h2>怎么装场景包</h2>
      <p>两条路：catalog + Agent（最快），或每个插件一条手动命令。</p>
    </header>
    <div class="howto-grid">
      <div class="howto-card howto-primary">
        <h3>一键：先装 <a href={catalogUrl}>dshbase-catalog</a></h3>
        <ol class="howto-steps">
          <li>
            <span>先装一次目录插件</span>
            <div class="cmd-row">
              <code>{CATALOG_CMD}</code>
              <button type="button" class="cmd-copy" data-cmd={CATALOG_CMD}>复制</button>
            </div>
          </li>
          <li>
            <span>让 Agent 帮你装整包</span>
            <p class="howto-hint">点下方每个包的<strong>问 Agent</strong>复制提示词，或直接说「帮我装程序员工作台」。</p>
          </li>
        </ol>
        <p class="howto-more">插件页：<a href={catalogUrl}>dshbase-catalog</a></p>
      </div>
      <div class="howto-card">
        <h3>手动：每个槽位一条命令</h3>
        <p>每个槽位只显示一条 <code>dsh plugin add …</code>（有 npm 用包名，否则 <code>github:owner/repo</code>）。卡片上不展示 web/headless 双份命令——复制即可跑。</p>
        <p class="howto-hint">新手先看<a href={installUrl}>安装指南</a>或<a href={firstDay}>DeepSeek Harness 真实的第一天</a>。</p>
      </div>
    </div>
    <nav class="pack-jump" aria-label="跳转到场景包">
      <span class="jump-label">角色</span>
      {personaPacks.map((p) => (
        <a href={`#${p.id}`}>{p.title_zh}</a>
      ))}
      <span class="jump-label">能力</span>
      {capabilityPacks.map((p) => (
        <a href={`#${p.id}`}>{p.title_zh}</a>
      ))}
    </nav>
  </section>

  <section class="wrap packs-section">
    <header class="sec-head">
      <h2>按角色的场景包</h2>
      <p>岗位优先。问 Agent，或复制每个槽位的安装命令。</p>
    </header>
    <div class="pack-grid">
      {personaPacks.map((pack) => (
        <article class={`pack-card${pack.image ? '' : ' no-art'}`} id={pack.id}>
          <div class="pack-top">
            {pack.image && (
              <img class="pack-art" src={pack.image} width="480" height="480" alt={`${pack.title_zh} — DeepSeek Harness 已验证场景包配图`} loading="lazy" decoding="async" />
            )}
            <div class="pack-intro">
              <h3>{pack.title_zh}</h3>
              <p class="pack-desc">{pack.desc_zh}</p>
              <p class="pack-aud">{pack.audience_zh}</p>
              <div class="pack-actions">
                <span class="pack-count">{pack.slots.length} 个已验证</span>
                <button type="button" class="cmd-copy agent-copy" data-cmd={pack.agentAsk}>问 Agent</button>
              </div>
            </div>
          </div>
          <ul class="slot-list">
            {pack.slots.map((s) => (
              <li class="slot">
                <div class="slot-head">
                  <span class="slot-label">{s.label_zh}</span>
                  <a class="slot-name" href={`/zh/plugins/${s.plugin.slug}/`}>{s.plugin.name}</a>
                </div>
                <div class="cmd-row">
                  <code>{s.install}</code>
                  <button type="button" class="cmd-copy" data-cmd={s.install}>复制</button>
                </div>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap packs-section">
    <header class="sec-head">
      <h2>按能力的场景包</h2>
      <p>视觉、记忆、IM、安全，以及含 <strong>dsh better sidebar</strong>、<strong>dsh-find-plugin</strong> 的界面发现。</p>
    </header>
    <div class="pack-grid">
      {capabilityPacks.map((pack) => (
        <article class={`pack-card${pack.image ? '' : ' no-art'}`} id={pack.id}>
          <div class="pack-top">
            {pack.image && (
              <img class="pack-art" src={pack.image} width="480" height="480" alt={`${pack.title_zh} — DSH 能力场景包配图`} loading="lazy" decoding="async" />
            )}
            <div class="pack-intro">
              <h3>{pack.title_zh}</h3>
              <p class="pack-desc">{pack.desc_zh}</p>
              <p class="pack-aud">{pack.audience_zh}</p>
              <div class="pack-actions">
                <span class="pack-count">{pack.slots.length} 个已验证</span>
                <button type="button" class="cmd-copy agent-copy" data-cmd={pack.agentAsk}>问 Agent</button>
              </div>
            </div>
          </div>
          <ul class="slot-list">
            {pack.slots.map((s) => (
              <li class="slot">
                <div class="slot-head">
                  <span class="slot-label">{s.label_zh}</span>
                  <a class="slot-name" href={`/zh/plugins/${s.plugin.slug}/`}>{s.plugin.name}</a>
                </div>
                <div class="cmd-row">
                  <code>{s.install}</code>
                  <button type="button" class="cmd-copy" data-cmd={s.install}>复制</button>
                </div>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="info wrap faq packs-faq">
    <h2>FAQ</h2>
    <details>
      <summary>为什么不装 Star 最高的？</summary>
      <p>Star ≠ 能装能跑。<a href={auditUrl}>审计</a>要求真实 profile 安装。场景包只用目录里 <code>test=verified</code> 的条目。</p>
    </details>
    <details>
      <summary>程序员从哪开始？</summary>
      <p><a href="#dev-workbench">程序员工作台</a>——TokenLedger、dsh-cc-tui、LSP、Git 图、<strong>dsh better sidebar</strong>、<strong>dsh-at-file</strong>。</p>
    </details>
    <details>
      <summary>视觉 / dsh vision toolkit？</summary>
      <p><a href="#artist-creative">艺术家 / 创意视觉包</a>或<a href="#vision">纯文本模型视觉外挂</a>。指南：<a href={visionBlog}>Vision</a>。</p>
    </details>
    <details>
      <summary>记忆和 IM？</summary>
      <p><a href="#memory">长期记忆</a>、<a href="#im">IM 接入</a> · <a href={memoryBlog}>记忆</a> · <a href={imBlog}>IM</a> · <a href={modelBlog}>模型</a>。</p>
    </details>
    <details>
      <summary>能在 DSH 里发现场景包吗？</summary>
      <p>装 <a href={catalogUrl}>dshbase-catalog</a>，或用<a href="#ui-polish">界面美化与发现</a>包。</p>
    </details>
  </section>

  <section class="info wrap packs-foot">
    <p>
      <a href={dirUrl}>插件目录</a> ·
      <a href={auditUrl}>我们如何审计</a> ·
      <a href={installUrl}>安装 DSH</a>
    </p>
  </section>
</Base>

<style>
  .packs-hero {
    position: relative;
    isolation: isolate;
    padding: 72px 0 40px;
    overflow: hidden;
    background: linear-gradient(180deg, #eef2f8 0%, #f6f8fc 50%, #fff 100%);
  }
  .packs-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.22;
    z-index: -1;
  }
  .packs-hero-inner { text-align: center; max-width: 720px; margin: 0 auto; }
  .packs-hero h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin: 0 0 12px;
    font-weight: 800;
  }
  .packs-hero .lede { margin: 0 auto 8px; max-width: 540px; }
  .lede-sub { margin: 0; font-size: 14px; color: var(--ink-3); }

  .packs-howto { padding: 28px 22px 8px; max-width: 980px; margin: 0 auto; }
  .howto-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 14px;
    margin-bottom: 18px;
  }
  .howto-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px 18px;
    background: #fff;
  }
  .howto-primary {
    background: #f8fafc;
    border-color: var(--border-strong);
  }
  .howto-card h3 {
    margin: 0 0 10px;
    font-size: 16px;
    font-weight: 700;
  }
  .howto-card p { margin: 0 0 8px; font-size: 14px; color: var(--ink-2); line-height: 1.55; }
  .howto-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .howto-steps > li > span {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .howto-hint { font-size: 13px !important; color: var(--ink-3) !important; margin: 6px 0 0 !important; }
  .howto-more { margin: 12px 0 0 !important; font-size: 13px !important; }

  .cmd-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .cmd-row code {
    flex: 1;
    min-width: 0;
    font-size: 12.5px;
    background: var(--bg-soft);
    padding: 7px 10px;
    border-radius: 6px;
    color: var(--ink);
    overflow-x: auto;
  }
  .cmd-copy {
    appearance: none;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 12.5px;
    font-weight: 600;
    padding: 6px 10px;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
  }
  .cmd-copy:hover {
    border-color: var(--primary);
    color: var(--primary-600);
  }
  .agent-copy {
    background: var(--primary-soft);
    border-color: #c7d2fe;
    color: var(--primary-600);
  }

  .pack-jump {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    padding: 14px 0 4px;
    border-top: 1px solid var(--border);
  }
  .jump-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-right: 2px;
  }
  .pack-jump a {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
  }
  .pack-jump a:hover { color: var(--primary-600); }

  .packs-section { padding: 16px 22px 24px; max-width: 980px; margin: 0 auto; }
  .sec-head { margin: 8px 0 18px; }
  .sec-head h2 { font-size: 24px; margin: 0 0 6px; }
  .sec-head p { margin: 0; color: var(--ink-2); max-width: 620px; font-size: 14.5px; }

  .pack-grid {
    display: grid;
    gap: 16px;
  }
  .pack-card {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #fff;
    padding: 18px 18px 14px;
    scroll-margin-top: 88px;
  }
  .pack-top {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 14px 16px;
    margin-bottom: 14px;
    align-items: start;
  }
  .pack-card.no-art .pack-top {
    grid-template-columns: 1fr;
  }
  .pack-art {
    width: 88px;
    height: 88px;
    object-fit: cover;
    border-radius: 10px;
    display: block;
  }
  .pack-intro h3 {
    margin: 0 0 6px;
    font-size: 20px;
    font-weight: 800;
  }
  .pack-desc {
    margin: 0 0 6px;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.5;
  }
  .pack-aud {
    margin: 0 0 10px;
    font-size: 13px;
    color: var(--ink-3);
    line-height: 1.45;
  }
  .pack-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pack-count {
    font-size: 12px;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .slot-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    border-top: 1px solid var(--border);
    padding-top: 12px;
  }
  .slot {
    padding: 8px 0;
  }
  .slot + .slot {
    border-top: 1px solid var(--bg-soft);
  }
  .slot-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 10px;
    margin-bottom: 6px;
  }
  .slot-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  .slot-name {
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    font-size: 14px;
  }
  .slot-name:hover { color: var(--primary); }

  .packs-faq details { margin-bottom: 6px; }
  .packs-foot p { margin: 0; font-size: 14px; color: var(--ink-2); }

  @media (max-width: 760px) {
    .packs-hero { padding: 48px 0 28px; }
    .howto-grid { grid-template-columns: 1fr; }
    .pack-top { grid-template-columns: 72px 1fr; }
    .pack-art { width: 72px; height: 72px; }
  }
</style>

<script>
  document.querySelectorAll('.cmd-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cmd = btn.getAttribute('data-cmd') || '';
      try {
        await navigator.clipboard.writeText(cmd);
        const prev = btn.textContent;
        btn.textContent = '已复制!';
        setTimeout(() => { btn.textContent = prev; }, 1400);
      } catch (_) {}
    });
  });
</script>
