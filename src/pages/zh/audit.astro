---
import Base from '../../layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import plugins from '../../data/plugins.json';
import syncDate from '../../data/sync-date.json';
import { pendingFailRows, FAIL_LABELS_ZH, FAIL_ORDER } from '../../lib/audit-fail.js';

const catOrder = Object.keys(plugins);
const all = catOrder.flatMap((k) => plugins[k]);
const total = all.length;
const nCats = catOrder.length;

const repoOf = (u) => (u || '').match(/github\.com\/([^/]+\/[^/]+?)(?:\/|$)/i)?.[1]?.toLowerCase() || '';
const uniqueRepos = new Set(all.map((p) => repoOf(p.url)).filter(Boolean)).size;

const nVerified = all.filter((p) => p.test === 'verified').length;
const nPending = all.filter((p) => p.test === 'pending').length;
const nMit = all.filter((p) => (p.license || '') === 'MIT').length;

const fmt = (n) => n.toLocaleString('en-US');
const directoryUrl = getRelativeLocaleUrl('zh', '/plugins/directory/');
const pluginsUrl = getRelativeLocaleUrl('zh', '/plugins/');

const failRows = pendingFailRows(plugins);
const failCounts = {};
failRows.forEach((r) => { failCounts[r.failClass] = (failCounts[r.failClass] || 0) + 1; });
const failOrder = FAIL_ORDER;

const stats = [
  { n: fmt(total), label: '插件' },
  { n: fmt(nCats), label: '分类' },
  { n: fmt(uniqueRepos), label: '仓库' },
  { n: fmt(nVerified), label: '已验证' },
  { n: fmt(nPending), label: '待验证' },
  { n: fmt(nMit), label: 'MIT 协议' },
];

const report = {
  method: [
    { k: 'L1 · 安装', v: '插件在干净 profile 里，与固定版本的 DSH 运行时一起安装。' },
    { k: 'L2 · 加载', v: 'profile 成功启动并导出配置。' },
    { k: 'L3 · Headless', v: '载入插件后跑 headless 问答。若判定为仅 Web（web-only），L3 不算通过。' },
    { k: 'L4 · Web CDP', v: 'L3 为 web-only 时必经：启动 Web profile + 浏览器 CDP 问答。只有 L4 ok 才升为已验证。' },
  ],
  results: [
    { n: '551', label: '通过', ok: true },
    { n: '198', label: '运行失败' },
    { n: '164', label: '安装失败' },
    { n: '10', label: '加载失败' },
  ],
  causes: [
    { title: '安装失败', total: '159', items: [
      ['68', '声明的依赖版本在 registry 上不存在'],
      ['63', '构建 / prepare 脚本失败（常因依赖了未发布的 @deepseek-ai/* 包）'],
      ['15', '依赖包或仓库返回 404'],
      ['13', '不支持的依赖结构（workspace / linked / exotic）'],
    ] },
    { title: '运行失败', total: '182', items: [
      ['107', '插件 entry 启动时激活失败'],
      ['70', 'loader entry 应用失败（schema DSL 不支持、缺配置、版本不匹配）'],
      ['5', '其他'],
    ] },
    { title: '加载失败', total: '10', items: [
      ['10', 'overlay 文件缺失（ENOENT）'],
    ] },
  ],
};
---

<Base
  title="我们如何审计插件 — dshbase 验证方法 | dshbase 中文"
  description="dshbase 的已验证 = L1–L3 headless，web-only 必须再过 L4 Web CDP。可按失败类型浏览待验证插件。"
  currentPath="/audit/"
>
  <section class="hero wrap">
    <p class="eyebrow">插件审计</p>
    <h1>我们如何审计<span class="accent">每一个插件</span></h1>
    <p class="lede"><strong>已验证</strong>表示在 dsh 0.1.0-rc.6 上过了 L1 安装 + L2 加载 + L3 headless；若 L3 为 web-only，则<strong>必须再过 L4 Web CDP</strong>。不是 topic 计数，也不是「清单能解析」。</p>
  </section>

  <section class="wrap audit-stats">
    {stats.map((s) => (
      <div class="astat">
        <b>{s.n}</b>
        <span>{s.label}</span>
      </div>
    ))}
  </section>

  <section class="info wrap">
    <p class="as-of">数据截至 {syncDate.updated} · 每次构建从<a href="https://github.com/ylwl1997/dshbase" rel="noopener">插件数据集</a>重算。</p>

    <h2>「已验证」是什么意思</h2>
    <p>上架回答「该不该出现在这里？」；验证回答「能不能真跑起来？」有的目录把「可安装」也标成已验证。我们这里：</p>
    <ul>
      {report.method.map((m) => (
        <li><strong>{m.k}</strong> — {m.v}</li>
      ))}
    </ul>
    <ul>
      <li><strong><code>verified</code></strong> — L3 headless 通过，或 L3 为 web-only 且 L4 CDP 通过。</li>
      <li><strong><code>pending</code></strong> — 已收录但未通过（含 web-only 待 L4，或先前失败——见备注）。</li>
      <li><strong>信任等级</strong>只是辅助；star 只表示热度。</li>
    </ul>

    <h2>上架前的三道审计</h2>
    <p>出现在<a href={directoryUrl}>目录</a>之前，每条都过这三关。</p>
    <div class="grid3">
      <div class="card">
        <h3>1 · 来源审计</h3>
        <p>必须对应真实可达的 GitHub 仓库；改名、删除、不可达的条目会下架。</p>
      </div>
      <div class="card">
        <h3>2 · 生态审计</h3>
        <p>DSH 清单（<code>cordis.patch.yml</code>、<code>dsh.bundle</code> 等）与 DSH 依赖——不只是仓库名或 topic。</p>
      </div>
      <div class="card">
        <h3>3 · 元数据审计</h3>
        <p>协议、star、fork、issue、更新时间、语言、是否 archived，直接展示在卡片上。</p>
      </div>
    </div>

    <h2 id="pending">待验证与失败浏览</h2>
    <p>当前 <code>pending</code> {fmt(nPending)} 条。按备注解析出的失败类型筛选（实时数据，不是下方八月批次快照）。<strong>待 L4 CDP</strong> 表示 L3 判为 web-only、尚未过 CDP；<strong>L4 未通过</strong> 表示已跑过 CDP 且失败。旧备注「web L3 … CDP E2E」属于普通安装/加载/运行失败，不是 L4 队列。</p>
    <div class="fail-filters" id="fail-filters" role="tablist" aria-label="按失败类型筛选">
      <button type="button" class="fchip is-active" data-fail="all">全部 <b>{failRows.length}</b></button>
      {failOrder.filter((k) => failCounts[k]).map((k) => (
        <button type="button" class="fchip" data-fail={k}>{FAIL_LABELS_ZH[k]} <b>{failCounts[k]}</b></button>
      ))}
    </div>
    <div class="fail-table-wrap">
      <table class="fail-table" id="fail-table">
        <thead>
          <tr>
            <th>插件</th>
            <th>类型</th>
            <th>最近测试</th>
            <th>备注</th>
          </tr>
        </thead>
        <tbody>
          {failRows.map((r) => (
            <tr data-fail={r.failClass}>
              <td><a href={`/zh/plugins/${r.slug}/`}>{r.name}</a> <span class="muted small">{r.cat}</span></td>
              <td><span class="fail-pill">{FAIL_LABELS_ZH[r.failClass] || r.failClass}</span></td>
              <td>{r.testDate || '—'}</td>
              <td class="fail-note">{r.note || '尚无失败备注——排队中或尚未跑过。'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>全量验证批次 — 2026 年 8 月</h2>
    <p>对当时 pending 条目的首轮三关快照。</p>
    <h3>结果</h3>
    <div class="report-results">
      {report.results.map((r) => (
        <div class={`rstat${r.ok ? ' ok' : ''}`}>
          <b>{r.n}</b>
          <span>{r.label}</span>
        </div>
      ))}
    </div>
    <h3>未通过原因（批次）</h3>
    {report.causes.map((g) => (
      <div class="cause-group">
        <h4>{g.title}（{g.total}）</h4>
        <ul>
          {g.items.map(([n, d]) => (
            <li><strong>{n}</strong> — {d}</li>
          ))}
        </ul>
      </div>
    ))}

    <h2>我们对可靠性的立场</h2>
    <ul>
      <li><strong>上架不等于背书。</strong></li>
      <li><strong>持续审计</strong>——收录时验证，并定期复测。</li>
      <li><strong>可复核</strong>——清单、仓库状态与实测结果。</li>
    </ul>

    <p>发现错误条目？<a href="mailto:hello@dshbase.com">告诉我们</a>，或<a href="https://github.com/ylwl1997/dshbase/issues/new?template=plugin-submission.yml" rel="noopener">开 Issue</a>。也可看<a href={pluginsUrl}>插件指南</a>。</p>
  </section>
</Base>

<style>
  .audit-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; padding-bottom: 8px; }
  .astat { background: var(--card-bg, #fff); border: 1px solid var(--border, #e5e9f0); border-radius: 14px; padding: 18px 16px; text-align: center; }
  .astat b { display: block; font-size: 30px; font-weight: 800; color: var(--primary, #4D6BFE); letter-spacing: -0.02em; }
  .astat span { font-size: 12.5px; color: var(--ink-2, #5b6472); text-transform: uppercase; letter-spacing: .05em; }
  .as-of { font-size: 13px; color: var(--ink-3, #8a93a3); }
  .info ul { margin: 0 0 8px; padding-left: 0; list-style: none; }
  .info ul li { margin: 10px 0; color: var(--ink-2, #475569); line-height: 1.7; padding-left: 20px; position: relative; }
  .info ul li::before { content: "›"; position: absolute; left: 2px; color: var(--primary, #4D6BFE); font-weight: 700; }
  .info h2 { margin-top: 30px; }
  .report-results { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; margin: 14px 0 6px; }
  .rstat { background: var(--card-bg, #fff); border: 1px solid var(--border, #e5e9f0); border-radius: 14px; padding: 16px 14px; text-align: center; }
  .rstat.ok { border-color: #b6e3c8; background: #f2fbf5; }
  .rstat b { display: block; font-size: 26px; font-weight: 800; color: var(--ink, #1f2733); }
  .rstat.ok b { color: #1a7f4b; }
  .rstat span { font-size: 12px; color: var(--ink-2, #5b6472); text-transform: uppercase; letter-spacing: .04em; }
  .cause-group { margin: 18px 0; }
  .cause-group h4 { margin: 0 0 8px; font-size: 15px; color: var(--ink, #1f2733); }
  .fail-filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 14px; }
  .fchip { font-size: 12.5px; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-card, #fff); color: var(--ink-2); cursor: pointer; font-family: inherit; }
  .fchip b { font-weight: 700; opacity: .6; }
  .fchip:hover { color: var(--primary); border-color: var(--primary); }
  .fchip.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }
  .fchip.is-active b { opacity: .9; }
  .fail-table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 12px; }
  .fail-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .fail-table th, .fail-table td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--border); vertical-align: top; }
  .fail-table th { background: #f8fafc; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--ink-3); }
  .fail-table tr[hidden] { display: none; }
  .fail-note { color: var(--ink-2); max-width: 420px; line-height: 1.45; }
  .fail-pill { display: inline-block; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: #fff7ed; color: #9a3412; border: 1px solid #fed7aa; }
  .muted { color: var(--ink-3); }
  .small { font-size: 12px; }
</style>

<script>
  const chips = document.querySelectorAll('#fail-filters .fchip');
  const rows = document.querySelectorAll('#fail-table tbody tr');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      const f = chip.dataset.fail;
      rows.forEach((row) => { row.hidden = f !== 'all' && row.dataset.fail !== f; });
    });
  });
</script>
